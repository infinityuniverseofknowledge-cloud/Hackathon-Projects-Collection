// Fibonacci: recursivo e iterativo
let fib_rec = fn(n) {
    if n < 2 { return n }
    fib_rec(n - 1) + fib_rec(n - 2)
}

let fib_iter = fn(n) {
    let a = 0
    let b = 1
    let i = 0
    while i < n {
        let tmp = a + b
        a = b
        b = tmp
        i = i + 1
    }
    a
}

puts("fib_rec(10) =", fib_rec(10))
puts("fib_iter(30) =", fib_iter(30))
puts("fib_rec(15) =", fib_rec(15))
