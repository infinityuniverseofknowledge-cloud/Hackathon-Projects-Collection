// "Classes" via closures
let make_counter = fn(start) {
    let count = start
    {
        inc: fn() { count = count + 1; count },
        dec: fn() { count = count - 1; count },
        get: fn() { count }
    }
}

let c = make_counter(10)
puts("initial:", c["get"]())
puts("inc:", c["inc"]())
puts("inc:", c["inc"]())
puts("dec:", c["dec"]())
puts("final:", c["get"]())

// Stack simples
let make_stack = fn() {
    let items = []
    {
        push: fn(x) { items = push(items, x); len(items) },
        pop: fn() {
            if len(items) == 0 { return null }
            let top = last(items)
            items = rest(items)
            top
        },
        size: fn() { len(items) }
    }
}

let s = make_stack()
s["push"](1)
s["push"](2)
s["push"](3)
puts("size:", s["size"]())
puts("pop:", s["pop"]())
puts("pop:", s["pop"]())
puts("size:", s["size"]())
