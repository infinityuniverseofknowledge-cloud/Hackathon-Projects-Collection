{
  "provider": {
    "mode": "offline",
    "base_url_env": "OMEGA_BASE_URL",
    "model_env": "OMEGA_MODEL",
    "api_key_env": "OMEGA_API_KEY"
  },
  "limits": {
    "max_plan_steps": 8,
    "max_tool_calls": 20,
    "max_task_seconds": 120,
    "max_document_bytes": 200000,
    "max_indexed_files": 200,
    "max_context_characters": 20000
  },
  "privacy": {
    "memory_disabled_env": "OMEGA_MEMORY_DISABLED",
    "remote_requests_require_explicit_environment": true
  }
}