<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EcoGenesis AI</title>
<style>
:root{--g:#0a6b47;--g2:#10b981;--bg:#f4faf7;--tx:#0f1f1a;--mt:#5a7268;--bd:#d1e7dd;--danger:#dc2626;--dangersoft:#fee2e2}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;background:var(--bg);color:var(--tx);line-height:1.6;min-height:100vh}
header{background:linear-gradient(135deg,var(--g),var(--g2));color:#fff;padding:22px 20px}
header h1{font-size:1.4rem;margin-bottom:2px}
header p{font-size:.85rem;opacity:.92}
nav{background:#fff;border-bottom:1px solid var(--bd);padding:8px 12px;display:flex;gap:4px;overflow-x:auto}
.tab-btn{padding:8px 14px;border:none;background:none;font:inherit;font-weight:600;font-size:.85rem;color:var(--mt);cursor:pointer;border-radius:8px;white-space:nowrap}
.tab-btn:hover{background:#f0f7f4}
.tab-btn.active{background:var(--g);color:#fff}
main{max-width:920px;margin:0 auto;padding:22px 16px}
.tab{display:none}
.tab.active{display:block}
h2{font-size:1.2rem;color:var(--g);margin-bottom:12px}
h3{font-size:1rem;color:var(--g);margin-bottom:8px}
.card{background:#fff;border:1px solid var(--bd);border-radius:12px;padding:18px;margin-bottom:16px}
.grid{display:grid;gap:12px}
.grid-2{grid-template-columns:repeat(auto-fit,minmax(180px,1fr))}
.grid-4{grid-template-columns:repeat(auto-fit,minmax(130px,1fr))}
label{display:block;font-size:.82rem;font-weight:600;margin-bottom:4px}
input{width:100%;padding:8px 12px;border:1px solid var(--bd);border-radius:8px;font:inherit;font-size:.9rem;color:var(--tx)}
input:focus{outline:none;border-color:var(--g2);box-shadow:0 0 0 3px rgba(16,185,129,.15)}
button.btn{padding:10px 18px;border:none;border-radius:8px;font:inherit;font-weight:600;font-size:.88rem;cursor:pointer;background:var(--g);color:#fff}
button.btn:hover{background:#085a3c}
button.btn.secondary{background:#d1fae5;color:var(--g)}
button.btn.secondary:hover{background:#a7f3d0}
button.btn.danger{background:var(--dangersoft);color:var(--danger)}
button.btn.danger:hover{background:var(--danger);color:#fff}
.metric{background:#fff;border:1px solid var(--bd);border-radius:12px;padding:14px}
.metric-label{font-size:.72rem;color:var(--mt);text-transform:uppercase;letter-spacing:.04em;font-weight:600}
.metric-value{font-size:1.4rem;font-weight:700;color:var(--g);margin:4px 0 2px}
.metric-unit{font-size:.72rem;color:var(--mt)}
.rec{background:#fff;border:1px solid var(--bd);border-left:4px solid var(--g2);border-radius:8px;padding:14px;margin-bottom:12px}
.rec h3{font-size:.95rem}
.rec .why{background:#f0f7f4;padding:8px 12px;border-radius:6px;font-size:.82rem;color:var(--mt);margin:8px 0;font-style:italic}
.badge{display:inline-block;padding:2px 8px;border-radius:999px;font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em}
.badge.high{background:var(--dangersoft);color:var(--danger)}
.badge.medium{background:#fef3c7;color:#78350f}
.badge.low{background:#d1fae5;color:var(--g)}
.error{color:var(--danger);font-size:.85rem;font-weight:600;margin:8px 0;padding:10px 12px;background:var(--dangersoft);border-radius:6px}
.goal{background:#fff;border:1px solid var(--bd);border-radius:8px;padding:12px;margin-bottom:10px}
.goal-bar{height:8px;background:#f0f7f4;border-radius:999px;overflow:hidden;margin:8px 0}
.goal-bar>div{height:100%;background:linear-gradient(90deg,var(--g2),var(--g));transition:width .3s}
.empty{text-align:center;padding:36px 20px;color:var(--mt)}
.alert{background:#fef3c7;border-left:3px solid #f59e0b;padding:12px;border-radius:6px;font-size:.85rem;margin-bottom:16px;color:#78350f}
.table{width:100%;font-size:.85rem;border-collapse:collapse}
.table th{text-align:left;padding:8px;border-bottom:2px solid var(--bd);font-size:.75rem;text-transform:uppercase;color:var(--mt)}
.table td{padding:8px;border-bottom:1px solid var(--bd)}
.table .num{text-align:right;font-variant-numeric:tabular-nums}
pre{background:#f0f7f4;padding:12px;border-radius:8px;font-size:.82rem;overflow-x:auto;font-family:"SF Mono",Menlo,monospace;color:var(--g)}
@media (max-width:600px){header{padding:16px}main{padding:14px 12px}.metric-value{font-size:1.2rem}}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style>
</head>
<body>
<header>
  <h1>EcoGenesis AI</h1>
  <p>Sustainability intelligence - private, offline, no accounts</p>
</header>
<nav id="nav">
  <button class="tab-btn active" data-tab="overview">Overview</button>
  <button class="tab-btn" data-tab="assess">Assess</button>
  <button class="tab-btn" data-tab="results">Results</button>
  <button class="tab-btn" data-tab="goals">Goals</button>
  <button class="tab-btn" data-tab="method">Methodology</button>
</nav>
<main>

<section id="overview" class="tab active">
  <div class="card">
    <h2>Understand. Reduce. Measure.</h2>
    <p style="margin-bottom:16px">Assess your household footprint, get input-driven recommendations, and track measurable goals. Everything runs locally in your browser.</p>
    <button class="btn" onclick="switchTab('assess')">Start Assessment</button>
    <button class="btn secondary" onclick="loadDemo()">Load Demo Data</button>
  </div>
</section>

<section id="assess" class="tab">
  <h2>Environmental Assessment</h2>
  <div class="alert"><strong>Estimates only.</strong> Emission factors are demo values, not verified scientific constants.</div>
  <div class="card">
    <div class="grid grid-2">
      <div><label for="inEnergy">Electricity (kWh/month)</label><input type="number" id="inEnergy" min="0" step="0.01" placeholder="450"></div>
      <div><label for="inWater">Water (liters/month)</label><input type="number" id="inWater" min="0" step="0.01" placeholder="12000"></div>
      <div><label for="inWaste">Total waste (kg/month)</label><input type="number" id="inWaste" min="0" step="0.01" placeholder="60"></div>
      <div><label for="inDiverted">Waste diverted (kg/month)</label><input type="number" id="inDiverted" min="0" step="0.01" placeholder="15"></div>
      <div><label for="inTransport">Transport (km/month)</label><input type="number" id="inTransport" min="0" step="0.01" placeholder="800"></div>
      <div><label for="inHousehold">Household size *</label><input type="number" id="inHousehold" min="1" max="20" step="1" value="1"></div>
    </div>
    <div id="errors" class="error" style="display:none"></div>
    <div style="margin-top:16px;display:flex;gap:8px;flex-wrap:wrap">
      <button class="btn" onclick="calculate()">Calculate Assessment</button>
      <button class="btn secondary" onclick="loadDemo()">Load Demo</button>
      <button class="btn secondary" onclick="resetAll()">Reset</button>
    </div>
  </div>
</section>

<section id="results" class="tab">
  <h2>Results</h2>
  <div id="resultsContent"><div class="empty">No assessment yet. Go to Assess tab.</div></div>
</section>

<section id="goals" class="tab">
  <h2>Action Plan</h2>
  <div class="card">
    <h3>Create a Goal</h3>
    <div class="grid grid-2">
      <div><label for="goalTitle">Title *</label><input type="text" id="goalTitle" maxlength="120" placeholder="Reduce electricity by 15%"></div>
      <div><label for="goalTarget">Target</label><input type="number" id="goalTarget" min="0" step="0.01"></div>
      <div><label for="goalUnit">Unit</label><input type="text" id="goalUnit" maxlength="20" value="kWh"></div>
      <div><label for="goalDeadline">Deadline</label><input type="date" id="goalDeadline"></div>
    </div>
    <div style="margin-top:14px;display:flex;gap:8px;flex-wrap:wrap">
      <button class="btn" onclick="addGoal()">+ Add Goal</button>
      <button class="btn secondary" onclick="exportCSV()">Export CSV</button>
      <button class="btn secondary" onclick="exportJSON()">Export JSON</button>
    </div>
  </div>
  <div id="goalsList"></div>
</section>

<section id="method" class="tab">
  <h2>Methodology and Transparency</h2>
  <div class="alert"><strong>Scientific integrity.</strong> All factors below are DEMO VALUES, not universal constants.</div>
  <div class="card"><h3>Emission Formula</h3><pre>estimated_emissions = activity_value * emission_factor
total = sum(activity * factor) for each category</pre></div>
  <div class="card"><h3>Factors Used (DEMO)</h3>
    <table class="table">
      <tr><th>Category</th><th class="num">Factor</th><th>Unit</th></tr>
      <tr><td>Electricity</td><td class="num">0.45</td><td>kg CO2e/kWh</td></tr>
      <tr><td>Water</td><td class="num">0.0003</td><td>kg CO2e/L</td></tr>
      <tr><td>Waste</td><td class="num">0.5</td><td>kg CO2e/kg</td></tr>
      <tr><td>Transport</td><td class="num">0.192</td><td>kg CO2e/km</td></tr>
    </table>
  </div>
  <div class="card"><h3>Sustainability Score Formula</h3>
    <pre>energy_score = 100 - max(0, energy_per_person - 150) * 0.15
water_score  = 100 - max(0, water_per_person - 3000) * 0.008
waste_score  = (waste_diverted / total_waste) * 100
TOTAL = energy*0.35 + water*0.30 + waste*0.35</pre>
    <p style="font-size:.85rem;color:var(--mt);margin-top:12px">Custom indicator, not an official rating. Benchmarks are illustrative.</p>
  </div>
  <div class="card"><h3>Limitations</h3>
    <ul style="padding-left:20px;font-size:.9rem;line-height:1.8">
      <li>Factors are global averages - real values vary 10x+ by region</li>
      <li>Water emissions only capture treatment + pumping</li>
      <li>Waste assumes landfill; recycling not separately modeled</li>
      <li>Estimates are not verified measurements</li>
      <li>Data stored in localStorage - clearing browser erases it</li>
    </ul>
  </div>
</section>

</main>
<script>
var FACTORS={electricity:{rate:0.45,label:"Electricity"},water:{rate:0.0003,label:"Water"},waste:{rate:0.5,label:"Waste"},transport:{rate:0.192,label:"Transport"}};
var STORAGE_KEY="ecogenesis_v1";
var state={inputs:null,emissions:null,score:null,recommendations:[],goals:[],isDemo:false};
function $(id){return document.getElementById(id);}
function esc(s){return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");}
function fmt(n,d){if(n===null||n===undefined||!isFinite(n))return"—";d=(typeof d==="number")?d:1;return Number(n).toFixed(d);}
function getNum(id){var el=$(id);if(!el||el.value==="")return null;var v=parseFloat(el.value);return isFinite(v)?v:NaN;}
function save(){try{localStorage.setItem(STORAGE_KEY,JSON.stringify(state));}catch(e){}}
function load(){try{var raw=localStorage.getItem(STORAGE_KEY);if(!raw)return;var d=JSON.parse(raw);if(d&&typeof d==="object")state=d;}catch(e){}}
function switchTab(name){var tabs=document.querySelectorAll(".tab-btn");for(var i=0;i<tabs.length;i++){tabs[i].classList.toggle("active",tabs[i].getAttribute("data-tab")===name);}var panels=document.querySelectorAll(".tab");for(var j=0;j<panels.length;j++){panels[j].classList.toggle("active",panels[j].id===name);}if(name==="results")renderResults();if(name==="goals")renderGoals();}
function validate(inputs){var errs=[];var fields=[["electricity_kwh","Electricity"],["water_liters","Water"],["waste_kg","Waste"],["waste_diverted_kg","Diverted waste"],["transport_km","Transport"]];for(var i=0;i<fields.length;i++){var k=fields[i][0],l=fields[i][1],v=inputs[k];if(v===null)continue;if(isNaN(v)){errs.push(l+" must be a number");continue;}if(v<0)errs.push(l+" cannot be negative");}if(inputs.waste_kg!==null&&inputs.waste_diverted_kg!==null&&inputs.waste_diverted_kg>inputs.waste_kg){errs.push("Diverted cannot exceed total waste");}if(inputs.household_size<1||inputs.household_size>20){errs.push("Household size must be 1-20");}var hasData=false;for(var j=0;j<fields.length;j++){if(inputs[fields[j][0]]!==null){hasData=true;break;}}if(!hasData&&errs.length===0)errs.push("Enter at least one value");return errs;}
function calcEmissions(inputs){var by={},total=0;if(inputs.electricity_kwh!==null&&inputs.electricity_kwh>=0){by.electricity=inputs.electricity_kwh*FACTORS.electricity.rate;total+=by.electricity;}if(inputs.water_liters!==null&&inputs.water_liters>=0){by.water=inputs.water_liters*FACTORS.water.rate;total+=by.water;}if(inputs.waste_kg!==null&&inputs.waste_kg>=0){var dv=inputs.waste_diverted_kg||0;var lf=Math.max(0,inputs.waste_kg-dv);by.waste=lf*FACTORS.waste.rate;total+=by.waste;}if(inputs.transport_km!==null&&inputs.transport_km>=0){by.transport=inputs.transport_km*FACTORS.transport.rate;total+=by.transport;}return{total:total,by_source:by};}
function calcScore(inputs){var parts=[],hs=inputs.household_size||1;if(inputs.electricity_kwh!==null&&inputs.electricity_kwh>=0){var pp=inputs.electricity_kwh/hs;var s=100-Math.max(0,pp-150)*0.15;parts.push({w:0.35,v:Math.max(0,Math.min(100,s))});}if(inputs.water_liters!==null&&inputs.water_liters>=0){var pp2=inputs.water_liters/hs;var s2=100-Math.max(0,pp2-3000)*0.008;parts.push({w:0.30,v:Math.max(0,Math.min(100,s2))});}if(inputs.waste_kg!==null&&inputs.waste_kg>0){var dv=(inputs.waste_diverted_kg||0)/inputs.waste_kg;parts.push({w:0.35,v:Math.max(0,Math.min(100,dv*100))});}if(parts.length===0)return{score:null,note:"Insufficient data"};var tw=0,acc=0;for(var i=0;i<parts.length;i++){tw+=parts[i].w;acc+=parts[i].w*parts[i].v;}return{score:Math.round(acc/tw),coverage:tw,note:tw<1?"Partial data - weights redistributed":null};}
function recommend(inputs,sc){var recs=[],hs=inputs.household_size||1;var epp=(inputs.electricity_kwh||0)/hs;var wpp=(inputs.water_liters||0)/hs;var w=inputs.waste_kg||0,dv=inputs.waste_diverted_kg||0;var div=w>0?dv/w:null;if(epp>200)recs.push({priority:"high",title:"Switch to LED lighting",why:"Your electricity (~"+Math.round(epp)+" kWh/person/month) exceeds the 150 kWh benchmark.",benefit:"5-15% reduction"});if(wpp>4000)recs.push({priority:"high",title:"Inspect and repair leaks",why:"Your water use (~"+Math.round(wpp)+" L/person/month) exceeds 3000 L benchmark.",benefit:"5-20% reduction"});if(div!==null&&div<0.3)recs.push({priority:"high",title:"Improve waste separation",why:"Only ~"+Math.round(div*100)+"% of your waste is diverted (target: 50%).",benefit:"20-40 percentage points"});if(div!==null&&div<0.5)recs.push({priority:"medium",title:"Start home composting",why:"Organics are 30-40% of household waste.",benefit:"Diverts 30-40% of waste"});if((inputs.transport_km||0)>500)recs.push({priority:"medium",title:"Combine trips and use transit",why:"Your transport ("+inputs.transport_km+" km/month) suggests opportunity.",benefit:"10-30% reduction"});if(recs.length===0)recs.push({priority:"low",title:"Maintain your good habits",why:"Your consumption is below sustainable benchmarks.",benefit:"Maintains savings"});return recs;}
function calculate(){var inputs={electricity_kwh:getNum("inEnergy"),water_liters:getNum("inWater"),waste_kg:getNum("inWaste"),waste_diverted_kg:getNum("inDiverted"),transport_km:getNum("inTransport"),household_size:parseInt($("inHousehold").value,10)||1};var errs=validate(inputs);var errEl=$("errors");if(errs.length){errEl.textContent=errs.join(" - ");errEl.style.display="block";return;}errEl.style.display="none";state.inputs=inputs;state.emissions=calcEmissions(inputs);state.score=calcScore(inputs);state.recommendations=recommend(inputs,state.score);state.isDemo=false;save();renderResults();switchTab("results");}
function renderResults(){var c=$("resultsContent");if(!state.inputs){c.innerHTML='<div class="empty">No assessment yet. Go to Assess tab.</div>';return;}var h="";if(state.isDemo)h+='<div class="alert"><strong>Demo data loaded.</strong> Illustrative sample values - not real measurements.</div>';h+='<div class="grid grid-4" style="margin-bottom:16px">';h+='<div class="metric"><div class="metric-label">Electricity</div><div class="metric-value">'+fmt(state.inputs.electricity_kwh)+'</div><div class="metric-unit">kWh/month</div></div>';h+='<div class="metric"><div class="metric-label">Water</div><div class="metric-value">'+fmt(state.inputs.water_liters)+'</div><div class="metric-unit">L/month</div></div>';h+='<div class="metric"><div class="metric-label">Waste</div><div class="metric-value">'+fmt(state.inputs.waste_kg)+'</div><div class="metric-unit">kg/month</div></div>';h+='<div class="metric"><div class="metric-label">Emissions</div><div class="metric-value">'+fmt(state.emissions.total,1)+'</div><div class="metric-unit">kg CO2e/month</div></div>';h+='</div>';if(state.score&&state.score.score!==null){var sc=state.score.score;var color=sc>=70?"#10b981":(sc>=40?"#f59e0b":"#dc2626");h+='<div class="card"><h2>Sustainability Score</h2><div style="font-size:3rem;font-weight:800;color:'+color+'">'+sc+' / 100</div>';if(state.score.note)h+='<p style="font-size:.85rem;color:#5a7268">'+esc(state.score.note)+'</p>';h+='</div>';}h+='<div class="card"><h2>Emissions by Source</h2><table class="table"><tr><th>Source</th><th class="num">kg CO2e/month</th></tr>';var keys=Object.keys(state.emissions.by_source);for(var i=0;i<keys.length;i++){h+='<tr><td>'+FACTORS[keys[i]].label+'</td><td class="num">'+fmt(state.emissions.by_source[keys[i]],2)+'</td></tr>';}h+='</table></div>';h+='<h2 style="margin-top:20px">Recommendations</h2>';for(var j=0;j<state.recommendations.length;j++){var r=state.recommendations[j];h+='<div class="rec"><div style="display:flex;justify-content:space-between;align-items:flex-start;gap:10px"><h3>'+esc(r.title)+'</h3><span class="badge '+r.priority+'">'+r.priority+'</span></div>';h+='<div class="why">Why: '+esc(r.why)+'</div>';h+='<p style="font-size:.85rem;color:#5a7268">Est. benefit: '+esc(r.benefit)+'</p></div>';}c.innerHTML=h;}
function renderGoals(){var c=$("goalsList");if(!state.goals||state.goals.length===0){c.innerHTML='<div class="empty">No goals yet. Create one above.</div>';return;}var today=new Date().toISOString().slice(0,10);var h="";for(var i=0;i<state.goals.length;i++){var g=state.goals[i];var overdue=g.deadline&&g.deadline<today&&g.status!=="completed";h+='<div class="goal"'+(overdue?' style="border-color:#dc2626"':'')+'>';h+='<div style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap">';h+='<strong>'+esc(g.title)+'</strong><div>';h+='<button class="btn secondary" style="padding:4px 10px;font-size:.8rem" onclick="advanceGoal(\''+g.id+'\')">'+(g.status==="completed"?"Reset":"Advance")+'</button> ';h+='<button class="btn danger" style="padding:4px 10px;font-size:.8rem" onclick="deleteGoal(\''+g.id+'\')">Delete</button>';h+='</div></div>';h+='<div class="goal-bar"><div style="width:'+(g.progress||0)+'%"></div></div>';h+='<div style="font-size:.8rem;color:#5a7268;display:flex;justify-content:space-between"><span>'+(g.progress||0)+'% - '+g.status+'</span><span>'+(g.deadline?g.deadline:"No deadline")+'</span></div></div>';}c.innerHTML=h;}
function addGoal(){var title=$("goalTitle").value.trim();if(!title){alert("Title required");return;}var goal={id:"g_"+Date.now()+"_"+Math.floor(Math.random()*1000),title:title,target:parseFloat($("goalTarget").value)||null,unit:$("goalUnit").value||"",deadline:$("goalDeadline").value||null,status:"pending",progress:0};state.goals.push(goal);save();$("goalTitle").value="";$("goalTarget").value="";renderGoals();}
function advanceGoal(id){for(var i=0;i<state.goals.length;i++){if(state.goals[i].id===id){var g=state.goals[i];if(g.status==="completed"){g.progress=0;g.status="pending";}else{g.progress=Math.min(100,(g.progress||0)+25);g.status=g.progress>=100?"completed":"in-progress";}save();renderGoals();return;}}}
function deleteGoal(id){if(!confirm("Delete this goal?"))return;var out=[];for(var i=0;i<state.goals.length;i++)if(state.goals[i].id!==id)out.push(state.goals[i]);state.goals=out;save();renderGoals();}
function loadDemo(){$("inEnergy").value=450;$("inWater").value=12000;$("inWaste").value=60;$("inDiverted").value=15;$("inTransport").value=800;$("inHousehold").value=3;calculate();state.isDemo=true;save();renderResults();}
function resetAll(){if(!confirm("Reset all data?"))return;state={inputs:null,emissions:null,score:null,recommendations:[],goals:[],isDemo:false};try{localStorage.removeItem(STORAGE_KEY);}catch(e){}$("inEnergy").value="";$("inWater").value="";$("inWaste").value="";$("inDiverted").value="";$("inTransport").value="";$("inHousehold").value=1;$("errors").style.display="none";renderResults();renderGoals();}
function exportCSV(){if(!state.inputs){alert("Run assessment first");return;}var rows=[["EcoGenesis AI - Assessment"],["Generated",new Date().toISOString()],["Data source",state.isDemo?"DEMO":"User"],[],["Input","Value","Unit"],["Electricity",state.inputs.electricity_kwh||"","kWh/month"],["Water",state.inputs.water_liters||"","L/month"],["Waste",state.inputs.waste_kg||"","kg/month"],["Transport",state.inputs.transport_km||"","km/month"],["Household",state.inputs.household_size||1,"people"],[],["Emission source","kg CO2e/month"]];var keys=Object.keys(state.emissions.by_source);for(var i=0;i<keys.length;i++)rows.push([keys[i],state.emissions.by_source[keys[i]].toFixed(3)]);rows.push(["TOTAL",state.emissions.total.toFixed(3)]);rows.push([]);rows.push(["Score",state.score&&state.score.score!==null?state.score.score+"/100":"N/A"]);rows.push([]);rows.push(["NOTE","DEMO VALUES - not verified measurements"]);var csv="";for(var r=0;r<rows.length;r++){var line=[];for(var c=0;c<rows[r].length;c++){var cell=String(rows[r][c]===null||rows[r][c]===undefined?"":rows[r][c]);line.push('"'+cell.replace(/"/g,'""')+'"');}csv+=line.join(",")+"\n";}download(csv,"ecogenesis.csv","text/csv");}
function exportJSON(){if(!state.inputs){alert("Run assessment first");return;}var payload={app:"EcoGenesis AI",exported:new Date().toISOString(),data_source:state.isDemo?"demo":"user",inputs:state.inputs,emissions:state.emissions,score:state.score,goals:state.goals,disclaimer:"DEMO VALUES - not verified measurements"};download(JSON.stringify(payload,null,2),"ecogenesis.json","application/json");}
function download(content,filename,mime){var blob=new Blob([content],{type:mime+";charset=utf-8"});var url=URL.createObjectURL(blob);var a=document.createElement("a");a.href=url;a.download=filename;document.body.appendChild(a);a.click();document.body.removeChild(a);setTimeout(function(){URL.revokeObjectURL(url);},100);}
var btns=document.querySelectorAll(".tab-btn");for(var bi=0;bi<btns.length;bi++){btns[bi].addEventListener("click",function(){switchTab(this.getAttribute("data-tab"));});}
load();
if(state.inputs){var s=state.inputs;if(s.electricity_kwh!=null)$("inEnergy").value=s.electricity_kwh;if(s.water_liters!=null)$("inWater").value=s.water_liters;if(s.waste_kg!=null)$("inWaste").value=s.waste_kg;if(s.waste_diverted_kg!=null)$("inDiverted").value=s.waste_diverted_kg;if(s.transport_km!=null)$("inTransport").value=s.transport_km;if(s.household_size)$("inHousehold").value=s.household_size;}
renderResults();
renderGoals();
</script>
</body>
</html>
