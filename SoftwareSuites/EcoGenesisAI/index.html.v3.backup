<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#0f766e">
<title>EcoGenesis AI — GAIA Edition</title>
<style>
:root{
  --teal:#0f766e;--teal-dark:#134e4a;--teal-light:#14b8a6;--mint:#86efac;
  --amber:#f59e0b;--amber-soft:#fef3c7;--violet:#8b5cf6;--cyan:#06b6d4;
  --bg:#f8faf9;--surface:#ffffff;--surface-2:#f0fdf4;
  --text:#0f172a;--muted:#64748b;--border:#e2e8f0;
  --danger:#dc2626;--danger-soft:#fee2e2;
  --shadow-sm:0 1px 2px rgba(15,118,110,.06);
  --shadow:0 4px 16px rgba(15,118,110,.08);
  --shadow-lg:0 20px 48px rgba(15,118,110,.14);
  --glow:0 0 20px rgba(20,184,166,.4);
  --r:14px;--r-sm:10px;--transition:200ms cubic-bezier(.4,0,.2,1);
}
[data-theme="dark"]{
  --bg:#050a08;--surface:#0a1410;--surface-2:#0d1a15;
  --text:#e8f0ed;--muted:#94a3b8;--border:#1a2f28;
  --teal:#14b8a6;--teal-dark:#0f766e;--teal-light:#2dd4bf;--mint:#4ade80;
  --amber:#fbbf24;--amber-soft:#3f2a0a;--violet:#a78bfa;--cyan:#22d3ee;
  --danger:#f87171;--danger-soft:#3f1a1a;
  --shadow-sm:0 1px 2px rgba(0,0,0,.3);
  --shadow:0 4px 16px rgba(0,0,0,.35);
  --shadow-lg:0 20px 48px rgba(0,0,0,.5);
  --glow:0 0 24px rgba(45,212,191,.5);
}
*{box-sizing:border-box;margin:0;padding:0}
html{font-size:16px;-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{font-family:'Inter',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
  background:var(--bg);color:var(--text);line-height:1.6;min-height:100vh;
  transition:background var(--transition),color var(--transition);
  -webkit-font-smoothing:antialiased;overflow-x:hidden;position:relative}
body::before{content:'';position:fixed;inset:0;
  background:radial-gradient(circle at 15% 15%,rgba(20,184,166,.08),transparent 40%),
    radial-gradient(circle at 85% 85%,rgba(139,92,246,.06),transparent 40%);
  pointer-events:none;z-index:0;animation:aurora 25s ease infinite}
@keyframes aurora{0%,100%{opacity:.6;transform:scale(1)}50%{opacity:1;transform:scale(1.1)}}
#particles{position:fixed;inset:0;pointer-events:none;z-index:1;opacity:.5}
#cursor-glow{position:fixed;width:400px;height:400px;border-radius:50%;
  background:radial-gradient(circle,rgba(20,184,166,.15),transparent 70%);
  pointer-events:none;z-index:2;transition:transform .1s ease-out;
  transform:translate(-50%,-50%);opacity:0}
@media (hover:hover){#cursor-glow{opacity:1}}
main,header,nav,footer{position:relative;z-index:10}
a{color:var(--teal);text-decoration:none}
button{font:inherit;cursor:pointer;border:none;background:none;color:inherit}
:focus-visible{outline:2px solid var(--teal-light);outline-offset:2px;border-radius:6px}

header{background:color-mix(in srgb,var(--surface) 88%,transparent);
  backdrop-filter:blur(20px) saturate(180%);-webkit-backdrop-filter:blur(20px) saturate(180%);
  border-bottom:1px solid var(--border);padding:14px 20px;position:sticky;top:0;z-index:50;
  display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.brand{display:flex;align-items:center;gap:10px}
.brand-mark{width:44px;height:44px;border-radius:14px;flex-shrink:0;
  background:conic-gradient(from 0deg,#14b8a6,#06b6d4,#8b5cf6,#f59e0b,#14b8a6);
  display:flex;align-items:center;justify-content:center;position:relative;
  box-shadow:0 0 24px rgba(20,184,166,.4);animation:spinGlow 8s linear infinite}
@keyframes spinGlow{to{filter:hue-rotate(360deg)}}
.brand-mark::before{content:'';position:absolute;inset:3px;background:var(--surface);
  border-radius:11px}
.brand-mark svg{width:24px;height:24px;fill:url(#brandGrad);position:relative;z-index:1}
.brand-name{font-size:1.05rem;font-weight:800;letter-spacing:-.02em}
.brand-tag{font-size:.7rem;color:var(--muted);font-weight:600;
  display:flex;align-items:center;gap:4px}
.brand-tag .live{width:6px;height:6px;border-radius:50%;background:#10b981;
  animation:pulse 1.5s infinite;box-shadow:0 0 8px #10b981}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(.8)}}
.xp-widget{display:flex;flex-direction:column;gap:2px;min-width:100px}
.xp-label{font-size:.65rem;font-weight:700;color:var(--muted);
  text-transform:uppercase;letter-spacing:.05em;display:flex;justify-content:space-between}
.xp-label strong{color:var(--teal)}
.xp-track{height:6px;background:var(--surface-2);border-radius:3px;overflow:hidden}
.xp-fill{height:100%;background:linear-gradient(90deg,var(--teal-light),var(--violet));
  border-radius:3px;transition:width .6s ease;box-shadow:0 0 8px rgba(20,184,166,.5)}
.header-actions{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.icon-btn{width:38px;height:38px;border-radius:10px;display:flex;align-items:center;
  justify-content:center;background:var(--surface-2);border:1px solid var(--border);
  transition:all var(--transition);position:relative;font-size:.7rem;font-weight:700}
.icon-btn:hover{background:var(--teal);color:#fff;border-color:var(--teal);
  transform:translateY(-1px);box-shadow:0 0 12px rgba(20,184,166,.4)}
.icon-btn svg{width:18px;height:18px;fill:currentColor}
.icon-btn.on{background:var(--teal);color:#fff}

nav{background:var(--surface);border-bottom:1px solid var(--border);padding:6px 12px;
  display:flex;gap:2px;overflow-x:auto;scrollbar-width:none;
  position:sticky;top:73px;z-index:40;backdrop-filter:blur(12px)}
nav::-webkit-scrollbar{display:none}
.tab-btn{padding:9px 14px;font-size:.83rem;font-weight:600;color:var(--muted);
  border-radius:8px;white-space:nowrap;transition:all var(--transition);
  display:flex;align-items:center;gap:6px}
.tab-btn:hover{background:var(--surface-2);color:var(--text)}
.tab-btn.active{background:linear-gradient(135deg,var(--teal),var(--teal-light));
  color:#fff;box-shadow:0 4px 12px rgba(20,184,166,.3)}
.tab-btn .badge-new{background:var(--violet);color:#fff;font-size:.55rem;
  padding:1px 5px;border-radius:4px;font-weight:800;letter-spacing:.05em}

main{max-width:1080px;margin:0 auto;padding:24px 16px 120px}
.tab-panel{display:none;animation:fadeUp .35s ease}
.tab-panel.active{display:block}
@keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

.hero{position:relative;border-radius:24px;padding:56px 32px 48px;color:#fff;
  overflow:hidden;margin-bottom:24px;
  background:linear-gradient(135deg,#0f766e 0%,#134e4a 40%,#0f766e 100%);
  background-size:200% 200%;animation:heroShift 15s ease infinite;
  box-shadow:0 20px 60px -20px rgba(15,118,110,.5)}
@keyframes heroShift{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}
.hero::before{content:'';position:absolute;inset:0;
  background:radial-gradient(circle at 20% 20%,rgba(20,184,166,.6),transparent 50%),
    radial-gradient(circle at 80% 80%,rgba(139,92,246,.4),transparent 50%);
  animation:aurora 12s ease infinite}
.hero::after{content:'';position:absolute;inset:0;
  background:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='60' height='60'><circle cx='30' cy='30' r='1' fill='white' opacity='.2'/></svg>");
  opacity:.4}
.hero>*{position:relative;z-index:1}
.hero-eyebrow{display:inline-flex;align-items:center;gap:6px;
  background:rgba(255,255,255,.15);backdrop-filter:blur(8px);
  padding:6px 14px;border-radius:999px;font-size:.72rem;font-weight:600;
  letter-spacing:.02em;margin-bottom:20px;border:1px solid rgba(255,255,255,.2)}
.hero-eyebrow .dot{width:6px;height:6px;background:#86efac;border-radius:50%;
  animation:pulse 2s infinite;box-shadow:0 0 8px #86efac}
.hero h1{font-size:clamp(1.9rem,5vw,3rem);font-weight:800;letter-spacing:-.03em;
  line-height:1.08;margin-bottom:14px;max-width:660px}
.hero h1 em{color:#86efac;font-style:normal;
  text-shadow:0 0 24px rgba(134,239,172,.6)}
.hero p{font-size:1.02rem;opacity:.94;margin-bottom:28px;max-width:540px}
.hero-actions{display:flex;gap:10px;flex-wrap:wrap}
.hero .btn{padding:13px 26px;font-size:.92rem;font-weight:700;border-radius:12px;
  transition:all var(--transition)}
.hero .btn-primary{background:#fff;color:var(--teal-dark);box-shadow:0 4px 16px rgba(0,0,0,.2)}
.hero .btn-primary:hover{transform:translateY(-2px);box-shadow:0 12px 32px rgba(0,0,0,.35)}
.hero .btn-ghost{background:rgba(255,255,255,.15);color:#fff;
  border:1px solid rgba(255,255,255,.3);backdrop-filter:blur(8px)}
.hero .btn-ghost:hover{background:rgba(255,255,255,.28);transform:translateY(-2px)}

.trust-strip{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
  gap:12px;margin-bottom:24px}
.trust-item{background:color-mix(in srgb,var(--surface) 80%,transparent);
  backdrop-filter:blur(12px);border:1px solid var(--border);
  border-radius:var(--r);padding:16px;display:flex;gap:12px;align-items:flex-start;
  transition:all var(--transition)}
.trust-item:hover{transform:translateY(-2px);box-shadow:var(--shadow);border-color:var(--teal-light)}
.trust-icon{width:36px;height:36px;border-radius:10px;
  background:linear-gradient(135deg,var(--teal),var(--teal-light));
  display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#fff}
.trust-icon svg{width:18px;height:18px;fill:currentColor}
.trust-item h4{font-size:.88rem;font-weight:700;margin-bottom:2px}
.trust-item p{font-size:.78rem;color:var(--muted);line-height:1.4}

.card{background:color-mix(in srgb,var(--surface) 85%,transparent);
  backdrop-filter:blur(12px);border:1px solid var(--border);
  border-radius:var(--r);padding:20px;box-shadow:var(--shadow-sm);
  margin-bottom:16px;transition:all var(--transition);position:relative}
.card:hover{border-color:color-mix(in srgb,var(--teal) 30%,var(--border))}
.card-title{font-size:.78rem;font-weight:700;color:var(--muted);
  text-transform:uppercase;letter-spacing:.08em;margin-bottom:14px;
  display:flex;align-items:center;gap:6px}
.card-title::before{content:'';width:3px;height:14px;
  background:linear-gradient(180deg,var(--teal),var(--violet));border-radius:2px}

.alert{padding:14px 16px;border-radius:var(--r-sm);font-size:.85rem;
  margin-bottom:16px;display:flex;gap:10px;align-items:flex-start}
.alert svg{width:20px;height:20px;flex-shrink:0;fill:currentColor}
.alert-warn{background:var(--amber-soft);color:#78350f;border-left:3px solid var(--amber)}
.alert-info{background:var(--surface-2);color:var(--teal-dark);border-left:3px solid var(--teal)}
[data-theme="dark"] .alert-warn{color:#fbbf24}

.grid{display:grid;gap:14px}
.grid-2{grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}
.grid-3{grid-template-columns:repeat(auto-fit,minmax(160px,1fr))}
.grid-4{grid-template-columns:repeat(auto-fit,minmax(150px,1fr))}

.form-field{display:flex;flex-direction:column;gap:6px}
.form-field label{font-size:.82rem;font-weight:600;color:var(--text);
  display:flex;align-items:center;gap:6px}
.form-field .field-icon{width:22px;height:22px;background:var(--surface-2);
  border-radius:6px;display:inline-flex;align-items:center;justify-content:center;
  color:var(--teal);flex-shrink:0}
.form-field .field-icon svg{width:12px;height:12px;fill:currentColor}
.form-field .hint{font-size:.7rem;color:var(--muted)}
.form-field input{padding:11px 14px;border:1.5px solid var(--border);
  border-radius:var(--r-sm);font:inherit;font-size:.92rem;background:var(--surface);
  color:var(--text);transition:all var(--transition);width:100%}
.form-field input:focus{outline:none;border-color:var(--teal);
  box-shadow:0 0 0 3px color-mix(in srgb,var(--teal) 15%,transparent)}
.form-field input.invalid{border-color:var(--danger);background:var(--danger-soft)}

.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;
  padding:11px 20px;border-radius:var(--r-sm);font-weight:600;font-size:.88rem;
  transition:all var(--transition);white-space:nowrap}
.btn-primary{background:linear-gradient(135deg,var(--teal),var(--teal-light));color:#fff}
.btn-primary:hover{transform:translateY(-1px);box-shadow:0 8px 24px rgba(20,184,166,.35)}
.btn-secondary{background:var(--surface-2);color:var(--teal);border:1px solid var(--border)}
.btn-secondary:hover{background:var(--teal);color:#fff;border-color:var(--teal)}
.btn-ghost{color:var(--muted);border:1px solid var(--border)}
.btn-ghost:hover{color:var(--text);background:var(--surface-2)}
.btn-danger{background:var(--danger-soft);color:var(--danger)}
.btn-danger:hover{background:var(--danger);color:#fff}
.btn-sm{padding:6px 12px;font-size:.78rem}
.btn svg{width:16px;height:16px;fill:currentColor}

.metric{background:color-mix(in srgb,var(--surface) 90%,transparent);
  backdrop-filter:blur(8px);border:1px solid var(--border);
  border-radius:var(--r);padding:16px;position:relative;transition:all var(--transition)}
.metric:hover{box-shadow:var(--shadow);transform:translateY(-2px)}
.metric-label{font-size:.72rem;color:var(--muted);text-transform:uppercase;
  letter-spacing:.05em;font-weight:700}
.metric-value{font-size:1.55rem;font-weight:800;color:var(--teal);
  margin:6px 0 2px;letter-spacing:-.02em}
.metric-unit{font-size:.72rem;color:var(--muted)}
.metric-icon{position:absolute;top:14px;right:14px;width:34px;height:34px;
  border-radius:10px;background:linear-gradient(135deg,var(--teal),var(--teal-light));
  display:flex;align-items:center;justify-content:center;color:#fff}
.metric-icon svg{width:16px;height:16px;fill:currentColor}

.score-ring-wrap{display:flex;flex-direction:column;align-items:center;padding:24px 12px}
.score-ring{width:220px;height:220px;position:relative}
.score-ring svg{width:100%;height:100%;transform:rotate(-90deg)}
.score-ring-bg{fill:none;stroke:var(--surface-2);stroke-width:16}
.score-ring-fg{fill:none;stroke:url(#ringGrad);stroke-width:16;stroke-linecap:round;
  transition:stroke-dasharray 1.2s cubic-bezier(.4,0,.2,1);
  filter:drop-shadow(0 0 8px rgba(20,184,166,.5))}
.score-value{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
  font-size:3.2rem;font-weight:800;letter-spacing:-.04em;
  background:linear-gradient(135deg,var(--teal),var(--violet));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.score-value small{font-size:1rem;color:var(--muted);-webkit-text-fill-color:var(--muted)}
.score-note{margin-top:12px;font-size:.82rem;color:var(--muted);text-align:center;max-width:280px}
.score-badge{margin-top:12px;padding:5px 14px;border-radius:999px;font-size:.75rem;
  font-weight:700;text-transform:uppercase;letter-spacing:.04em}
.score-badge.good{background:#d1fae5;color:#065f46}
.score-badge.ok{background:var(--amber-soft);color:#92400e}
.score-badge.poor{background:var(--danger-soft);color:var(--danger)}

.sub-bar-wrap{margin:12px 0}
.sub-bar-header{display:flex;justify-content:space-between;font-size:.82rem;
  font-weight:600;margin-bottom:6px}
.sub-bar-track{height:10px;background:var(--surface-2);border-radius:999px;
  overflow:hidden;position:relative}
.sub-bar-fill{height:100%;border-radius:999px;transition:width .8s ease;
  box-shadow:0 0 12px currentColor}

.donut-wrap{display:flex;gap:20px;align-items:center;flex-wrap:wrap}
.donut{width:180px;height:180px;flex-shrink:0}
.donut-legend{flex:1;min-width:160px;display:flex;flex-direction:column;gap:10px}
.legend-item{display:flex;align-items:center;gap:10px;font-size:.85rem}
.legend-dot{width:12px;height:12px;border-radius:4px;flex-shrink:0}
.legend-label{flex:1;color:var(--text)}
.legend-val{font-weight:700;color:var(--teal)}

.equivalent{background:linear-gradient(135deg,var(--surface-2),var(--surface));
  border:1px solid var(--border);border-radius:var(--r);padding:16px;
  text-align:center;transition:all var(--transition)}
.equivalent:hover{transform:translateY(-3px);box-shadow:var(--shadow);
  border-color:var(--teal-light)}
.equivalent-icon{font-size:1.8rem;margin-bottom:6px;display:block}
.equivalent-value{font-size:1.4rem;font-weight:800;color:var(--teal);letter-spacing:-.02em}
.equivalent-label{font-size:.75rem;color:var(--muted);margin-top:2px;line-height:1.35}

.sim-slider-row{display:flex;flex-direction:column;gap:6px;margin-bottom:16px}
.sim-header{display:flex;justify-content:space-between;align-items:baseline}
.sim-slider-row label{font-size:.85rem;font-weight:600}
.sim-value{font-size:.88rem;font-weight:700;color:var(--teal);
  background:var(--surface-2);padding:2px 10px;border-radius:999px}
input[type=range]{-webkit-appearance:none;appearance:none;width:100%;height:6px;
  border-radius:3px;background:var(--surface-2);outline:none;cursor:pointer}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:22px;height:22px;
  border-radius:50%;background:linear-gradient(135deg,var(--teal),var(--teal-light));
  border:3px solid var(--surface);box-shadow:var(--shadow);cursor:pointer;
  transition:transform var(--transition)}
input[type=range]::-webkit-slider-thumb:hover{transform:scale(1.15)}
input[type=range]::-moz-range-thumb{width:22px;height:22px;border-radius:50%;
  background:var(--teal);border:3px solid var(--surface);cursor:pointer}
.sim-result{background:linear-gradient(135deg,var(--teal),var(--violet));
  color:#fff;border-radius:var(--r);padding:20px;margin-top:14px;
  display:grid;grid-template-columns:1fr 1fr;gap:16px}
.sim-result-item{text-align:center}
.sim-result-item .v{font-size:1.5rem;font-weight:800;letter-spacing:-.02em}
.sim-result-item .l{font-size:.72rem;opacity:.85;margin-top:2px;
  text-transform:uppercase;letter-spacing:.04em}

.rec-filters{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:16px}
.rec-filter-btn{padding:6px 14px;border-radius:999px;font-size:.8rem;font-weight:600;
  background:var(--surface-2);color:var(--muted);border:1px solid var(--border);
  transition:all var(--transition)}
.rec-filter-btn:hover{background:var(--teal);color:#fff;border-color:var(--teal)}
.rec-filter-btn.active{background:var(--teal);color:#fff;border-color:var(--teal)}
.rec{background:color-mix(in srgb,var(--surface) 90%,transparent);
  backdrop-filter:blur(8px);border:1px solid var(--border);border-radius:var(--r);
  padding:18px;margin-bottom:12px;position:relative;transition:all var(--transition);
  border-left:4px solid var(--teal);overflow:hidden}
.rec::before{content:'';position:absolute;top:0;right:0;width:100px;height:100px;
  background:radial-gradient(circle,rgba(20,184,166,.08),transparent 70%);
  pointer-events:none}
.rec:hover{transform:translateY(-2px);box-shadow:var(--shadow);
  border-left-color:var(--teal-light)}
.rec.priority-high{border-left-color:var(--danger)}
.rec.priority-medium{border-left-color:var(--amber)}
.rec.priority-low{border-left-color:var(--teal-light)}
.rec-header{display:flex;align-items:flex-start;justify-content:space-between;
  gap:12px;margin-bottom:8px}
.rec-title{font-size:.98rem;font-weight:700;color:var(--text);flex:1}
.rec-badge{padding:3px 10px;border-radius:999px;font-size:.68rem;font-weight:700;
  text-transform:uppercase;letter-spacing:.04em;flex-shrink:0}
.rec-badge.high{background:var(--danger-soft);color:var(--danger)}
.rec-badge.medium{background:var(--amber-soft);color:#92400e}
.rec-badge.low{background:#d1fae5;color:#065f46}
[data-theme="dark"] .rec-badge.low{color:#86efac}
.rec-desc{font-size:.87rem;color:var(--text);margin-bottom:10px}
.rec-why{background:var(--surface-2);padding:10px 12px;border-radius:var(--r-sm);
  font-size:.82rem;color:var(--muted);font-style:italic;margin-bottom:10px}
.rec-meta{display:flex;gap:16px;flex-wrap:wrap;font-size:.78rem;color:var(--muted)}
.rec-meta strong{color:var(--text);font-weight:600}

.achievements{display:flex;gap:10px;flex-wrap:wrap;margin-top:8px}
.achievement{display:flex;align-items:center;gap:8px;padding:8px 14px;
  background:linear-gradient(135deg,#fef3c7,#fde68a);color:#78350f;
  border-radius:999px;font-size:.78rem;font-weight:700;animation:pop .5s ease;
  box-shadow:0 2px 8px rgba(245,158,11,.3)}
[data-theme="dark"] .achievement{background:linear-gradient(135deg,#3f2a0a,#5c3d0a);color:#fbbf24}
.achievement .em{font-size:1rem}
@keyframes pop{0%{transform:scale(.5);opacity:0}70%{transform:scale(1.05)}100%{transform:scale(1);opacity:1}}

.goal{background:color-mix(in srgb,var(--surface) 90%,transparent);
  backdrop-filter:blur(8px);border:1px solid var(--border);
  border-radius:var(--r-sm);padding:14px;margin-bottom:10px;transition:all var(--transition)}
.goal:hover{box-shadow:var(--shadow-sm)}
.goal.overdue{border-color:var(--danger);animation:shake 2s infinite}
@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-2px)}75%{transform:translateX(2px)}}
.goal-header{display:flex;justify-content:space-between;align-items:center;
  gap:10px;margin-bottom:8px;flex-wrap:wrap}
.goal-title{font-weight:700;font-size:.92rem;flex:1;min-width:150px}
.goal-actions{display:flex;gap:6px}
.progress-track{height:8px;background:var(--surface-2);border-radius:999px;
  overflow:hidden;margin:10px 0 6px}
.progress-fill{height:100%;background:linear-gradient(90deg,var(--teal),var(--teal-light));
  border-radius:999px;transition:width .5s ease;box-shadow:0 0 12px var(--teal-light)}
.goal-meta{display:flex;justify-content:space-between;font-size:.75rem;
  color:var(--muted);flex-wrap:wrap;gap:6px}
.goal-templates{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px}
.goal-template{padding:6px 12px;background:var(--surface-2);border:1px solid var(--border);
  border-radius:999px;font-size:.78rem;font-weight:600;color:var(--teal);
  cursor:pointer;transition:all var(--transition)}
.goal-template:hover{background:var(--teal);color:#fff;border-color:var(--teal)}

.insight{background:color-mix(in srgb,var(--surface) 90%,transparent);
  backdrop-filter:blur(8px);border:1px solid var(--border);border-radius:var(--r);
  padding:16px;margin-bottom:12px;display:flex;gap:14px;align-items:flex-start;
  transition:all var(--transition)}
.insight:hover{transform:translateY(-2px);box-shadow:var(--shadow)}
.insight-icon{width:44px;height:44px;border-radius:12px;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;font-size:1.4rem}
.insight-body{flex:1}
.insight-title{font-weight:700;font-size:.95rem;margin-bottom:4px}
.insight-text{font-size:.85rem;color:var(--muted);line-height:1.5}
.insight.good .insight-icon{background:#d1fae5;color:#065f46}
.insight.warn .insight-icon{background:var(--amber-soft);color:#92400e}
.insight.bad .insight-icon{background:var(--danger-soft);color:var(--danger)}
.insight.info .insight-icon{background:var(--surface-2);color:var(--teal)}

table.data{width:100%;border-collapse:collapse;font-size:.85rem}
table.data th{text-align:left;padding:10px 8px;font-size:.72rem;font-weight:700;
  text-transform:uppercase;letter-spacing:.05em;color:var(--muted);
  border-bottom:2px solid var(--border)}
table.data td{padding:10px 8px;border-bottom:1px solid var(--border)}
table.data .num{text-align:right;font-variant-numeric:tabular-nums}
table.data tr:last-child td{border-bottom:none}

.compare-row{margin-bottom:16px}
.compare-header{display:flex;justify-content:space-between;font-size:.85rem;margin-bottom:8px}
.compare-header .label{font-weight:600}
.compare-header .value{color:var(--muted);font-size:.8rem}
.compare-track{height:24px;background:var(--surface-2);border-radius:12px;
  overflow:hidden;position:relative}
.compare-fill{height:100%;border-radius:12px;transition:width .8s ease;
  display:flex;align-items:center;padding-left:8px;color:#fff;
  font-size:.72rem;font-weight:700;box-shadow:0 0 12px currentColor}
.compare-target{position:absolute;top:0;bottom:0;width:2px;background:var(--danger);
  opacity:.8;box-shadow:0 0 4px var(--danger)}

.empty{text-align:center;padding:48px 20px;color:var(--muted)}
.empty svg{width:56px;height:56px;fill:var(--border);margin-bottom:12px}
.empty p{font-size:.9rem;margin-bottom:16px}

#toast{position:fixed;bottom:80px;left:50%;
  transform:translateX(-50%) translateY(120px);
  background:var(--text);color:var(--surface);padding:12px 22px;
  border-radius:var(--r-sm);font-size:.88rem;font-weight:600;z-index:100;
  box-shadow:var(--shadow-lg);opacity:0;transition:all .3s cubic-bezier(.4,0,.2,1);
  pointer-events:none;max-width:90vw}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

.modal{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:200;
  display:none;align-items:center;justify-content:center;padding:20px;
  backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px)}
.modal.show{display:flex}
.modal-content{background:var(--surface);border-radius:20px;padding:32px;
  max-width:520px;width:100%;box-shadow:var(--shadow-lg);
  animation:modalIn .4s cubic-bezier(.4,0,.2,1);max-height:90vh;overflow-y:auto;
  border:1px solid var(--border)}
@keyframes modalIn{from{opacity:0;transform:scale(.9)}to{opacity:1;transform:scale(1)}}
.modal-content h2{font-size:1.4rem;font-weight:800;margin-bottom:8px;
  letter-spacing:-.02em;background:linear-gradient(135deg,var(--teal),var(--violet));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.modal-content p{font-size:.9rem;color:var(--muted);margin-bottom:16px;line-height:1.6}
.modal-content ol{padding-left:20px;margin-bottom:20px;font-size:.88rem;
  line-height:1.8;color:var(--text)}
.modal-content li{margin-bottom:8px}
.modal-actions{display:flex;gap:8px;justify-content:flex-end}

#confetti{position:fixed;inset:0;pointer-events:none;z-index:150;display:none}
#confetti.show{display:block}

.session-footer{position:fixed;bottom:0;left:0;right:0;
  background:color-mix(in srgb,var(--surface) 95%,transparent);
  backdrop-filter:blur(12px);border-top:1px solid var(--border);padding:8px 16px;
  z-index:35;display:flex;justify-content:space-between;align-items:center;
  font-size:.72rem;color:var(--muted);gap:12px;flex-wrap:wrap}
.session-stat{display:flex;gap:16px;flex-wrap:wrap}
.session-stat span{display:flex;align-items:center;gap:4px}
.session-stat strong{color:var(--teal);font-weight:700}

/* GAIA CHAT */
.chat-container{display:flex;flex-direction:column;height:calc(100vh - 280px);
  min-height:400px;max-height:600px;background:color-mix(in srgb,var(--surface) 90%,transparent);
  backdrop-filter:blur(12px);border:1px solid var(--border);border-radius:20px;
  overflow:hidden;box-shadow:var(--shadow)}
.chat-header{padding:16px 20px;background:linear-gradient(135deg,var(--teal),var(--violet));
  color:#fff;display:flex;align-items:center;gap:12px}
.chat-avatar{width:40px;height:40px;border-radius:12px;
  background:conic-gradient(from 0deg,#14b8a6,#06b6d4,#8b5cf6,#f59e0b,#14b8a6);
  display:flex;align-items:center;justify-content:center;flex-shrink:0;
  box-shadow:0 0 20px rgba(139,92,246,.5);animation:spinGlow 6s linear infinite}
.chat-avatar-inner{width:34px;height:34px;border-radius:10px;
  background:var(--surface);display:flex;align-items:center;justify-content:center;
  font-size:1.1rem}
.chat-header-text{flex:1}
.chat-header-text h3{font-size:.95rem;font-weight:800;letter-spacing:-.01em}
.chat-header-text p{font-size:.72rem;opacity:.85;display:flex;align-items:center;gap:4px}
.chat-header-text p .live{width:5px;height:5px;border-radius:50%;background:#86efac;
  box-shadow:0 0 8px #86efac;animation:pulse 1.5s infinite}
.chat-body{flex:1;overflow-y:auto;padding:20px;display:flex;flex-direction:column;
  gap:14px;scroll-behavior:smooth}
.chat-body::-webkit-scrollbar{width:6px}
.chat-body::-webkit-scrollbar-thumb{background:var(--border);border-radius:3px}
.msg{display:flex;gap:10px;max-width:85%;animation:msgIn .35s ease}
@keyframes msgIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
.msg.user{align-self:flex-end;flex-direction:row-reverse}
.msg-bubble{padding:12px 16px;border-radius:16px;font-size:.88rem;line-height:1.5;
  box-shadow:var(--shadow-sm)}
.msg.gaia .msg-bubble{background:var(--surface-2);color:var(--text);
  border-bottom-left-radius:4px}
.msg.user .msg-bubble{background:linear-gradient(135deg,var(--teal),var(--teal-light));
  color:#fff;border-bottom-right-radius:4px}
.msg-avatar{width:32px;height:32px;border-radius:10px;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;font-size:.9rem}
.msg.gaia .msg-avatar{background:linear-gradient(135deg,var(--teal),var(--violet));
  color:#fff}
.msg.user .msg-avatar{background:var(--surface-2);color:var(--teal)}
.msg-bubble strong{color:inherit;font-weight:700}
.msg-bubble code{background:rgba(0,0,0,.1);padding:1px 6px;border-radius:4px;
  font-family:'SF Mono',Menlo,monospace;font-size:.85em}
.typing{display:flex;gap:4px;padding:14px 18px;background:var(--surface-2);
  border-radius:16px;width:fit-content}
.typing span{width:7px;height:7px;border-radius:50%;background:var(--muted);
  animation:typingBounce 1.4s infinite}
.typing span:nth-child(2){animation-delay:.2s}
.typing span:nth-child(3){animation-delay:.4s}
@keyframes typingBounce{0%,60%,100%{transform:translateY(0);opacity:.5}
  30%{transform:translateY(-8px);opacity:1}}
.chat-suggestions{padding:0 20px 12px;display:flex;gap:6px;flex-wrap:wrap;
  overflow-x:auto;scrollbar-width:none}
.chat-suggestions::-webkit-scrollbar{display:none}
.chat-suggest{background:var(--surface-2);border:1px solid var(--border);
  padding:6px 12px;border-radius:999px;font-size:.78rem;font-weight:600;
  color:var(--teal);cursor:pointer;transition:all var(--transition);white-space:nowrap}
.chat-suggest:hover{background:var(--teal);color:#fff;border-color:var(--teal)}
.chat-input-wrap{padding:12px 16px;background:var(--surface);
  border-top:1px solid var(--border);display:flex;gap:8px;align-items:center}
.chat-input{flex:1;padding:12px 16px;border:1.5px solid var(--border);
  border-radius:999px;font:inherit;font-size:.9rem;background:var(--surface-2);
  color:var(--text);transition:all var(--transition)}
.chat-input:focus{outline:none;border-color:var(--teal);
  box-shadow:0 0 0 3px color-mix(in srgb,var(--teal) 15%,transparent)}
.chat-send{width:44px;height:44px;border-radius:50%;
  background:linear-gradient(135deg,var(--teal),var(--teal-light));color:#fff;
  display:flex;align-items:center;justify-content:center;flex-shrink:0;
  transition:all var(--transition);box-shadow:0 4px 12px rgba(20,184,166,.3)}
.chat-send:hover{transform:scale(1.08);box-shadow:0 6px 20px rgba(20,184,166,.5)}
.chat-send:disabled{opacity:.4;cursor:not-allowed;transform:none}
.chat-send svg{width:20px;height:20px;fill:currentColor}
.chat-mic{width:44px;height:44px;border-radius:50%;background:var(--surface-2);
  border:1px solid var(--border);color:var(--teal);display:flex;align-items:center;
  justify-content:center;flex-shrink:0;transition:all var(--transition)}
.chat-mic:hover{background:var(--teal);color:#fff}
.chat-mic.recording{background:var(--danger);color:#fff;animation:pulse 1s infinite}
.chat-mic svg{width:20px;height:20px;fill:currentColor}

/* GAIA neural panel */
.neural-panel{background:linear-gradient(135deg,var(--surface),var(--surface-2));
  border:1px solid var(--border);border-radius:var(--r);padding:16px;
  margin-bottom:16px;position:relative;overflow:hidden}
.neural-panel::before{content:'';position:absolute;top:-50%;right:-50%;width:200%;
  height:200%;background:conic-gradient(from 0deg,transparent,rgba(139,92,246,.05),
  transparent,rgba(20,184,166,.05),transparent);animation:spin 8s linear infinite;
  pointer-events:none}
@keyframes spin{to{transform:rotate(360deg)}}
.neural-panel>*{position:relative;z-index:1}
.neural-header{display:flex;align-items:center;justify-content:space-between;
  margin-bottom:12px;flex-wrap:wrap;gap:8px}
.neural-badge{padding:4px 10px;border-radius:999px;font-size:.68rem;font-weight:700;
  background:linear-gradient(135deg,var(--violet),var(--cyan));color:#fff;
  letter-spacing:.05em;text-transform:uppercase;
  box-shadow:0 0 12px rgba(139,92,246,.4)}
.neural-stat{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));
  gap:12px;margin-top:12px}
.neural-stat-item{background:var(--surface);border:1px solid var(--border);
  border-radius:var(--r-sm);padding:10px;text-align:center}
.neural-stat-item .v{font-size:1.1rem;font-weight:800;color:var(--teal);
  font-variant-numeric:tabular-nums}
.neural-stat-item .l{font-size:.68rem;color:var(--muted);text-transform:uppercase;
  letter-spacing:.04em;margin-top:2px}
.neural-spark{height:40px;margin-top:12px;position:relative}
.neural-spark svg{width:100%;height:100%}

/* Command palette */
.palette-modal{position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:300;
  display:none;align-items:flex-start;justify-content:center;padding:80px 20px 20px;
  backdrop-filter:blur(8px)}
.palette-modal.show{display:flex}
.palette{background:var(--surface);border-radius:16px;max-width:560px;width:100%;
  box-shadow:0 24px 64px rgba(0,0,0,.4);border:1px solid var(--border);
  animation:paletteIn .3s cubic-bezier(.4,0,.2,1);overflow:hidden}
@keyframes paletteIn{from{opacity:0;transform:scale(.95) translateY(-20px)}
  to{opacity:1;transform:scale(1) translateY(0)}}
.palette-input{width:100%;padding:18px 20px;border:none;background:transparent;
  font:inherit;font-size:1rem;color:var(--text);border-bottom:1px solid var(--border)}
.palette-input:focus{outline:none}
.palette-list{max-height:360px;overflow-y:auto;padding:8px}
.palette-item{padding:10px 14px;border-radius:8px;display:flex;align-items:center;
  gap:10px;cursor:pointer;transition:background var(--transition);font-size:.88rem}
.palette-item:hover,.palette-item.selected{background:var(--surface-2)}
.palette-item .icon{width:24px;height:24px;display:flex;align-items:center;
  justify-content:center;color:var(--teal)}
.palette-item .label{flex:1}
.palette-item .kbd{font-size:.7rem;color:var(--muted);padding:2px 6px;
  background:var(--surface-2);border-radius:4px;border:1px solid var(--border)}
.palette-footer{padding:10px 16px;border-top:1px solid var(--border);
  font-size:.72rem;color:var(--muted);display:flex;gap:16px}
.palette-footer kbd{padding:1px 6px;background:var(--surface-2);
  border-radius:4px;border:1px solid var(--border);font-size:.7rem}

/* Heatmap */
.heatmap{display:grid;grid-template-columns:repeat(auto-fill,minmax(14px,1fr));
  gap:3px;max-width:100%;margin-top:12px}
.heatmap-cell{aspect-ratio:1;border-radius:3px;background:var(--surface-2);
  transition:all var(--transition);position:relative;cursor:pointer}
.heatmap-cell[data-lvl="1"]{background:#a7f3d0}
.heatmap-cell[data-lvl="2"]{background:#6ee7b7}
.heatmap-cell[data-lvl="3"]{background:#34d399}
.heatmap-cell[data-lvl="4"]{background:#10b981}
.heatmap-cell[data-lvl="5"]{background:#059669}
.heatmap-cell:hover{transform:scale(1.3);z-index:2;box-shadow:0 0 8px var(--teal)}
[data-theme="dark"] .heatmap-cell[data-lvl="0"]{background:#1e2f28}

/* Challenges */
.challenge-card{background:linear-gradient(135deg,var(--surface),var(--surface-2));
  border:1px solid var(--border);border-radius:var(--r);padding:16px;
  margin-bottom:12px;display:flex;gap:14px;align-items:flex-start;
  transition:all var(--transition);position:relative;overflow:hidden}
.challenge-card:hover{transform:translateY(-2px);box-shadow:var(--shadow)}
.challenge-card.done{opacity:.65;background:linear-gradient(135deg,#d1fae5,#a7f3d0)}
[data-theme="dark"] .challenge-card.done{background:linear-gradient(135deg,#0d3a2a,#134e4a)}
.challenge-icon{width:44px;height:44px;border-radius:12px;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;font-size:1.4rem;
  background:linear-gradient(135deg,var(--amber),#fbbf24);color:#78350f}
.challenge-body{flex:1}
.challenge-title{font-weight:700;font-size:.92rem;margin-bottom:2px}
.challenge-desc{font-size:.8rem;color:var(--muted);margin-bottom:8px}
.challenge-progress{height:6px;background:var(--surface-2);border-radius:3px;
  overflow:hidden}
.challenge-progress-fill{height:100%;background:linear-gradient(90deg,var(--amber),#fbbf24);
  border-radius:3px;transition:width .5s ease}
.challenge-xp{font-size:.72rem;font-weight:700;color:var(--violet);
  background:rgba(139,92,246,.1);padding:2px 8px;border-radius:999px}

/* Utility */
.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.mt-2{margin-top:12px}.mt-3{margin-top:20px}.mb-2{margin-bottom:12px}
.text-muted{color:var(--muted)}
.tabular{font-variant-numeric:tabular-nums}
pre{background:var(--surface-2);padding:16px;border-radius:10px;font-size:.83rem;
  overflow-x:auto;font-family:'SF Mono',Menlo,monospace;color:var(--teal)}

@media print{
  header,nav,.session-footer,#toast,.modal,.palette-modal,#confetti,.hero-actions,
  .rec-filters,.sim-result,button,#particles,#cursor-glow,.chat-container,
  .neural-panel{display:none!important}
  body{background:#fff;color:#000}
  body::before{display:none}
  .card{border:1px solid #ddd;box-shadow:none;page-break-inside:avoid;
    background:#fff}
  main{padding:0}
  .tab-panel{display:block!important}
}
@media (max-width:640px){
  main{padding:16px 12px 120px}
  .hero{padding:36px 20px 32px;border-radius:20px}
  .hero h1{font-size:1.7rem}
  .hero p{font-size:.92rem}
  .hero .btn{padding:11px 18px;font-size:.85rem}
  .metric-value{font-size:1.3rem}
  .score-value{font-size:2.6rem}
  .sim-result{grid-template-columns:1fr}
  .donut-wrap{flex-direction:column;align-items:flex-start}
  .session-footer{font-size:.68rem;padding:6px 12px}
  .chat-container{height:calc(100vh - 320px)}
  .xp-widget{min-width:80px}
}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation:none!important;transition:none!important;
    scroll-behavior:auto!important}
  #particles{display:none}
}
</style>
</head>
<body>

<svg width="0" height="0" style="position:absolute">
<defs><linearGradient id="brandGrad" x1="0%" y1="0%" x2="100%" y2="100%">
<stop offset="0%" stop-color="#14b8a6"/><stop offset="100%" stop-color="#8b5cf6"/>
</linearGradient></defs></svg>

<canvas id="particles"></canvas>
<div id="cursor-glow"></div>

<header>
  <div class="brand">
    <div class="brand-mark">
      <svg viewBox="0 0 24 24"><path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75C7 8 17 8 17 8z"/></svg>
    </div>
    <div>
      <div class="brand-name">EcoGenesis AI</div>
      <div class="brand-tag"><span class="live"></span><span id="agentStatus">GAIA online</span></div>
    </div>
  </div>
  <div class="xp-widget" title="Eco XP">
    <div class="xp-label"><span>LVL <strong id="lvlNum">1</strong></span><span id="xpText">0/100</span></div>
    <div class="xp-track"><div class="xp-fill" id="xpFill" style="width:0%"></div></div>
  </div>
  <div class="header-actions">
    <button class="icon-btn" id="btnPalette" aria-label="Command palette" title="Command palette (Ctrl+K)">
      <svg viewBox="0 0 24 24"><path d="M20 5H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm-9 3h2v2h-2V8zm0 4h2v2h-2v-2zm-4-4h2v2H7V8zm0 4h2v2H7v-2zm-2 4h12v1H5v-1z"/></svg>
    </button>
    <button class="icon-btn" id="btnSound" aria-label="Toggle sound" title="Sound effects">
      <svg viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>
    </button>
    <button class="icon-btn lang" id="btnLang" aria-label="Language">EN</button>
    <button class="icon-btn" id="btnDark" aria-label="Dark mode">
      <svg viewBox="0 0 24 24"><path d="M12 3a9 9 0 109 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 01-4.4 2.26 5.403 5.403 0 01-3.14-9.8c-.44-.06-.9-.1-1.36-.1z"/></svg>
    </button>
    <button class="icon-btn" id="btnShare" aria-label="Share">
      <svg viewBox="0 0 24 24"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92z"/></svg>
    </button>
    <button class="icon-btn" id="btnReset" aria-label="Reset">
      <svg viewBox="0 0 24 24"><path d="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/></svg>
    </button>
  </div>
</header>

