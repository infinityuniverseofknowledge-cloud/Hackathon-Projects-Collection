      <button class="goal-template" onclick="applyGoalTemplate('energy15')">🔌 -15% electricity</button>
      <button class="goal-template" onclick="applyGoalTemplate('water20')">💧 -20% water</button>
      <button class="goal-template" onclick="applyGoalTemplate('recycle50')">♻️ 50% diversion</button>
      <button class="goal-template" onclick="applyGoalTemplate('carHalf')">🚗 -50% car trips</button>
    </div>
    <div class="card-title">Or create custom</div>
    <div class="grid grid-2">
      <div class="form-field"><label for="goalTitle">Goal title *</label>
        <input type="text" id="goalTitle" maxlength="120" placeholder="Reduce electricity by 15%"></div>
      <div class="form-field"><label for="goalTarget">Target value</label>
        <input type="number" id="goalTarget" min="0" step="0.01" placeholder="380"></div>
      <div class="form-field"><label for="goalUnit">Unit</label>
        <input type="text" id="goalUnit" maxlength="20" value="kWh"></div>
      <div class="form-field"><label for="goalDeadline">Deadline</label>
        <input type="date" id="goalDeadline"></div>
    </div>
    <div class="row mt-3">
      <button class="btn btn-primary" onclick="addGoal()">+ Add Goal</button>
      <button class="btn btn-secondary" onclick="exportCSV()">Export CSV</button>
      <button class="btn btn-secondary" onclick="exportJSON()">Export JSON</button>
      <button class="btn btn-ghost" onclick="importBackup()">📥 Import</button>
      <button class="btn btn-ghost" onclick="window.print()">🖨 Print</button>
    </div>
    <input type="file" id="importFile" accept=".json" style="display:none">
  </div>
  <div id="goalsList"></div>
</section>

<section id="compare" class="tab-panel">
