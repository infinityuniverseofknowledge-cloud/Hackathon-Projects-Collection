<main>

<section id="overview" class="tab-panel active">
  <div class="hero">
    <div class="hero-eyebrow"><span class="dot"></span> GAIA Edition · Offline · Zero tracking</div>
    <h1>Turn awareness into <em>measurable</em> impact.</h1>
    <p>Assess your household footprint, chat with GAIA — your on-device AI sustainability agent — and track real goals. Everything stays in your browser.</p>
    <div class="hero-actions">
      <button class="btn btn-primary" onclick="switchTab('assess')">Start Assessment →</button>
      <button class="btn btn-ghost" onclick="switchTab('gaia')">Chat with GAIA ✦</button>
    </div>
  </div>
  <div class="trust-strip">
    <div class="trust-item">
      <div class="trust-icon"><svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg></div>
      <div><h4>100% offline</h4><p>No network. No accounts. No telemetry.</p></div>
    </div>
    <div class="trust-item">
      <div class="trust-icon"><svg viewBox="0 0 24 24"><path d="M12 2l2.4 7.4H22l-6 4.5 2.3 7.1-6.3-4.5-6.3 4.5 2.3-7.1-6-4.5h7.6z"/></svg></div>
      <div><h4>GAIA agent</h4><p>Neural intent classifier — runs on-device.</p></div>
    </div>
    <div class="trust-item">
      <div class="trust-icon"><svg viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2z"/></svg></div>
      <div><h4>MLP predictor</h4><p>Tiny neural net trained on your data.</p></div>
    </div>
  </div>
  <div class="card">
    <div class="card-title">Why it matters</div>
    <div class="grid grid-3">
      <div><div style="font-size:1.8rem;font-weight:800;background:linear-gradient(135deg,var(--teal),var(--violet));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;letter-spacing:-.02em">~70%</div>
      <p class="text-muted" style="font-size:.82rem;margin-top:4px">of global GHG emissions come from household consumption.</p></div>
      <div><div style="font-size:1.8rem;font-weight:800;background:linear-gradient(135deg,var(--teal),var(--violet));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;letter-spacing:-.02em">5-15%</div>
      <p class="text-muted" style="font-size:.82rem;margin-top:4px">typical reduction unlocked by regular tracking.</p></div>
      <div><div style="font-size:1.8rem;font-weight:800;background:linear-gradient(135deg,var(--teal),var(--violet));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;letter-spacing:-.02em">60s</div>
      <p class="text-muted" style="font-size:.82rem;margin-top:4px">to complete your first assessment.</p></div>
    </div>
  </div>
</section>

<section id="assess" class="tab-panel">
  <h2 style="font-size:1.4rem;font-weight:800;letter-spacing:-.02em;margin-bottom:6px">Environmental Assessment</h2>
  <p class="text-muted" style="font-size:.9rem;margin-bottom:20px">Enter monthly consumption. Leave fields blank if unknown.</p>
  <div class="alert alert-warn">
    <svg viewBox="0 0 24 24"><path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/></svg>
    <div><strong>Estimates only.</strong> Emission factors are demo values — not verified scientific constants.</div>
  </div>
  <div class="card">
    <div class="grid grid-2">
      <div class="form-field"><label for="inEnergy"><span class="field-icon"><svg viewBox="0 0 24 24"><path d="M7 2v11h3v9l7-12h-4l4-8z"/></svg></span>Electricity</label>
        <span class="hint">kWh per month</span>
        <input type="number" id="inEnergy" min="0" step="0.01" placeholder="450" inputmode="decimal"></div>
      <div class="form-field"><label for="inWater"><span class="field-icon"><svg viewBox="0 0 24 24"><path d="M12 2c-4 4-8 8-8 12a8 8 0 0016 0c0-4-4-8-8-12z"/></svg></span>Water</label>
        <span class="hint">liters per month</span>
        <input type="number" id="inWater" min="0" step="0.01" placeholder="12000" inputmode="decimal"></div>
      <div class="form-field"><label for="inWaste"><span class="field-icon"><svg viewBox="0 0 24 24"><path d="M3 6h18v2H3V6zm2 4h14v12H5V10z"/></svg></span>Total waste</label>
        <span class="hint">kg per month</span>
        <input type="number" id="inWaste" min="0" step="0.01" placeholder="60" inputmode="decimal"></div>
      <div class="form-field"><label for="inDiverted"><span class="field-icon"><svg viewBox="0 0 24 24"><path d="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46A7.93 7.93 0 0020 12c0-4.42-3.58-8-8-8z"/></svg></span>Waste diverted</label>
        <span class="hint">kg recycled or composted</span>
        <input type="number" id="inDiverted" min="0" step="0.01" placeholder="15" inputmode="decimal"></div>
      <div class="form-field"><label for="inTransport"><span class="field-icon"><svg viewBox="0 0 24 24"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99z"/></svg></span>Transport</label>
        <span class="hint">km per month</span>
        <input type="number" id="inTransport" min="0" step="0.01" placeholder="800" inputmode="decimal"></div>
      <div class="form-field"><label for="inHousehold"><span class="field-icon"><svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3z"/></svg></span>Household size *</label>
        <span class="hint">Number of residents</span>
        <input type="number" id="inHousehold" min="1" max="20" step="1" value="1" inputmode="numeric"></div>
    </div>
    <div id="errors" style="display:none;color:var(--danger);font-size:.85rem;font-weight:600;margin-top:14px;padding:12px;background:var(--danger-soft);border-radius:8px"></div>
    <div class="row mt-3">
      <button class="btn btn-primary" onclick="calculate()">
        <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
        Calculate Assessment</button>
      <button class="btn btn-secondary" onclick="loadDemo()">Load Demo</button>
      <button class="btn btn-ghost" onclick="clearForm()">Clear</button>
    </div>
  </div>
</section>

