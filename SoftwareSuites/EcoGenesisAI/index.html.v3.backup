  <div class="session-stat">
    <span>🌍 <strong id="globalCo2">0</strong> t CO₂e since load</span>
    <span>⏱ <strong id="sessionTime">0s</strong></span>
    <span>📊 <strong id="sessionAssess">0</strong> assessments</span>
  </div>
  <span>v4.0 GAIA · <span style="opacity:.7">Ctrl+K</span></span>
</footer>

<div id="toast" role="status" aria-live="polite"></div>
<canvas id="confetti"></canvas>

<div class="modal" id="onboarding">
  <div class="modal-content">
    <h2>Welcome to EcoGenesis AI 🌱</h2>
    <p>A private, offline sustainability platform with a proprietary AI agent — GAIA.</p>
    <ol>
      <li><strong>Measure</strong> — enter your monthly consumption</li>
      <li><strong>Chat</strong> — GAIA answers questions about your data</li>
      <li><strong>Improve</strong> — create goals, track progress, get predictions</li>
    </ol>
    <p style="font-size:.82rem">🔒 All data stays in your browser. No accounts. No tracking. No network.</p>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeOnboarding()">Skip</button>
      <button class="btn btn-primary" onclick="startOnboarding()">Get started →</button>
    </div>
  </div>
</div>

<div class="palette-modal" id="paletteModal">
  <div class="palette">
    <input type="text" class="palette-input" id="paletteInput" placeholder="Type a command..." autocomplete="off">
    <div class="palette-list" id="paletteList"></div>
    <div class="palette-footer">
      <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
      <span><kbd>Enter</kbd> select</span>
      <span><kbd>Esc</kbd> close</span>
    </div>
  </div>
</div>

<script>
(function(){
"use strict";

// ============================================================================
// CONFIG
// ============================================================================
var FACTORS = {
  electricity: { rate: 0.45, label: "Electricity", color: "#0f766e" },
  water:       { rate: 0.0003, label: "Water", color: "#0891b2" },
  waste:       { rate: 0.5, label: "Waste", color: "#f59e0b" },
  transport:   { rate: 0.192, label: "Transport", color: "#8b5cf6" }
};
var BENCHMARKS = { energy_pp: 150, water_pp: 3000, waste_pp: 20, transport_km: 500 };
var STORAGE_KEY = "ecogenesis_v4";
var ACHIEVEMENTS_KEY = "ecogenesis_achievements_v4";
var CHAT_KEY = "ecogenesis_chat_v4";
var XP_KEY = "ecogenesis_xp_v4";
var THEME_KEY = "ecogenesis_theme";
var LANG_KEY = "ecogenesis_lang";
var SOUND_KEY = "ecogenesis_sound";

var state = {
  inputs: null, emissions: null, score: null,
  recommendations: [], goals: [], isDemo: false, history: []
};
var achievements = [];
var recFilter = "all";
var sessionStart = Date.now();
var sessionAssessments = 0;
var xp = { level: 1, points: 0, total: 0 };
var soundOn = true;
var chatHistory = [];
var challenges = [];
var lang = "en";

// ============================================================================
// HELPERS
// ============================================================================
function $(id){ return document.getElementById(id); }
function esc(s){ return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;")
  .replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;"); }
function fmt(n, d){ if (n === null || n === undefined || !isFinite(n)) return "—";
  d = (typeof d === "number") ? d : 1;
  return Number(n).toLocaleString("en-US", {minimumFractionDigits:d, maximumFractionDigits:d}); }
function fmtInt(n){ return fmt(n, 0); }
function clamp(v, lo, hi){ return Math.max(lo, Math.min(hi, v)); }
function todayISO(){ return new Date().toISOString().slice(0, 10); }

function toast(msg, type){
  var el = $("toast");
  el.textContent = msg;
  el.style.background = type === "warn" ? "#92400e" : type === "danger" ? "#991b1b" : "";
  el.classList.add("show");
  clearTimeout(toast._t);
  toast._t = setTimeout(function(){ el.classList.remove("show"); }, 3000);
}

function playSound(freq, dur){
  if (!soundOn) return;
  try {
    var ctx = playSound._ctx || (playSound._ctx = new (window.AudioContext || window.webkitAudioContext)());
    var o = ctx.createOscillator();
    var g = ctx.createGain();
    o.frequency.value = freq || 660;
    o.type = "sine";
    g.gain.setValueAtTime(0.06, ctx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + (dur || 0.15));
    o.connect(g);
    g.connect(ctx.destination);
    o.start();
    o.stop(ctx.currentTime + (dur || 0.15));
  } catch(e){}
}

function launchConfetti(){
  var canvas = $("confetti");
  canvas.classList.add("show");
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
  var ctx = canvas.getContext("2d");
  var colors = ["#0f766e","#14b8a6","#86efac","#f59e0b","#fbbf24","#8b5cf6","#06b6d4"];
  var particles = [];
  for (var i = 0; i < 120; i++){
    particles.push({ x: Math.random() * canvas.width, y: -20,
      vx: (Math.random() - 0.5) * 6, vy: Math.random() * 2 + 2,
      size: Math.random() * 8 + 4, color: colors[Math.floor(Math.random() * colors.length)],
      rot: Math.random() * Math.PI * 2, vr: (Math.random() - 0.5) * 0.3 });
  }
  var start = Date.now();
  function animate(){
    var elapsed = Date.now() - start;
    if (elapsed > 2500){ ctx.clearRect(0, 0, canvas.width, canvas.height);
      canvas.classList.remove("show"); return; }
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    particles.forEach(function(p){
      p.x += p.vx; p.y += p.vy; p.vy += 0.15; p.rot += p.vr;
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.rot);
      ctx.fillStyle = p.color;
      ctx.globalAlpha = 1 - (elapsed / 2500);
      ctx.fillRect(-p.size/2, -p.size/2, p.size, p.size * 0.6);
      ctx.restore();
    });
    requestAnimationFrame(animate);
  }
  animate();
}

// ============================================================================
// PARTICLE FIELD
// ============================================================================
function initParticles(){
  var canvas = $("particles");
  if (!canvas) return;
  var ctx = canvas.getContext("2d");
  var particles = [];
  var mouse = { x: -1000, y: -1000 };
  function resize(){
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  }
  resize();
  window.addEventListener("resize", resize);
  window.addEventListener("mousemove", function(e){ mouse.x = e.clientX; mouse.y = e.clientY; });
  var count = Math.min(60, Math.floor(window.innerWidth / 20));
  for (var i = 0; i < count; i++){
    particles.push({
      x: Math.random() * canvas.width,
      y: Math.random() * canvas.height,
      vx: (Math.random() - 0.5) * 0.4,
      vy: (Math.random() - 0.5) * 0.4,
      r: Math.random() * 1.5 + 0.5
    });
  }
  function animate(){
    var isDark = document.documentElement.getAttribute("data-theme") === "dark";
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = isDark ? "rgba(45,212,191,.6)" : "rgba(15,118,110,.4)";
    for (var i = 0; i < particles.length; i++){
      var p = particles[i];
      p.x += p.vx; p.y += p.vy;
      if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
      if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
      var dx = mouse.x - p.x;
      var dy = mouse.y - p.y;
      var dist = Math.sqrt(dx * dx + dy * dy);
      if (dist < 150){
        p.vx += dx / dist * 0.02;
        p.vy += dy / dist * 0.02;
      }
      p.vx *= 0.99; p.vy *= 0.99;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fill();
      for (var j = i + 1; j < particles.length; j++){
        var q = particles[j];
        var ddx = p.x - q.x;
        var ddy = p.y - q.y;
        var d2 = ddx * ddx + ddy * ddy;
        if (d2 < 10000){
          ctx.strokeStyle = isDark ? "rgba(45,212,191," + (0.15 * (1 - d2 / 10000)) + ")"
            : "rgba(15,118,110," + (0.1 * (1 - d2 / 10000)) + ")";
          ctx.lineWidth = 0.5;
          ctx.beginPath();
          ctx.moveTo(p.x, p.y);
          ctx.lineTo(q.x, q.y);
          ctx.stroke();
        }
      }
    }
    requestAnimationFrame(animate);
  }
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches){
    animate();
  } else {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
  }
}

// ============================================================================
// CURSOR GLOW
// ============================================================================
function initCursorGlow(){
  var glow = $("cursor-glow");
  if (!glow) return;
  document.addEventListener("mousemove", function(e){
    glow.style.left = e.clientX + "px";
    glow.style.top = e.clientY + "px";
  });
}

// ============================================================================
// GAIA NEURAL CLASSIFIER
// ============================================================================
var GAIA_Embed = {
  dim: 64,
  hash: function(str){
    var h = 5381;
    for (var i = 0; i < str.length; i++){
      h = ((h << 5) + h) + str.charCodeAt(i);
      h = h & 0x7fffffff;
    }
    return h;
  },
  embed: function(text){
    var words = (text || "").toLowerCase().match(/[a-záàâãéèêíïóôõöúçñ0-9]+/gi) || [];
    var vec = new Float32Array(this.dim);
    if (!words.length) return vec;
    words.forEach(function(w){
      var h = GAIA_Embed.hash(w);
      for (var i = 0; i < GAIA_Embed.dim; i++){
        vec[i] += Math.sin(h * (i + 1) * 0.0001) * Math.cos(h * (i + 1) * 0.00001);
      }
    });
    var norm = 0;
    for (var i = 0; i < vec.length; i++) norm += vec[i] * vec[i];
    norm = Math.sqrt(norm) || 1;
    for (var j = 0; j < vec.length; j++) vec[j] /= norm;
    return vec;
  },
  cosine: function(a, b){
    var dot = 0;
    for (var i = 0; i < a.length; i++) dot += a[i] * b[i];
    return dot;
  }
};

var GAIA_Intents = [
  { id: "greet", patterns: ["hello","hi","hey","oi","olá","e aí","start","begin"] },
  { id: "score", patterns: ["score","rating","how am i doing","my score","pontuação","como estou"] },
  { id: "energy", patterns: ["electricity","energy","kwh","power","energia","eletricidade"] },
  { id: "water", patterns: ["water","liters","água","litros","hidrômetro"] },
  { id: "waste", patterns: ["waste","trash","recycle","lixo","resíduo","reciclar","compost"] },
  { id: "transport", patterns: ["car","transport","drive","km","carro","transporte","drive"] },
  { id: "trend", patterns: ["trend","progress","history","tendência","histórico","evolução"] },
  { id: "predict", patterns: ["predict","next month","forecast","prever","próximo mês","futuro"] },
  { id: "tip", patterns: ["tip","advice","suggest","dica","conselho","recomendação"] },
  { id: "why", patterns: ["why","reason","explain","por que","porque","explicar"] },
  { id: "help", patterns: ["what can you do","commands","help","ajuda","o que você faz"] },
  { id: "compare", patterns: ["compare","vs","versus","benchmark","comparar"] },
  { id: "thanks", patterns: ["thanks","thank you","obrigado","obrigada","valeu"] },
  { id: "reset", patterns: ["reset","clear","limpar","apagar"] }
];

var GAIA = {
  classify: function(text){
    var inputVec = GAIA_Embed.embed(text);
    var lower = (text || "").toLowerCase();
    var best = { id: "unknown", score: 0 };
    GAIA_Intents.forEach(function(intent){
      var maxSim = 0;
      intent.patterns.forEach(function(p){
        var sim = GAIA_Embed.cosine(inputVec, GAIA_Embed.embed(p));
        if (sim > maxSim) maxSim = sim;
        if (lower.indexOf(p) >= 0) maxSim += 0.35;
      });
      if (maxSim > best.score) best = { id: intent.id, score: maxSim };
    });
    return best.score > 0.25 ? best.id : "unknown";
  },

  respond: function(text){
    var intent = this.classify(text);
    var hasData = state.inputs && state.emissions;
    var em = state.emissions;
    var sc = state.score;

    if (intent === "greet"){
      return hasData ?
        "Hello! I've analyzed your last assessment (score: **" + sc.score + "/100**). Ask me about your energy, water, waste, transport, trends, or predictions." :
        "Hello! I'm GAIA, your on-device sustainability agent. To get started, run an assessment — or ask me anything and I'll guide you.";
    }
    if (intent === "thanks"){
      return "You're welcome! Small consistent changes beat big occasional ones. Keep going 🌱";
    }
    if (intent === "help"){
      return "I can:\n• Explain your **score** and each category\n• Show **trends** from your history\n• **Predict** next month's emissions\n• Give **recommendations** tailored to your data\n• **Compare** you to benchmarks\n\nTry: \"what's my score?\", \"predict next month\", \"how's my water?\", \"any tips?\"";
    }
    if (!hasData){
      if (intent === "score" || intent === "energy" || intent === "water" ||
          intent === "waste" || intent === "transport" || intent === "predict" ||
          intent === "trend" || intent === "compare"){
        return "I need data first! Go to the **Assess** tab and enter your monthly consumption — or click **Load Demo** to try with sample values.";
      }
      if (intent === "tip"){
        return "Without data I can only give general advice: **track your bills**, start with **LED lighting**, **fix leaks**, and separate waste. But run an assessment and I'll be far more specific.";
      }
    }
    if (intent === "score"){
      var badge = sc.score >= 70 ? "Sustainable 🌱" : sc.score >= 40 ? "Improving 📈" : "Needs work ⚠️";
      return "Your score is **" + sc.score + "/100** (" + badge + ").\n\n" +
        "Monthly emissions: **" + fmt(em.total, 1) + " kg CO₂e**.\n" +
        "Biggest contributor: **" + biggestSource(em.by_source) + "**.";
    }
    if (intent === "energy"){
      var kwh = state.inputs.electricity_kwh;
      if (kwh === null) return "You haven't entered electricity data yet. Add it in the Assess tab.";
      var pp = kwh / (state.inputs.household_size || 1);
      var kg = em.by_source.electricity || 0;
      var ratio = (pp / BENCHMARKS.energy_pp).toFixed(1);
      return "⚡ **Electricity**: " + fmt(kwh) + " kWh/month → **" + fmt(kg, 1) + " kg CO₂e**\n\n" +
        "Per person: **" + fmt(pp, 0) + " kWh** (" + (pp > BENCHMARKS.energy_pp ? ratio + "× above" : "below") + " the 150 kWh benchmark).\n\n" +
        (pp > 200 ? "Consider LED lighting and efficient appliances." : "You're doing well — keep it up!");
    }
    if (intent === "water"){
      var w = state.inputs.water_liters;
      if (w === null) return "You haven't entered water data yet.";
      var wpp = w / (state.inputs.household_size || 1);
      var wkg = em.by_source.water || 0;
      var wr = (wpp / BENCHMARKS.water_pp).toFixed(1);
      return "💧 **Water**: " + fmt(w) + " L/month → **" + fmt(wkg, 2) + " kg CO₂e**\n\n" +
        "Per person: **" + fmt(wpp, 0) + " L** (" + (wpp > BENCHMARKS.water_pp ? wr + "× above" : "below") + " the 3000 L benchmark).\n\n" +
        (wpp > 4000 ? "Check for leaks — a dripping faucet wastes 20,000+ L/year." : "Your water use looks reasonable.");
    }
    if (intent === "waste"){
      var waste = state.inputs.waste_kg;
      if (!waste) return "You haven't entered waste data yet.";
      var div = ((state.inputs.waste_diverted_kg || 0) / waste * 100);
      var wkg2 = em.by_source.waste || 0;
      return "♻️ **Waste**: " + fmt(waste) + " kg/month → **" + fmt(wkg2, 1) + " kg CO₂e** (landfill)\n\n" +
        "Diversion rate: **" + div.toFixed(0) + "%** (target: 50%).\n\n" +
        (div < 30 ? "Prioritize waste separation — start with labeled bins." :
         div < 50 ? "Good progress! Home composting could push you past 50%." :
         "Excellent diversion — keep it up!");
    }
    if (intent === "transport"){
      var km = state.inputs.transport_km;
      if (km === null) return "You haven't entered transport data yet.";
      var tkg = em.by_source.transport || 0;
      return "🚗 **Transport**: " + fmt(km) + " km/month → **" + fmt(tkg, 1) + " kg CO₂e**\n\n" +
        (km > 500 ? "Above the 500 km benchmark. Try combining trips or public transit." : "Below the benchmark — nice work!");
    }
    if (intent === "trend"){
      if (state.history.length < 2) return "You need at least 2 assessments to see trends. Run another one!";
      var prev = state.history[state.history.length - 2].total;
      var cur = em.total;
      var delta = ((cur - prev) / prev * 100);
      var arrow = delta > 0 ? "📈" : delta < 0 ? "📉" : "➡️";
      return arrow + " **Trend**: " + (delta > 0 ? "up" : delta < 0 ? "down" : "flat") +
        " **" + Math.abs(delta).toFixed(1) + "%** vs previous assessment.\n\n" +
        "Previous: " + fmt(prev, 1) + " kg | Current: " + fmt(cur, 1) + " kg\n\n" +
        (delta < -5 ? "Great progress! Whatever you're doing is working." :
         delta > 5 ? "Time to revisit recommendations." : "You're stable — try a small new change.");
    }
    if (intent === "predict"){
      var pred = NeuralPredictor.predict(inputsToVec(state.inputs));
      var predictKg = pred * 1000;
      var confidence = Math.min(90, 30 + state.history.length * 15);
      return "🔮 **Prediction** for next month: **" + fmt(predictKg, 1) + " kg CO₂e**\n\n" +
        "Model confidence: **" + confidence + "%** (based on " + state.history.length + " historical points)\n\n" +
        "This is a statistical forecast from a tiny neural net trained on your data — not a guarantee.";
    }
    if (intent === "tip"){
      var recs = state.recommendations;
      if (!recs || !recs.length) return "Run an assessment first and I'll give specific recommendations.";
      var top = recs.filter(function(r){ return r.priority === "high"; })[0] || recs[0];
      return "💡 **Top tip**: " + top.title + "\n\n" + top.desc + "\n\n" +
        "Why: " + top.why + "\n\n" +
        "Difficulty: " + top.difficulty + " · Cost: " + top.cost;
    }
    if (intent === "why"){
      var biggest = biggestSource(em.by_source);
      var bigVal = em.by_source[biggest.toLowerCase()] || 0;
      return "**Why your emissions look like this:**\n\n" +
        "• " + biggest + " contributes " + fmt(bigVal, 1) + " kg CO₂e (" +
        fmt((bigVal / em.total * 100), 0) + "%)\n" +
        "• Score formula: energy×0.35 + water×0.30 + waste×0.35\n" +
        "• Benchmarks: 150 kWh/person, 3000 L/person\n\n" +
        "The Methodology tab has full formulas and limitations.";
    }
    if (intent === "compare"){
      var hs = state.inputs.household_size || 1;
      var lines = ["📊 **How you compare:**"];
      if (state.inputs.electricity_kwh !== null){
        var epp = state.inputs.electricity_kwh / hs;
        lines.push("⚡ Energy: " + fmt(epp, 0) + " vs 150 kWh target " + (epp > 150 ? "⚠️" : "✅"));
      }
      if (state.inputs.water_liters !== null){
        var wpp2 = state.inputs.water_liters / hs;
        lines.push("💧 Water: " + fmt(wpp2, 0) + " vs 3000 L target " + (wpp2 > 3000 ? "⚠️" : "✅"));
      }
      if (state.inputs.waste_kg > 0){
        var div2 = (state.inputs.waste_diverted_kg || 0) / state.inputs.waste_kg * 100;
        lines.push("♻️ Diversion: " + div2.toFixed(0) + "% vs 50% target " + (div2 >= 50 ? "✅" : "⚠️"));
      }
      return lines.join("\n");
    }
    if (intent === "reset"){
      return "To reset all data, click the reset icon (🔄) in the header. You'll be asked to confirm.";
    }
    return "I'm not sure I understood. Try asking:\n• \"what's my score?\"\n• \"predict next month\"\n• \"how's my energy?\"\n• \"any tips?\"\n• \"compare me\"";
  }
};

function biggestSource(bySource){
  var max = 0, name = "none";
  Object.keys(bySource).forEach(function(k){
    if (bySource[k] > max){ max = bySource[k]; name = k; }
  });
  return name.charAt(0).toUpperCase() + name.slice(1);
}

// ============================================================================
// NEURAL PREDICTOR (MLP 4→8→1 with backprop)
// ============================================================================
var NeuralPredictor = {
  W1: null, b1: null, W2: null, b2: null,
  trained: false,
  lossHistory: [],
  init: function(){
    var hidden = 8, input = 4;
    this.W1 = [];
    for (var i = 0; i < input; i++){
      this.W1.push([]);
      for (var j = 0; j < hidden; j++){
        this.W1[i].push((Math.random() - 0.5) * 0.8);
      }
    }
    this.b1 = new Array(hidden).fill(0);
    this.W2 = [];
    for (var k = 0; k < hidden; k++){
      this.W2.push((Math.random() - 0.5) * 0.8);
    }
    this.b2 = [0];
    this.lossHistory = [];
  },
  forward: function(x){
    var h = [];
    for (var j = 0; j < 8; j++){
      var z = this.b1[j];
      for (var i = 0; i < 4; i++) z += x[i] * this.W1[i][j];
      h.push(Math.tanh(z));
    }
    var out = this.b2[0];
    for (var k = 0; k < 8; k++) out += h[k] * this.W2[k];
    return { h: h, out: out };
  },
  train: function(history, epochs){
    if (!history || history.length < 2) return false;
    if (!this.W1) this.init();
    var data = [];
    for (var i = 0; i < history.length; i++){
      var p = history[i];
      var input = p.inputs ? inputsToVec(p.inputs) : [0.5, 0.5, 0.5, 0.5];
      var target = (p.total || 0) / 1000; // scale to 0..~1
      data.push({ x: input, y: target });
    }
    var lr = 0.05;
    this.lossHistory = [];
    for (var epoch = 0; epoch < (epochs || 200); epoch++){
      var totalLoss = 0;
      data.forEach(function(sample){
        var f = this.forward(sample.x);
        var err = f.out - sample.y;
        totalLoss += err * err;
        // Grad backward
        var dOut = 2 * err;
        var dH = [];
        for (var k = 0; k < 8; k++) dH.push(dOut * this.W2[k] * (1 - f.h[k] * f.h[k]));
        // update W2, b2
        for (var k2 = 0; k2 < 8; k2++){
          this.W2[k2] -= lr * dOut * f.h[k2];
        }
        this.b2[0] -= lr * dOut;
        // update W1, b1
        for (var i2 = 0; i2 < 4; i2++){
          for (var j2 = 0; j2 < 8; j2++){
            this.W1[i2][j2] -= lr * dH[j2] * sample.x[i2];
          }
        }
        for (var j3 = 0; j3 < 8; j3++){
          this.b1[j3] -= lr * dH[j3];
        }
      }.bind(this));
      if (epoch % 20 === 0) this.lossHistory.push(totalLoss / data.length);
    }
    this.trained = true;
    return true;
  },
  predict: function(inputs){
    if (!this.W1 || !this.trained){
      // fallback: naive mean of history or 0.5
      return 0.5;
    }
    var f = this.forward(inputs);
    return Math.max(0, f.out);
  }
};

function inputsToVec(inp){
  if (!inp) return [0.5, 0.5, 0.5, 0.5];
  return [
    clamp((inp.electricity_kwh || 0) / 1000, 0, 1),
    clamp((inp.water_liters || 0) / 20000, 0, 1),
    clamp((inp.waste_kg || 0) / 100, 0, 1),
    clamp((inp.transport_km || 0) / 2000, 0, 1)
  ];
}

// ============================================================================
// PERSISTENCE
// ============================================================================
function save(){
  try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch(e){}
  try { localStorage.setItem(ACHIEVEMENTS_KEY, JSON.stringify(achievements)); } catch(e){}
  try { localStorage.setItem(CHAT_KEY, JSON.stringify(chatHistory.slice(-40))); } catch(e){}
  try { localStorage.setItem(XP_KEY, JSON.stringify(xp)); } catch(e){}
}
function load(){
  try {
    var raw = localStorage.getItem(STORAGE_KEY);
    if (raw){
      var d = JSON.parse(raw);
      if (d && typeof d === "object"){
        state = Object.assign(state, d);
      }
    }
  } catch(e){}
  try {
    var a = localStorage.getItem(ACHIEVEMENTS_KEY);
    if (a) achievements = JSON.parse(a) || [];
  } catch(e){}
  try {
    var c = localStorage.getItem(CHAT_KEY);
    if (c) chatHistory = JSON.parse(c) || [];
  } catch(e){}
  try {
    var x = localStorage.getItem(XP_KEY);
    if (x) xp = Object.assign(xp, JSON.parse(x));
  } catch(e){}
  try {
    var th = localStorage.getItem(THEME_KEY);
    if (th === "dark") document.documentElement.setAttribute("data-theme", "dark");
  } catch(e){}
  try {
    var s = localStorage.getItem(SOUND_KEY);
    if (s === "off") soundOn = false;
  } catch(e){}
  try {
    var l = localStorage.getItem(LANG_KEY);
    if (l === "pt") lang = "pt";
  } catch(e){}
}

// ============================================================================
// XP SYSTEM
// ============================================================================
function addXP(amount){
  xp.points += amount;
  xp.total += amount;
  while (xp.points >= 100){
    xp.points -= 100;
    xp.level++;
    toast("Level " + xp.level + " unlocked! 🎉");
    launchConfetti();
    playSound(880, 0.3);
  }
  updateXPWidget();
  save();
}
function updateXPWidget(){
  $("lvlNum").textContent = xp.level;
  $("xpText").textContent = xp.points + "/100";
  $("xpFill").style.width = xp.points + "%";
}

// ============================================================================
// TABS
// ============================================================================
function switchTab(name){
  document.querySelectorAll(".tab-btn").forEach(function(b){
    b.classList.toggle("active", b.dataset.tab === name);
  });
  document.querySelectorAll(".tab-panel").forEach(function(p){
    p.classList.toggle("active", p.id === name);
  });
  window.scrollTo({ top: 0, behavior: "smooth" });
  if (name === "results") renderResults();
  if (name === "insights") { renderInsights(); renderHeatmap(); renderChallenges(); }
  if (name === "goals") renderGoals();
  if (name === "compare") renderCompare();
  if (name === "gaia") { renderNeuralPanel(); scrollChatBottom(); }
  playSound(520, 0.05);
}
document.querySelectorAll(".tab-btn").forEach(function(b){
  b.addEventListener("click", function(){ switchTab(b.dataset.tab); });
});

// ============================================================================
// VALIDATION & CALC
// ============================================================================
function validate(inputs){
  var errs = [];
  var fields = [["electricity_kwh","Electricity"],["water_liters","Water"],
    ["waste_kg","Waste"],["waste_diverted_kg","Diverted"],["transport_km","Transport"]];
  fields.forEach(function(f){
    var v = inputs[f[0]];
    if (v === null) return;
    if (isNaN(v)){ errs.push(f[1] + " must be a number"); return; }
    if (v < 0) errs.push(f[1] + " cannot be negative");
  });
  if (inputs.waste_kg !== null && inputs.waste_diverted_kg !== null &&
      inputs.waste_diverted_kg > inputs.waste_kg){
    errs.push("Diverted waste cannot exceed total waste");
  }
  if (inputs.household_size < 1 || inputs.household_size > 20){
    errs.push("Household size must be 1-20");
  }
  var hasData = fields.some(function(f){ return inputs[f[0]] !== null; });
  if (!hasData && !errs.length) errs.push("Enter at least one value");
  return errs;
}

function calcEmissions(inputs){
  var by = {}, total = 0;
  if (inputs.electricity_kwh !== null && inputs.electricity_kwh >= 0){
    by.electricity = inputs.electricity_kwh * FACTORS.electricity.rate; total += by.electricity;
  }
  if (inputs.water_liters !== null && inputs.water_liters >= 0){
    by.water = inputs.water_liters * FACTORS.water.rate; total += by.water;
  }
  if (inputs.waste_kg !== null && inputs.waste_kg >= 0){
    var d = inputs.waste_diverted_kg || 0;
    var lf = Math.max(0, inputs.waste_kg - d);
    by.waste = lf * FACTORS.waste.rate; total += by.waste;
  }
  if (inputs.transport_km !== null && inputs.transport_km >= 0){
    by.transport = inputs.transport_km * FACTORS.transport.rate; total += by.transport;
  }
  return { total: total, by_source: by };
}

function calcScore(inputs){
  var parts = [], hs = inputs.household_size || 1;
  if (inputs.electricity_kwh !== null && inputs.electricity_kwh >= 0){
    parts.push({ w: 0.35, v: clamp(100 - Math.max(0, inputs.electricity_kwh / hs - 150) * 0.15, 0, 100) });
  }
  if (inputs.water_liters !== null && inputs.water_liters >= 0){
    parts.push({ w: 0.30, v: clamp(100 - Math.max(0, inputs.water_liters / hs - 3000) * 0.008, 0, 100) });
  }
  if (inputs.waste_kg !== null && inputs.waste_kg > 0){
    parts.push({ w: 0.35, v: clamp((inputs.waste_diverted_kg || 0) / inputs.waste_kg * 100, 0, 100) });
  }
  if (!parts.length) return { score: null, note: "Insufficient data" };
  var tw = 0, acc = 0;
  parts.forEach(function(p){ tw += p.w; acc += p.w * p.v; });
  return { score: Math.round(acc / tw), coverage: tw,
    note: tw < 1 ? "Partial data — weights redistributed" : null };
}

function subScore(cat, inputs){
  var hs = inputs.household_size || 1;
  if (cat === "energy" && inputs.electricity_kwh !== null)
    return clamp(100 - Math.max(0, inputs.electricity_kwh / hs - 150) * 0.15, 0, 100);
  if (cat === "water" && inputs.water_liters !== null)
    return clamp(100 - Math.max(0, inputs.water_liters / hs - 3000) * 0.008, 0, 100);
  if (cat === "waste" && inputs.waste_kg > 0)
    return clamp((inputs.waste_diverted_kg || 0) / inputs.waste_kg * 100, 0, 100);
  return null;
}

function equivalents(totalKg){
  if (!isFinite(totalKg) || totalKg <= 0) return { trees: 0, km: 0, flights: 0, annual: 0 };
  var annual = totalKg * 12;
  return { annual: annual, trees: Math.round(annual / 21),
    km: Math.round(totalKg / 0.192), flights: Math.round(totalKg / 255) };
}

function generateRecommendations(inputs, scoreResult){
  var recs = [];
  var hs = inputs.household_size || 1;
  var epp = (inputs.electricity_kwh || 0) / hs;
  var wpp = (inputs.water_liters || 0) / hs;
  var waste = inputs.waste_kg || 0;
  var diverted = inputs.waste_diverted_kg || 0;
  var diversion = waste > 0 ? diverted / waste : null;

  if (epp > 200) recs.push({ priority: "high", category: "energy",
    title: "Switch to LED lighting",
    desc: "LED bulbs use 75-80% less energy than incandescent and last 25× longer.",
    why: "Your electricity (~" + Math.round(epp) + " kWh/person/month) exceeds the 150 kWh benchmark.",
    difficulty: "Easy", cost: "Low", benefit: "5-15% lighting electricity" });
  if (epp > 300) recs.push({ priority: "high", category: "energy",
    title: "Upgrade to efficient appliances",
    desc: "Choose A+++ rated appliances at next replacement.",
    why: "Very high per-person energy use suggests old appliances.",
    difficulty: "Hard", cost: "High", benefit: "20-50% appliance energy" });
  if (wpp > 4000) recs.push({ priority: "high", category: "water",
    title: "Inspect and repair leaks",
    desc: "A dripping faucet wastes 20,000+ liters per year.",
    why: "Your water use (~" + Math.round(wpp) + " L/person/month) exceeds 3000 L benchmark.",
    difficulty: "Easy", cost: "Low", benefit: "5-20% water reduction" });
  if (diversion !== null && diversion < 0.30) recs.push({ priority: "high", category: "waste",
    title: "Improve waste separation",
    desc: "Set up labeled bins for paper, plastic, glass, and organics.",
    why: "Only ~" + Math.round(diversion * 100) + "% of waste is diverted (target: 50%).",
    difficulty: "Easy", cost: "Low", benefit: "20-40 pp increase" });
  if (diversion !== null && diversion < 0.50) recs.push({ priority: "medium", category: "waste",
    title: "Start home composting",
    desc: "Composting organics reduces methane from landfills.",
    why: "Diversion below 50% target.",
    difficulty: "Medium", cost: "Low", benefit: "Diverts 30-40% of waste" });
  if ((inputs.transport_km || 0) > 500) recs.push({ priority: "medium", category: "transport",
    title: "Combine trips and use transit",
    desc: "Carpooling, public transit, and trip chaining reduce fuel use.",
    why: "Your transport (" + inputs.transport_km + " km/month) suggests opportunity.",
    difficulty: "Medium", cost: "None", benefit: "10-30% transport reduction" });
  if (scoreResult.score !== null && scoreResult.score >= 70) recs.push({ priority: "low", category: "positive",
    title: "Maintain your good habits",
    desc: "Your score is above average. Keep tracking to lock in gains.",
    why: "Score: " + scoreResult.score + "/100.",
    difficulty: "Easy", cost: "None", benefit: "Maintains savings" });
  else recs.push({ priority: "low", category: "habit",
    title: "Track consumption weekly",
    desc: "Regular tracking increases awareness and drives improvement.",
    why: "Behavioral research links awareness to 5-15% reductions.",
    difficulty: "Easy", cost: "None", benefit: "5-15% through awareness" });
  return recs;
}

// ============================================================================
// ACHIEVEMENTS
// ============================================================================
function checkAchievements(){
  var newOnes = [];
  function unlock(id, emoji, label){
    if (achievements.some(function(a){ return a.id === id; })) return;
    achievements.push({ id: id, emoji: emoji, label: label });
    newOnes.push(label);
  }
  if (state.inputs) unlock("first", "🌱", "First Assessment");
  if (state.inputs && ["electricity_kwh","water_liters","waste_kg","transport_km"]
      .every(function(k){ return state.inputs[k] !== null; })) unlock("complete", "📊", "Data Complete");
  if (state.score && state.score.score !== null && state.score.score >= 70) unlock("warrior", "🏆", "Eco Warrior (70+)");
  if (state.score && state.score.score !== null && state.score.score >= 90) unlock("champion", "👑", "Champion (90+)");
  if (state.goals.length >= 3) unlock("planner", "🎯", "Goal Setter (3+)");
  if (state.goals.some(function(g){ return g.status === "completed"; })) unlock("committed", "✅", "Goal Completed");
  if (state.history.length >= 3) unlock("tracker", "📈", "Progress Tracker (3+)");
  if (chatHistory.length >= 5) unlock("chatter", "💬", "GAIA Chat Starter");
  if (xp.level >= 3) unlock("level3", "⭐", "Level 3 Reached");
  if (newOnes.length){
    toast("🎉 " + newOnes.join(", "));
    launchConfetti();
    playSound(880, 0.3);
    setTimeout(function(){ playSound(1100, 0.3); }, 120);
  }
  save();
}

// ============================================================================
// ACTIONS
// ============================================================================
function readNum(id){
  var el = $(id);
  if (!el || el.value === "") return null;
  var v = parseFloat(el.value);
  return isFinite(v) ? v : NaN;
}

function calculate(){
  var inputs = {
    electricity_kwh: readNum("inEnergy"),
    water_liters: readNum("inWater"),
    waste_kg: readNum("inWaste"),
    waste_diverted_kg: readNum("inDiverted"),
    transport_km: readNum("inTransport"),
    household_size: parseInt($("inHousehold").value, 10) || 1
  };
  var errs = validate(inputs);
  var el = $("errors");
  if (errs.length){
    el.innerHTML = errs.map(function(e){ return "• " + esc(e); }).join("<br>");
    el.style.display = "block";
    playSound(220, 0.2);
    return;
  }
  el.style.display = "none";
  state.inputs = inputs;
  state.emissions = calcEmissions(inputs);
  state.score = calcScore(inputs);
  state.recommendations = generateRecommendations(inputs, state.score);
  state.isDemo = false;
  state.history.push({ at: new Date().toISOString(), total: state.emissions.total,
    score: state.score.score, inputs: JSON.parse(JSON.stringify(inputs)) });
  if (state.history.length > 30) state.history.shift();
  sessionAssessments++;
  addXP(25);
  // Retrain neural predictor
  if (state.history.length >= 2) NeuralPredictor.train(state.history, 150);
  save();
  checkAchievements();
  renderResults();
  switchTab("results");
  toast("Assessment complete ✓");
  playSound(760, 0.15);
}

function clearForm(){
  ["inEnergy","inWater","inWaste","inDiverted","inTransport"].forEach(function(id){ $(id).value = ""; });
  $("inHousehold").value = 1;
  $("errors").style.display = "none";
}

function loadDemo(){
  $("inEnergy").value = 450;
  $("inWater").value = 12000;
  $("inWaste").value = 60;
  $("inDiverted").value = 15;
  $("inTransport").value = 800;
  $("inHousehold").value = 3;
  calculate();
  state.isDemo = true;
  save();
  renderResults();
  toast("Demo loaded — illustrative, not real");
}

function resetAll(){
  if (!confirm("Reset all data? Clears assessment, goals, chat, and XP.")) return;
  state = { inputs: null, emissions: null, score: null, recommendations: [],
    goals: [], isDemo: false, history: [] };
  achievements = []; chatHistory = []; xp = { level: 1, points: 0, total: 0 };
  challenges = [];
  try {
    [STORAGE_KEY, ACHIEVEMENTS_KEY, CHAT_KEY, XP_KEY].forEach(function(k){
      localStorage.removeItem(k);
    });
  } catch(e){}
  clearForm();
  updateXPWidget();
  renderResults(); renderGoals(); renderInsights();
  renderCompare(); renderChat(); renderChallenges(); renderHeatmap();
  toast("All data reset");
}

// ============================================================================
// RENDER: RESULTS
// ============================================================================
function renderResults(){
  var c = $("resultsContent");
  if (!state.inputs || !state.emissions){
    c.innerHTML = '<div class="empty"><svg viewBox="0 0 24 24"><path d="M3 13h2v8H3v-8zm4 0h2v8H7v-8zm4-6h2v14h-2V7zm4 4h2v10h-2V11zm4-8h2v18h-2V3z"/></svg><p>No assessment yet.</p><button class="btn btn-primary" onclick="switchTab(\'assess\')">Start Assessment →</button></div>';
    return;
  }
  var inp = state.inputs, em = state.emissions, sc = state.score;
  var eq = equivalents(em.total);
  var html = "";
  if (state.isDemo) html += '<div class="alert alert-info"><svg viewBox="0 0 24 24"><path d="M11 7h2v2h-2V7zm0 4h2v6h-2v-6zm1-9C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/></svg><div><strong>Demo data.</strong> Illustrative sample.</div></div>';

  html += '<div class="grid grid-2" style="margin-bottom:16px">';
  html += '<div class="card" style="margin:0">';
  if (sc.score !== null){
    var color = sc.score >= 70 ? "good" : sc.score >= 40 ? "ok" : "poor";
    var label = sc.score >= 70 ? "Sustainable" : sc.score >= 40 ? "Improving" : "Needs work";
    html += '<div class="card-title">Sustainability Score</div>';
    html += '<div class="score-ring-wrap"><div class="score-ring"><svg viewBox="0 0 220 220">';
    html += '<defs><linearGradient id="ringGrad" x1="0%" y1="0%" x2="100%" y2="100%">';
    html += '<stop offset="0%" stop-color="#14b8a6"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs>';
    html += '<circle class="score-ring-bg" cx="110" cy="110" r="92"/>';
    var circ = 2 * Math.PI * 92;
    var dash = (sc.score / 100) * circ;
    html += '<circle class="score-ring-fg" cx="110" cy="110" r="92" stroke-dasharray="' + dash + ' ' + (circ - dash) + '"/>';
    html += '</svg><div class="score-value">' + sc.score + '<small>/100</small></div></div>';
    html += '<div class="score-badge ' + color + '">' + label + '</div></div>';
  } else {
    html += '<div class="card-title">Score</div><div class="empty">Not enough data</div>';
  }
  html += '</div>';

  html += '<div class="card" style="margin:0"><div class="card-title">Achievements</div>';
  if (achievements.length){
    html += '<div class="achievements">' + achievements.map(function(a){
      return '<div class="achievement"><span class="em">' + a.emoji + '</span>' + esc(a.label) + '</div>';
    }).join("") + '</div>';
  } else {
    html += '<p class="text-muted" style="font-size:.85rem">Complete assessments to unlock badges.</p>';
  }
  html += '</div></div>';

  html += '<div class="grid grid-4" style="margin-bottom:16px">';
  html += metricCard("Electricity", fmt(inp.electricity_kwh), "kWh/month", "bolt");
  html += metricCard("Water", fmt(inp.water_liters), "L/month", "drop");
  html += metricCard("Waste", fmt(inp.waste_kg), "kg/month", "trash");
  html += metricCard("Emissions", fmt(em.total, 1), "kg CO₂e/month", "leaf");
  html += '</div>';

  html += '<div class="card"><div class="card-title">Sub-scores</div>';
  [["energy","Energy","#0f766e"],["water","Water","#0891b2"],
   ["waste","Waste","#f59e0b"],["transport","Transport","#8b5cf6"]].forEach(function(s){
    var v = subScore(s[0], inp);
    if (v === null) return;
    html += '<div class="sub-bar-wrap"><div class="sub-bar-header"><span>' + s[1] + '</span><span>' + Math.round(v) + '/100</span></div>';
    html += '<div class="sub-bar-track"><div class="sub-bar-fill" style="width:' + v + '%;background:' + s[2] + '"></div></div></div>';
  });
  html += '</div>';

  html += '<div class="card"><div class="card-title">Annual Impact Equivalent</div><div class="grid grid-3">';
  html += equivalent("🌳", fmtInt(eq.trees), "trees to absorb your yearly CO₂e");
  html += equivalent("🚗", fmtInt(eq.km), "km driven by average car");
  html += equivalent("✈️", fmtInt(eq.flights), "short-haul flights worth");
  html += '</div></div>';

  html += '<div class="card"><div class="card-title">Emissions Breakdown</div>';
  html += '<div class="donut-wrap">' + renderDonut(em.by_source, em.total) + '<div class="donut-legend">';
  ["electricity","water","waste","transport"].forEach(function(k){
    if (em.by_source[k] === undefined) return;
    var val = em.by_source[k];
    var pct = em.total > 0 ? (val / em.total * 100) : 0;
    html += '<div class="legend-item"><div class="legend-dot" style="background:' + FACTORS[k].color + '"></div>';
    html += '<div class="legend-label">' + FACTORS[k].label + '</div>';
    html += '<div class="legend-val">' + fmt(val, 1) + ' kg <span class="text-muted" style="font-weight:400">(' + fmt(pct, 0) + '%)</span></div></div>';
  });
  html += '</div></div></div>';

  html += '<div class="card"><div class="card-title">Trend</div>' + renderTrend() + '</div>';

  html += '<div class="card"><div class="card-title">What-If Simulator</div>';
  html += '<div class="sim-slider-row"><div class="sim-header"><label for="simEnergy">Reduce electricity by</label><span class="sim-value" id="simEnergyVal">0%</span></div><input type="range" id="simEnergy" min="0" max="50" value="0" step="5"></div>';
  html += '<div class="sim-slider-row"><div class="sim-header"><label for="simWater">Reduce water by</label><span class="sim-value" id="simWaterVal">0%</span></div><input type="range" id="simWater" min="0" max="50" value="0" step="5"></div>';
  html += '<div class="sim-slider-row"><div class="sim-header"><label for="simWaste">Increase diversion by</label><span class="sim-value" id="simWasteVal">0%</span></div><input type="range" id="simWaste" min="0" max="50" value="0" step="5"></div>';
  html += '<div class="sim-result"><div class="sim-result-item"><div class="v" id="simNewTotal">—</div><div class="l">New monthly total</div></div>';
  html += '<div class="sim-result-item"><div class="v" id="simSaved">—</div><div class="l">Monthly savings</div></div></div></div>';

  html += '<h2 style="font-size:1.2rem;font-weight:800;margin:24px 0 12px">Recommendations</h2>';
  html += '<div class="rec-filters" id="recFilters"></div><div id="recList"></div>';

  c.innerHTML = html;
  ["simEnergy","simWater","simWaste"].forEach(function(id){
    var el = $(id); if (el) el.addEventListener("input", updateSimulator);
  });
  updateSimulator();
  renderRecFilters(); renderRecList();
}

function metricCard(label, value, unit, icon){
  var icons = { bolt: '<path d="M7 2v11h3v9l7-12h-4l4-8z"/>',
    drop: '<path d="M12 2c-4 4-8 8-8 12a8 8 0 0016 0c0-4-4-8-8-12z"/>',
    trash: '<path d="M3 6h18v2H3V6zm2 4h14v12H5V10z"/>',
    leaf: '<path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75C7 8 17 8 17 8z"/>' };
  return '<div class="metric"><div class="metric-icon"><svg viewBox="0 0 24 24">' + (icons[icon] || "") + '</svg></div>' +
    '<div class="metric-label">' + label + '</div><div class="metric-value">' + value + '</div>' +
    '<div class="metric-unit">' + unit + '</div></div>';
}

function equivalent(emoji, value, label){
  return '<div class="equivalent"><div class="equivalent-icon">' + emoji + '</div>' +
    '<div class="equivalent-value">' + value + '</div><div class="equivalent-label">' + label + '</div></div>';
}

function renderDonut(bySource, total){
  if (total === 0) return '<div style="width:180px;height:180px;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:.8rem">No data</div>';
  var r = 70, cx = 90, cy = 90, circ = 2 * Math.PI * r;
  var svg = '<svg class="donut" viewBox="0 0 180 180">';
  var offset = 0;
  ["electricity","water","waste","transport"].forEach(function(k){
    if (bySource[k] === undefined) return;
    var len = (bySource[k] / total) * circ;
    svg += '<circle cx="' + cx + '" cy="' + cy + '" r="' + r + '" fill="none" stroke="' + FACTORS[k].color + '" stroke-width="26" stroke-dasharray="' + len + ' ' + (circ - len) + '" stroke-dashoffset="' + (-offset) + '" transform="rotate(-90 ' + cx + ' ' + cy + ')"/>';
    offset += len;
  });
  svg += '</svg>'; return svg;
}

function renderTrend(){
  var hist = state.history;
  if (hist.length < 2) return '<p class="text-muted" style="font-size:.85rem">Need 2+ assessments to show trend.</p>';
  var w = 400, h = 160, pad = 30;
  var vals = hist.map(function(p){ return p.total; });
  var maxV = Math.max.apply(null, vals);
  var minV = Math.min.apply(null, vals);
  var range = maxV - minV || 1;
  var points = hist.map(function(p, i){
    return [pad + (i / (hist.length - 1)) * (w - 2 * pad),
      h - pad - ((p.total - minV) / range) * (h - 2 * pad)];
  });
  var path = points.map(function(p, i){ return (i === 0 ? "M" : "L") + p[0] + " " + p[1]; }).join(" ");
  var svg = '<svg viewBox="0 0 ' + w + ' ' + h + '" style="width:100%;height:auto;max-height:200px">';
  svg += '<path d="' + path + ' L' + points[points.length-1][0] + ' ' + (h - pad) + ' L' + points[0][0] + ' ' + (h - pad) + ' Z" fill="rgba(20,184,166,.15)"/>';
  svg += '<path d="' + path + '" fill="none" stroke="#0f766e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>';
  points.forEach(function(p){ svg += '<circle cx="' + p[0] + '" cy="' + p[1] + '" r="4" fill="#fff" stroke="#0f766e" stroke-width="2"/>'; });
  svg += '</svg>'; return svg;
}

function renderRecFilters(){
  var cats = ["all","energy","water","waste","transport"];
  var labels = { all: "All", energy: "Energy", water: "Water", waste: "Waste", transport: "Transport" };
  var el = $("recFilters"); if (!el) return;
  el.innerHTML = cats.map(function(c){
    return '<button class="rec-filter-btn ' + (recFilter === c ? 'active' : '') +
      '" onclick="setRecFilter(\'' + c + '\')">' + labels[c] + '</button>';
  }).join("");
}

function setRecFilter(f){ recFilter = f; renderRecFilters(); renderRecList(); }

function renderRecList(){
  var el = $("recList"); if (!el) return;
  var list = state.recommendations;
  if (recFilter !== "all") list = list.filter(function(r){ return r.category === recFilter; });
  if (!list.length){ el.innerHTML = '<div class="empty" style="padding:24px"><p>No recommendations in this category.</p></div>'; return; }
  el.innerHTML = list.map(function(r){
    return '<div class="rec priority-' + r.priority + '"><div class="rec-header"><div class="rec-title">' + esc(r.title) + '</div><span class="rec-badge ' + r.priority + '">' + r.priority + '</span></div>' +
      '<div class="rec-desc">' + esc(r.desc) + '</div><div class="rec-why">Why: ' + esc(r.why) + '</div>' +
      '<div class="rec-meta"><span><strong>Difficulty:</strong> ' + esc(r.difficulty) + '</span>' +
      '<span><strong>Cost:</strong> ' + esc(r.cost) + '</span><span><strong>Benefit:</strong> ' + esc(r.benefit) + '</span></div></div>';
  }).join("");
}

function updateSimulator(){
  if (!state.inputs || !state.emissions) return;
  var inp = state.inputs;
  var ePct = parseInt($("simEnergy").value, 10) / 100;
  var wPct = parseInt($("simWater").value, 10) / 100;
  var dPct = parseInt($("simWaste").value, 10) / 100;
  $("simEnergyVal").textContent = Math.round(ePct * 100) + "%";
  $("simWaterVal").textContent = Math.round(wPct * 100) + "%";
  $("simWasteVal").textContent = Math.round(dPct * 100) + "%";
  var simInputs = {
    electricity_kwh: inp.electricity_kwh !== null ? inp.electricity_kwh * (1 - ePct) : null,
    water_liters: inp.water_liters !== null ? inp.water_liters * (1 - wPct) : null,
    waste_kg: inp.waste_kg,
    waste_diverted_kg: inp.waste_diverted_kg !== null
      ? Math.min(inp.waste_kg || 0, (inp.waste_diverted_kg || 0) * (1 + dPct) + (inp.waste_kg || 0) * dPct * 0.3) : null,
    transport_km: inp.transport_km,
    household_size: inp.household_size
  };
  var simEm = calcEmissions(simInputs);
  var saved = state.emissions.total - simEm.total;
  $("simNewTotal").textContent = fmt(simEm.total, 1) + " kg";
  $("simSaved").textContent = (saved >= 0 ? "−" : "+") + fmt(Math.abs(saved), 1) + " kg";
}

// ============================================================================
// RENDER: INSIGHTS / HEATMAP / CHALLENGES
// ============================================================================
function renderInsights(){
  var c = $("insightsList");
  if (!state.inputs || !state.emissions){
    c.innerHTML = '<div class="empty"><p>Complete an assessment to generate insights.</p></div>'; return;
  }
  var inp = state.inputs, em = state.emissions;
  var insights = [];
  var keys = Object.keys(em.by_source).filter(function(k){ return em.by_source[k] > 0; });
  if (keys.length){
    keys.sort(function(a, b){ return em.by_source[b] - em.by_source[a]; });
    var biggest = keys[0];
    var pct = (em.by_source[biggest] / em.total * 100).toFixed(0);
    insights.push({ type: "info", icon: "📊", title: "Biggest contributor",
      text: FACTORS[biggest].label + " accounts for " + pct + "% of your emissions." });
  }
  var hs = inp.household_size || 1;
  if ((inp.electricity_kwh || 0) / hs > 150){
    insights.push({ type: "warn", icon: "⚡", title: "Above energy benchmark",
      text: "Your electricity is " + (((inp.electricity_kwh || 0) / hs) / 150).toFixed(1) + "× the 150 kWh/person benchmark." });
  }
  if ((inp.water_liters || 0) / hs > 3000){
    insights.push({ type: "warn", icon: "💧", title: "Above water benchmark",
      text: "Your water is " + (((inp.water_liters || 0) / hs) / 3000).toFixed(1) + "× the 3000 L/person benchmark." });
  }
  if (inp.waste_kg > 0){
    var div = ((inp.waste_diverted_kg || 0) / inp.waste_kg * 100);
    insights.push({ type: div >= 50 ? "good" : "warn", icon: "♻️", title: "Waste diversion",
      text: "You divert " + div.toFixed(0) + "% of waste. Target: 50%." });
  }
  if (state.history.length >= 2){
    var prev = state.history[state.history.length - 2].total;
    var delta = ((em.total - prev) / prev * 100);
    if (Math.abs(delta) > 5){
      insights.push({ type: delta < 0 ? "good" : "bad", icon: delta < 0 ? "📉" : "📈",
        title: delta < 0 ? "Emissions decreased" : "Emissions increased",
        text: Math.abs(delta).toFixed(0) + "% vs previous assessment." });
    }
  }
  insights.push({ type: "info", icon: "💡", title: "Tip",
    text: "Small consistent changes beat big occasional ones. Aim for 5% monthly improvements." });
  c.innerHTML = insights.map(function(i){
    return '<div class="insight ' + i.type + '"><div class="insight-icon">' + i.icon + '</div>' +
      '<div class="insight-body"><div class="insight-title">' + esc(i.title) + '</div>' +
      '<div class="insight-text">' + esc(i.text) + '</div></div></div>';
  }).join("");
}

function renderHeatmap(){
  var el = $("heatmap"); if (!el) return;
  var days = 120;
  var today = new Date();
  var counts = {};
  state.history.forEach(function(h){
    var d = h.at ? h.at.slice(0, 10) : null;
    if (d) counts[d] = (counts[d] || 0) + 1;
  });
  var max = 1;
  Object.keys(counts).forEach(function(k){ if (counts[k] > max) max = counts[k]; });
  var html = "";
  for (var i = days - 1; i >= 0; i--){
    var date = new Date(today);
    date.setDate(date.getDate() - i);
    var key = date.toISOString().slice(0, 10);
    var c = counts[key] || 0;
    var lvl = c === 0 ? 0 : Math.ceil(c / max * 5);
    html += '<div class="heatmap-cell" data-lvl="' + lvl + '" title="' + key + ': ' + c + ' assessment(s)"></div>';
  }
  el.innerHTML = html;
}

function renderChallenges(){
  var el = $("challengesSection");
  var dailies = [
    { id: "run_assess", title: "Run an assessment", desc: "Complete one assessment today", xp: 25 },
    { id: "chat_gaia", title: "Chat with GAIA", desc: "Ask GAIA one question", xp: 15 },
    { id: "create_goal", title: "Create a goal", desc: "Set a sustainability goal", xp: 20 },
    { id: "check_insights", title: "Check insights", desc: "Visit the Insights tab", xp: 10 }
  ];
  var done = challenges.filter(function(c){ return c.done; }).map(function(c){ return c.id; });
  var html = '<div class="card"><div class="card-title">Daily Challenges</div>';
  dailies.forEach(function(ch){
    var isDone = done.indexOf(ch.id) >= 0;
    html += '<div class="challenge-card ' + (isDone ? 'done' : '') + '">';
    html += '<div class="challenge-icon">' + (isDone ? '✅' : '🎯') + '</div>';
    html += '<div class="challenge-body"><div class="challenge-title">' + esc(ch.title) + '</div>';
    html += '<div class="challenge-desc">' + esc(ch.desc) + '</div>';
    html += '<span class="challenge-xp">+' + ch.xp + ' XP</span>';
    html += '</div></div>';
  });
  html += '</div>';
  el.innerHTML = html;
}

function completeChallenge(id){
  if (challenges.some(function(c){ return c.id === id; })) return;
  challenges.push({ id: id, done: true, at: new Date().toISOString() });
  var xpMap = { run_assess: 25, chat_gaia: 15, create_goal: 20, check_insights: 10 };
  addXP(xpMap[id] || 10);
  playSound(1000, 0.15);
  renderChallenges();
  save();
}

// ============================================================================
// GAIA CHAT
// ============================================================================
function renderChat(){
  var body = $("chatBody"); if (!body) return;
  if (!chatHistory.length){
    chatHistory.push({ role: "gaia", text: "Hello! I'm GAIA, your on-device sustainability agent. 🌱\n\nAsk me about your score, energy, water, waste, transport, trends, or predictions. Or click **Load Demo** in the Assess tab to try.", at: Date.now() });
  }
  body.innerHTML = chatHistory.map(function(m){
    var avatar = m.role === "gaia" ? "🌱" : "👤";
    var html = '<div class="msg ' + m.role + '"><div class="msg-avatar">' + avatar + '</div>';
    html += '<div class="msg-bubble">' + formatMsgText(m.text) + '</div></div>';
    return html;
  }).join("");
  scrollChatBottom();
  renderSuggestions();
}

function formatMsgText(text){
  text = esc(text);
  text = text.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  text = text.replace(/`([^`]+)`/g, '<code>$1</code>');
  text = text.replace(/\n/g, '<br>');
  return text;
}

function scrollChatBottom(){
  var body = $("chatBody");
  if (body) body.scrollTop = body.scrollHeight;
}

function renderSuggestions(){
  var el = $("chatSuggestions"); if (!el) return;
  var suggestions = ["What's my score?", "Predict next month", "How's my energy?",
    "Any tips?", "Compare me", "Show trend", "Explain my waste", "Help"];
  el.innerHTML = suggestions.map(function(s){
    return '<button class="chat-suggest" onclick="chatSend(\'' + s.replace(/'/g, "\\'") + '\')">' + s + '</button>';
  }).join("");
}

function chatSend(presetText){
  var input = $("chatInput");
  var text = (presetText || input.value || "").trim();
  if (!text) return;
  input.value = "";
  chatHistory.push({ role: "user", text: text, at: Date.now() });
  renderChat();
  completeChallenge("chat_gaia");
  playSound(620, 0.08);
  // typing indicator
  var body = $("chatBody");
  body.innerHTML += '<div class="msg gaia"><div class="msg-avatar">🌱</div><div class="typing"><span></span><span></span><span></span></div></div>';
  scrollChatBottom();
  setTimeout(function(){
    var response = GAIA.respond(text);
    chatHistory.push({ role: "gaia", text: response, at: Date.now() });
    save();
    renderChat();
    checkAchievements();
  }, 600 + Math.random() * 400);
}

function clearChat(){
  if (!confirm("Clear chat history?")) return;
  chatHistory = [];
  renderChat();
}

// ============================================================================
// RENDER: NEURAL PANEL
// ============================================================================
function renderNeuralPanel(){
  var el = $("neuralStats"); if (!el) return;
  var predKg = 0;
  if (state.inputs){
    var pred = NeuralPredictor.predict(inputsToVec(state.inputs));
    predKg = pred * 1000;
  }
  var status = NeuralPredictor.trained ? "Trained" : "Idle";
  var samples = state.history.length;
  var loss = NeuralPredictor.lossHistory.length ?
    NeuralPredictor.lossHistory[NeuralPredictor.lossHistory.length - 1] : 0;
  el.innerHTML =
    '<div class="neural-stat-item"><div class="v">' + status + '</div><div class="l">Status</div></div>' +
    '<div class="neural-stat-item"><div class="v">' + samples + '</div><div class="l">Samples</div></div>' +
    '<div class="neural-stat-item"><div class="v">' + (predKg > 0 ? fmt(predKg, 0) + 'kg' : '—') + '</div><div class="l">Next month</div></div>' +
    '<div class="neural-stat-item"><div class="v">' + (loss > 0 ? loss.toFixed(3) : '—') + '</div><div class="l">Loss</div></div>';

  var spark = $("neuralSpark"); if (!spark) return;
  if (NeuralPredictor.lossHistory.length < 2){
    spark.innerHTML = '<p class="text-muted" style="font-size:.72rem;text-align:center;padding:10px">Run 2+ assessments to train the predictor.</p>';
    return;
  }
  var vals = NeuralPredictor.lossHistory;
  var maxV = Math.max.apply(null, vals);
  var w = 400, h = 40;
  var pts = vals.map(function(v, i){
    return [(i / (vals.length - 1)) * w, h - (v / maxV) * h];
  });
  var path = pts.map(function(p, i){ return (i === 0 ? "M" : "L") + p[0] + " " + p[1]; }).join(" ");
  spark.innerHTML = '<svg viewBox="0 0 ' + w + ' ' + h + '" preserveAspectRatio="none"><path d="' + path + '" fill="none" stroke="#8b5cf6" stroke-width="2"/></svg>';
}

// ============================================================================
// RENDER: GOALS
// ============================================================================
function renderGoals(){
  var c = $("goalsList");
  if (!state.goals.length){
    c.innerHTML = '<div class="empty"><p>No goals yet. Create one above.</p></div>'; return;
  }
  var today = todayISO();
  c.innerHTML = state.goals.map(function(g){
    var overdue = g.deadline && g.deadline < today && g.status !== "completed";
    var progress = g.progress || 0;
    return '<div class="goal' + (overdue ? ' overdue' : '') + '">' +
      '<div class="goal-header"><div class="goal-title">' + esc(g.title) + '</div>' +
      '<div class="goal-actions"><button class="btn btn-secondary btn-sm" onclick="advanceGoal(\'' + g.id + '\')">' +
      (g.status === "completed" ? "↺" : "▶") + '</button>' +
      '<button class="btn btn-danger btn-sm" onclick="deleteGoal(\'' + g.id + '\')">✕</button></div></div>' +
      '<div class="progress-track"><div class="progress-fill" style="width:' + progress + '%"></div></div>' +
      '<div class="goal-meta"><span>' + progress + '% · ' + g.status + '</span><span>' +
      (g.deadline ? "📅 " + g.deadline + (overdue ? " (overdue)" : "") : "No deadline") + '</span></div></div>';
  }).join("");
}

function applyGoalTemplate(id){
  var templates = {
    energy15: { title: "Reduce electricity by 15%", target: state.inputs ? Math.round((state.inputs.electricity_kwh || 450) * 0.85) : 380, unit: "kWh" },
    water20: { title: "Reduce water by 20%", target: state.inputs ? Math.round((state.inputs.water_liters || 12000) * 0.8) : 9600, unit: "L" },
    recycle50: { title: "Reach 50% waste diversion", target: 50, unit: "%" },
    carHalf: { title: "Halve car trips", target: state.inputs ? Math.round((state.inputs.transport_km || 800) / 2) : 400, unit: "km" }
  };
  var tpl = templates[id]; if (!tpl) return;
  $("goalTitle").value = tpl.title;
  $("goalTarget").value = tpl.target;
  $("goalUnit").value = tpl.unit;
  var d = new Date(); d.setDate(d.getDate() + 30);
  $("goalDeadline").value = d.toISOString().slice(0, 10);
  $("goalTitle").focus();
  playSound(700, 0.1);
}

function addGoal(){
  var title = $("goalTitle").value.trim();
  if (!title){ toast("Title required", "warn"); return; }
  var goal = {
    id: "g_" + Date.now() + "_" + Math.floor(Math.random() * 10000),
    title: title,
    target: parseFloat($("goalTarget").value) || null,
    unit: $("goalUnit").value.trim() || "",
    deadline: $("goalDeadline").value || null,
    status: "pending", progress: 0,
    createdAt: new Date().toISOString()
  };
  state.goals.push(goal);
  save();
  $("goalTitle").value = ""; $("goalTarget").value = "";
  renderGoals();
  addXP(15);
  completeChallenge("create_goal");
  toast("Goal created ✓");
  playSound(800, 0.15);
}

function advanceGoal(id){
  for (var i = 0; i < state.goals.length; i++){
    if (state.goals[i].id === id){
      var g = state.goals[i];
      if (g.status === "completed"){ g.progress = 0; g.status = "pending"; }
      else { g.progress = Math.min(100, (g.progress || 0) + 25);
        g.status = g.progress >= 100 ? "completed" : "in-progress"; }
      if (g.status === "completed"){ addXP(30); launchConfetti(); playSound(880, 0.3); }
      else { addXP(5); playSound(600, 0.08); }
      save(); renderGoals(); checkAchievements(); return;
    }
  }
}

function deleteGoal(id){
  if (!confirm("Delete this goal?")) return;
  state.goals = state.goals.filter(function(g){ return g.id !== id; });
  save(); renderGoals();
}

// ============================================================================
// RENDER: COMPARE
// ============================================================================
function renderCompare(){
  var c = $("compareContent");
  if (!state.inputs){ c.innerHTML = '<div class="empty"><p>Complete an assessment to compare.</p></div>'; return; }
  var inp = state.inputs, hs = inp.household_size || 1;
  var items = [];
  if (inp.electricity_kwh !== null) items.push({ label: "Energy", value: inp.electricity_kwh / hs, bench: 150, unit: "kWh/pp" });
  if (inp.water_liters !== null) items.push({ label: "Water", value: inp.water_liters / hs, bench: 3000, unit: "L/pp" });
  if (inp.waste_kg > 0) items.push({ label: "Diversion", value: ((inp.waste_diverted_kg || 0) / inp.waste_kg) * 100, bench: 50, unit: "%", higherBetter: true });
  if (inp.transport_km !== null) items.push({ label: "Transport", value: inp.transport_km, bench: 500, unit: "km" });
  var html = '<div class="card">';
  items.forEach(function(it){
    var max = Math.max(it.value, it.bench) * 1.2;
    var yourPct = (it.value / max) * 100;
    var benchPct = (it.bench / max) * 100;
    var good = it.higherBetter ? it.value >= it.bench : it.value <= it.bench;
    var color = good ? "linear-gradient(90deg,#10b981,#14b8a6)" : "linear-gradient(90deg,#f59e0b,#dc2626)";
    html += '<div class="compare-row"><div class="compare-header"><span class="label">' + it.label + '</span>';
    html += '<span class="value">' + it.value.toFixed(1) + ' ' + it.unit + ' · target ' + it.bench + '</span></div>';
    html += '<div class="compare-track"><div class="compare-fill" style="width:' + yourPct + '%;background:' + color + '">' + fmt(it.value, 1) + '</div>';
    html += '<div class="compare-target" style="left:' + benchPct + '%"></div></div></div>';
  });
  html += '<p class="text-muted" style="font-size:.75rem;margin-top:16px;font-style:italic">Red line = benchmark.</p></div>';
  c.innerHTML = html;
}

// ============================================================================
// EXPORT / IMPORT
// ============================================================================
function exportCSV(){
  if (!state.inputs){ toast("Run an assessment first", "warn"); return; }
  var inp = state.inputs, em = state.emissions, sc = state.score;
  var rows = [["EcoGenesis AI v4 — Export"],["Generated", new Date().toISOString()],["Source", state.isDemo ? "DEMO" : "User"],[],
    ["Input","Value","Unit"],["Electricity",inp.electricity_kwh ?? "","kWh/month"],
    ["Water",inp.water_liters ?? "","L/month"],["Waste",inp.waste_kg ?? "","kg/month"],
    ["Diverted",inp.waste_diverted_kg ?? "","kg/month"],["Transport",inp.transport_km ?? "","km/month"],
    ["Household",inp.household_size||1,"people"],[],["Source","kg CO2e/month"]];
  Object.keys(em.by_source).forEach(function(k){ rows.push([k, em.by_source[k].toFixed(3)]); });
  rows.push(["TOTAL", em.total.toFixed(3)]); rows.push([]);
  rows.push(["Score", sc && sc.score !== null ? sc.score + "/100" : "N/A"]);
  rows.push([]); rows.push(["NOTE","DEMO VALUES — not verified measurements"]);
  var csv = rows.map(function(r){
    return r.map(function(c){ return '"' + String(c ?? "").replace(/"/g, '""') + '"'; }).join(",");
  }).join("\n");
  downloadFile(csv, "ecogenesis-" + todayISO() + ".csv", "text/csv");
  toast("CSV ✓");
}

function exportJSON(){
  if (!state.inputs){ toast("Run an assessment first", "warn"); return; }
  var payload = { app: "EcoGenesis AI v4 GAIA", exported_at: new Date().toISOString(),
    data_source: state.isDemo ? "demo" : "user", inputs: state.inputs, emissions: state.emissions,
    score: state.score, recommendations: state.recommendations, goals: state.goals,
    achievements: achievements, history: state.history, xp: xp,
    disclaimer: "DEMO VALUES — not verified" };
  downloadFile(JSON.stringify(payload, null, 2), "ecogenesis-" + todayISO() + ".json", "application/json");
  toast("JSON ✓");
}

function downloadFile(content, filename, mime){
  var safe = filename.replace(/[^a-z0-9_.\-]/gi, "_");
  var blob = new Blob([content], { type: mime + ";charset=utf-8" });
  var url = URL.createObjectURL(blob);
  var a = document.createElement("a"); a.href = url; a.download = safe;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  setTimeout(function(){ URL.revokeObjectURL(url); }, 100);
}

function importBackup(){
  $("importFile").click();
}

// ============================================================================
// SHARE
// ============================================================================
function shareResult(){
  if (!state.score || state.score.score === null){ toast("Run an assessment first", "warn"); return; }
  var text = "🌱 EcoGenesis AI\n\nScore: " + state.score.score + "/100\nEmissions: " +
    fmt(state.emissions.total, 1) + " kg CO2e/month\nLevel " + xp.level + " · " + achievements.length + " achievements";
  if (navigator.clipboard){
    navigator.clipboard.writeText(text).then(function(){ toast("Copied ✓"); })
      .catch(fallbackCopy.bind(null, text));
  } else fallbackCopy(text);
}
function fallbackCopy(text){
  var ta = document.createElement("textarea");
  ta.value = text; ta.style.position = "fixed"; ta.style.opacity = "0";
  document.body.appendChild(ta); ta.select();
  try { document.execCommand("copy"); toast("Copied ✓"); } catch(e){}
  document.body.removeChild(ta);
}

// ============================================================================
// THEME / LANG / SOUND
// ============================================================================
function toggleDark(){
  var cur = document.documentElement.getAttribute("data-theme");
  var next = cur === "dark" ? "light" : "dark";
  document.documentElement.setAttribute("data-theme", next);
  try { localStorage.setItem(THEME_KEY, next); } catch(e){}
  playSound(440, 0.08);
}
function toggleLang(){
  lang = lang === "en" ? "pt" : "en";
  try { localStorage.setItem(LANG_KEY, lang); } catch(e){}
  $("btnLang").textContent = lang.toUpperCase();
  toast(lang === "pt" ? "Português" : "English");
}
function toggleSound(){
  soundOn = !soundOn;
  $("btnSound").classList.toggle("on", soundOn);
  try { localStorage.setItem(SOUND_KEY, soundOn ? "on" : "off"); } catch(e){}
  if (soundOn) playSound(700, 0.1);
  toast(soundOn ? "Sound on" : "Sound off");
}

// ============================================================================
// ONBOARDING
// ============================================================================
function closeOnboarding(){
  $("onboarding").classList.remove("show");
  try { localStorage.setItem("ecogenesis_onboarded", "1"); } catch(e){}
}
function startOnboarding(){ closeOnboarding(); switchTab("assess"); }
function showOnboardingIfNeeded(){
  try {
    if (!localStorage.getItem("ecogenesis_onboarded")){
      setTimeout(function(){ $("onboarding").classList.add("show"); }, 400);
    }
  } catch(e){}
}

// ============================================================================
// COMMAND PALETTE
// ============================================================================
var paletteActions = [
  { id: "assess", label: "Go to Assess tab", kbd: "2", fn: function(){ switchTab("assess"); } },
  { id: "results", label: "Go to Results", kbd: "3", fn: function(){ switchTab("results"); } },
  { id: "gaia", label: "Chat with GAIA", fn: function(){ switchTab("gaia"); } },
  { id: "insights", label: "View Insights", fn: function(){ switchTab("insights"); } },
  { id: "goals", label: "Manage Goals", fn: function(){ switchTab("goals"); } },
  { id: "compare", label: "Compare with benchmarks", fn: function(){ switchTab("compare"); } },
  { id: "method", label: "View Methodology", fn: function(){ switchTab("method"); } },
  { id: "demo", label: "Load demo data", fn: loadDemo },
  { id: "reset", label: "Reset all data", fn: resetAll },
  { id: "dark", label: "Toggle dark mode", kbd: "⌘D", fn: toggleDark },
  { id: "lang", label: "Toggle language", fn: toggleLang },
  { id: "sound", label: "Toggle sound", fn: toggleSound },
  { id: "export-csv", label: "Export CSV", fn: exportCSV },
  { id: "export-json", label: "Export JSON", fn: exportJSON },
  { id: "import", label: "Import backup", fn: importBackup },
  { id: "print", label: "Print report", fn: function(){ window.print(); } },
  { id: "share", label: "Share result", fn: shareResult },
  { id: "clear-chat", label: "Clear GAIA chat", fn: clearChat },
  { id: "predict", label: "Ask GAIA to predict", fn: function(){ switchTab("gaia"); chatSend("Predict next month"); } },
  { id: "tip", label: "Ask GAIA for a tip", fn: function(){ switchTab("gaia"); chatSend("Give me a tip"); } }
];
var paletteSelected = 0;
var paletteFiltered = paletteActions;

function openPalette(){
  $("paletteModal").classList.add("show");
  $("paletteInput").value = "";
  $("paletteInput").focus();
  renderPalette("");
}
function closePalette(){ $("paletteModal").classList.remove("show"); }
function renderPalette(query){
  query = (query || "").toLowerCase();
  paletteFiltered = paletteActions.filter(function(a){
    return a.label.toLowerCase().indexOf(query) >= 0 || a.id.indexOf(query) >= 0;
  });
  paletteSelected = 0;
  var el = $("paletteList"); if (!el) return;
  if (!paletteFiltered.length){
    el.innerHTML = '<div style="padding:20px;text-align:center;color:var(--muted);font-size:.85rem">No commands found</div>';
    return;
  }
  el.innerHTML = paletteFiltered.map(function(a, i){
    return '<div class="palette-item ' + (i === paletteSelected ? 'selected' : '') + '" data-idx="' + i + '">' +
      '<div class="icon">→</div><div class="label">' + a.label + '</div>' +
      (a.kbd ? '<div class="kbd">' + a.kbd + '</div>' : '') + '</div>';
  }).join("");
  el.querySelectorAll(".palette-item").forEach(function(item){
    item.addEventListener("click", function(){
      var idx = parseInt(item.getAttribute("data-idx"), 10);
      runPaletteAction(idx);
    });
  });
}
function runPaletteAction(idx){
  var action = paletteFiltered[idx];
  if (!action) return;
  closePalette();
  setTimeout(action.fn, 50);
}

// ============================================================================
// SESSION FOOTER
// ============================================================================
function updateSessionFooter(){
  var elapsed = Math.floor((Date.now() - sessionStart) / 1000);
  var mins = Math.floor(elapsed / 60);
  var secs = elapsed % 60;
  $("sessionTime").textContent = (mins ? mins + "m " : "") + secs + "s";
  var globalTons = Math.floor(elapsed * 1270);
  $("globalCo2").textContent = globalTons.toLocaleString("en-US");
  $("sessionAssess").textContent = sessionAssessments;
}

// ============================================================================
// WIRE UP
// ============================================================================
$("btnDark").addEventListener("click", toggleDark);
$("btnShare").addEventListener("click", shareResult);
$("btnReset").addEventListener("click", resetAll);
$("btnLang").addEventListener("click", toggleLang);
$("btnSound").addEventListener("click", toggleSound);
$("btnPalette").addEventListener("click", openPalette);

document.addEventListener("keydown", function(e){
  if ((e.ctrlKey || e.metaKey) && e.key === "k"){ e.preventDefault(); openPalette(); }
  if ((e.ctrlKey || e.metaKey) && e.key === "d"){ e.preventDefault(); toggleDark(); }
  if (e.key === "Escape"){ closePalette(); closeOnboarding(); }
  if ($("paletteModal").classList.contains("show")){
    if (e.key === "ArrowDown"){ e.preventDefault(); paletteSelected = Math.min(paletteSelected + 1, paletteFiltered.length - 1); renderPalette($("paletteInput").value); }
    if (e.key === "ArrowUp"){ e.preventDefault(); paletteSelected = Math.max(0, paletteSelected - 1); renderPalette($("paletteInput").value); }
    if (e.key === "Enter"){ e.preventDefault(); runPaletteAction(paletteSelected); }
  }
});

$("paletteInput").addEventListener("input", function(){ renderPalette(this.value); });
$("paletteModal").addEventListener("click", function(e){ if (e.target === this) closePalette(); });

// Chat input
$("chatSend").addEventListener("click", function(){ chatSend(); });
$("chatInput").addEventListener("keypress", function(e){
  if (e.key === "Enter"){ e.preventDefault(); chatSend(); }
});

// Voice input (Web Speech API)
var recognition = null;
$("chatMic").addEventListener("click", function(){
  var btn = $("chatMic");
  var SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (!SR){ toast("Voice not supported on this browser", "warn"); return; }
  if (!recognition){
    recognition = new SR();
    recognition.lang = lang === "pt" ? "pt-BR" : "en-US";
    recognition.continuous = false;
    recognition.interimResults = false;
    recognition.onresult = function(e){
      var text = e.results[0][0].transcript;
      $("chatInput").value = text;
      btn.classList.remove("recording");
      chatSend();
    };
    recognition.onerror = function(){ btn.classList.remove("recording"); toast("Voice error", "warn"); };
    recognition.onend = function(){ btn.classList.remove("recording"); };
  }
  if (btn.classList.contains("recording")){
    recognition.stop();
    btn.classList.remove("recording");
  } else {
    try { recognition.start(); btn.classList.add("recording"); toast("Listening..."); }
    catch(e){ btn.classList.remove("recording"); }
  }
});

// Import file
$("importFile").addEventListener("change", function(e){
  var file = e.target.files[0]; if (!file) return;
  var reader = new FileReader();
  reader.onload = function(ev){
    try {
      var data = JSON.parse(ev.target.result);
      if (data.inputs) state.inputs = data.inputs;
      if (data.emissions) state.emissions = data.emissions;
      if (data.score) state.score = data.score;
      if (data.recommendations) state.recommendations = data.recommendations;
      if (data.goals) state.goals = data.goals;
      if (data.achievements) achievements = data.achievements;
      if (data.history) state.history = data.history;
      if (data.xp) xp = data.xp;
      if (state.history.length >= 2) NeuralPredictor.train(state.history, 150);
      save();
      renderResults(); renderGoals(); renderInsights(); renderCompare(); renderHeatmap();
      updateXPWidget();
      toast("Backup imported ✓");
    } catch(err){ toast("Invalid file", "danger"); }
  };
  reader.readAsText(file);
});

// ============================================================================
// INIT
// ============================================================================
load();
updateXPWidget();
$("btnLang").textContent = lang.toUpperCase();
$("btnSound").classList.toggle("on", soundOn);

if (state.inputs){
  var s = state.inputs;
  if (s.electricity_kwh != null) $("inEnergy").value = s.electricity_kwh;
  if (s.water_liters != null) $("inWater").value = s.water_liters;
  if (s.waste_kg != null) $("inWaste").value = s.waste_kg;
  if (s.waste_diverted_kg != null) $("inDiverted").value = s.waste_diverted_kg;
  if (s.transport_km != null) $("inTransport").value = s.transport_km;
  if (s.household_size) $("inHousehold").value = s.household_size;
}
if (state.history.length >= 2) NeuralPredictor.train(state.history, 150);

initParticles();
initCursorGlow();
renderResults();
renderGoals();
renderInsights();
renderCompare();
renderChat();
renderChallenges();
renderHeatmap();
renderNeuralPanel();
showOnboardingIfNeeded();
updateSessionFooter();
setInterval(updateSessionFooter, 1000);

// Expose globals for inline handlers
window.switchTab = switchTab;
window.calculate = calculate;
window.loadDemo = loadDemo;
window.clearForm = clearForm;
window.resetAll = resetAll;
window.addGoal = addGoal;
window.advanceGoal = advanceGoal;
window.deleteGoal = deleteGoal;
window.applyGoalTemplate = applyGoalTemplate;
window.exportCSV = exportCSV;
window.exportJSON = exportJSON;
window.importBackup = importBackup;
window.setRecFilter = setRecFilter;
window.closeOnboarding = closeOnboarding;
window.startOnboarding = startOnboarding;
window.chatSend = chatSend;
window.clearChat = clearChat;
window.renderChallenges = renderChallenges;
window.completeChallenge = completeChallenge;

})();
</script>
</body>
</html>
