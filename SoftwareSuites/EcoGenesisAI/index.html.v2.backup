<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#0f766e">
<title>EcoGenesis AI — Sustainability Intelligence</title>
<style>
:root{
  --teal:#0f766e; --teal-dark:#134e4a; --teal-light:#14b8a6;
  --mint:#86efac; --amber:#f59e0b; --amber-soft:#fef3c7;
  --bg:#f8faf9; --surface:#ffffff; --surface-2:#f0fdf4;
  --text:#0f172a; --muted:#64748b; --border:#e2e8f0;
  --danger:#dc2626; --danger-soft:#fee2e2;
  --shadow-sm:0 1px 2px rgba(15,118,110,.06);
  --shadow:0 4px 16px rgba(15,118,110,.08);
  --shadow-lg:0 20px 48px rgba(15,118,110,.14);
  --r:14px; --r-sm:10px;
  --transition:200ms cubic-bezier(.4,0,.2,1);
}
[data-theme="dark"]{
  --bg:#0a1210; --surface:#121f1a; --surface-2:#0f1a16;
  --text:#e8f0ed; --muted:#94a3b8; --border:#1e2f28;
  --teal:#14b8a6; --teal-dark:#0f766e; --teal-light:#2dd4bf;
  --mint:#4ade80; --amber:#fbbf24; --amber-soft:#3f2a0a;
  --shadow-sm:0 1px 2px rgba(0,0,0,.3);
  --shadow:0 4px 16px rgba(0,0,0,.35);
  --shadow-lg:0 20px 48px rgba(0,0,0,.5);
  --danger:#f87171; --danger-soft:#3f1a1a;
}
*{box-sizing:border-box;margin:0;padding:0}
html{font-size:16px;-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{
  font-family:'Inter',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
  background:var(--bg);color:var(--text);line-height:1.6;min-height:100vh;
  transition:background var(--transition),color var(--transition);
  -webkit-font-smoothing:antialiased;
}
a{color:var(--teal);text-decoration:none}
button{font:inherit;cursor:pointer;border:none;background:none;color:inherit}
:focus-visible{outline:2px solid var(--teal-light);outline-offset:2px;border-radius:6px}

/* Header */
header{
  background:color-mix(in srgb, var(--surface) 92%, transparent);
  backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);
  border-bottom:1px solid var(--border);
  padding:14px 20px;position:sticky;top:0;z-index:50;
  display:flex;align-items:center;justify-content:space-between;gap:12px;
}
.brand{display:flex;align-items:center;gap:10px}
.brand-mark{
  width:40px;height:40px;border-radius:12px;
  background:linear-gradient(135deg,var(--teal),var(--mint));
  display:flex;align-items:center;justify-content:center;
  box-shadow:var(--shadow-sm);flex-shrink:0;
}
.brand-mark svg{width:24px;height:24px;fill:#fff}
.brand-name{font-size:1.05rem;font-weight:800;letter-spacing:-.02em}
.brand-tag{font-size:.72rem;color:var(--muted);font-weight:500}
.header-actions{display:flex;gap:6px;align-items:center}
.icon-btn{
  width:38px;height:38px;border-radius:10px;
  display:flex;align-items:center;justify-content:center;
  background:var(--surface-2);border:1px solid var(--border);
  transition:all var(--transition);
}
.icon-btn:hover{background:var(--teal);color:#fff;border-color:var(--teal);transform:translateY(-1px)}
.icon-btn svg{width:18px;height:18px;fill:currentColor}

/* Nav */
nav{
  background:var(--surface);border-bottom:1px solid var(--border);
  padding:6px 12px;display:flex;gap:2px;overflow-x:auto;
  scrollbar-width:none;position:sticky;top:69px;z-index:40;
}
nav::-webkit-scrollbar{display:none}
.tab-btn{
  padding:9px 16px;font-size:.85rem;font-weight:600;color:var(--muted);
  border-radius:8px;white-space:nowrap;transition:all var(--transition);
}
.tab-btn:hover{background:var(--surface-2);color:var(--text)}
.tab-btn.active{background:var(--teal);color:#fff}

main{max-width:1080px;margin:0 auto;padding:24px 16px 60px}
.tab-panel{display:none;animation:fadeUp .35s ease}
.tab-panel.active{display:block}
@keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}

/* Hero */
.hero{
  background:
    radial-gradient(ellipse 80% 60% at 15% 20%, rgba(20,184,166,.5), transparent 60%),
    radial-gradient(ellipse 80% 60% at 85% 80%, rgba(245,158,11,.35), transparent 60%),
    linear-gradient(135deg, #0f766e 0%, #134e4a 100%);
  border-radius:24px;padding:56px 32px 48px;
  color:#fff;position:relative;overflow:hidden;margin-bottom:24px;
}
.hero::before{
  content:'';position:absolute;inset:0;
  background:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='60' height='60' viewBox='0 0 60 60'><circle cx='30' cy='30' r='1' fill='white' opacity='.15'/></svg>");
  opacity:.5;pointer-events:none;
}
.hero-eyebrow{
  display:inline-flex;align-items:center;gap:6px;
  background:rgba(255,255,255,.15);backdrop-filter:blur(8px);
  padding:6px 14px;border-radius:999px;font-size:.75rem;
  font-weight:600;letter-spacing:.02em;margin-bottom:20px;
  position:relative;
}
.hero-eyebrow .dot{width:6px;height:6px;background:var(--mint);border-radius:50%;animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(1.3)}}
.hero h1{
  font-size:clamp(1.8rem, 5vw, 2.8rem);font-weight:800;
  letter-spacing:-.03em;line-height:1.1;margin-bottom:14px;
  position:relative;max-width:640px;
}
.hero h1 em{color:var(--mint);font-style:normal}
.hero p{
  font-size:1.02rem;opacity:.92;margin-bottom:28px;
  max-width:520px;position:relative;
}
.hero-actions{display:flex;gap:10px;flex-wrap:wrap;position:relative}
.hero .btn{
  padding:13px 26px;font-size:.92rem;font-weight:700;
  border-radius:12px;transition:all var(--transition);
}
.hero .btn-primary{background:#fff;color:var(--teal-dark)}
.hero .btn-primary:hover{transform:translateY(-2px);box-shadow:0 12px 28px rgba(0,0,0,.25)}
.hero .btn-ghost{background:rgba(255,255,255,.15);color:#fff;border:1px solid rgba(255,255,255,.3)}
.hero .btn-ghost:hover{background:rgba(255,255,255,.25);transform:translateY(-2px)}

/* Trust strip */
.trust-strip{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
  gap:12px;margin-bottom:24px;
}
.trust-item{
  background:var(--surface);border:1px solid var(--border);border-radius:var(--r);
  padding:16px;display:flex;gap:12px;align-items:flex-start;
  transition:all var(--transition);
}
.trust-item:hover{transform:translateY(-2px);box-shadow:var(--shadow)}
.trust-icon{
  width:36px;height:36px;border-radius:10px;background:var(--surface-2);
  display:flex;align-items:center;justify-content:center;flex-shrink:0;
  color:var(--teal);
}
.trust-icon svg{width:18px;height:18px;fill:currentColor}
.trust-item h4{font-size:.88rem;font-weight:700;margin-bottom:2px}
.trust-item p{font-size:.78rem;color:var(--muted);line-height:1.4}

/* Cards */
.card{
  background:var(--surface);border:1px solid var(--border);border-radius:var(--r);
  padding:20px;box-shadow:var(--shadow-sm);margin-bottom:16px;
  transition:box-shadow var(--transition);
}
.card-title{
  font-size:.78rem;font-weight:700;color:var(--muted);
  text-transform:uppercase;letter-spacing:.08em;margin-bottom:14px;
}

/* Alerts */
.alert{
  padding:14px 16px;border-radius:var(--r-sm);font-size:.85rem;
  margin-bottom:16px;display:flex;gap:10px;align-items:flex-start;
}
.alert svg{width:20px;height:20px;flex-shrink:0;fill:currentColor}
.alert-warn{background:var(--amber-soft);color:#78350f;border-left:3px solid var(--amber)}
.alert-info{background:var(--surface-2);color:var(--teal-dark);border-left:3px solid var(--teal)}
[data-theme="dark"] .alert-warn{color:#fbbf24}

/* Grid */
.grid{display:grid;gap:14px}
.grid-2{grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}
.grid-3{grid-template-columns:repeat(auto-fit,minmax(160px,1fr))}
.grid-4{grid-template-columns:repeat(auto-fit,minmax(150px,1fr))}

/* Form */
.form-field{display:flex;flex-direction:column;gap:6px}
.form-field label{
  font-size:.82rem;font-weight:600;color:var(--text);
  display:flex;align-items:center;gap:6px;
}
.form-field label .field-icon{
  width:22px;height:22px;background:var(--surface-2);border-radius:6px;
  display:inline-flex;align-items:center;justify-content:center;
  color:var(--teal);flex-shrink:0;
}
.form-field label .field-icon svg{width:12px;height:12px;fill:currentColor}
.form-field .hint{font-size:.7rem;color:var(--muted)}
.form-field input{
  padding:11px 14px;border:1.5px solid var(--border);border-radius:var(--r-sm);
  font:inherit;font-size:.92rem;background:var(--surface);color:var(--text);
  transition:all var(--transition);width:100%;
}
.form-field input:focus{
  outline:none;border-color:var(--teal);
  box-shadow:0 0 0 3px color-mix(in srgb, var(--teal) 15%, transparent);
}
.form-field input.invalid{border-color:var(--danger);background:var(--danger-soft)}

/* Buttons */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:6px;
  padding:11px 20px;border-radius:var(--r-sm);font-weight:600;font-size:.88rem;
  transition:all var(--transition);white-space:nowrap;
}
.btn-primary{background:var(--teal);color:#fff}
.btn-primary:hover{background:var(--teal-dark);transform:translateY(-1px);box-shadow:var(--shadow)}
.btn-secondary{background:var(--surface-2);color:var(--teal);border:1px solid var(--border)}
.btn-secondary:hover{background:var(--teal);color:#fff;border-color:var(--teal)}
.btn-ghost{color:var(--muted);border:1px solid var(--border)}
.btn-ghost:hover{color:var(--text);background:var(--surface-2)}
.btn-danger{background:var(--danger-soft);color:var(--danger)}
.btn-danger:hover{background:var(--danger);color:#fff}
.btn-sm{padding:6px 12px;font-size:.78rem}

/* Metric card */
.metric{
  background:var(--surface);border:1px solid var(--border);border-radius:var(--r);
  padding:16px;position:relative;transition:all var(--transition);
}
.metric:hover{box-shadow:var(--shadow);transform:translateY(-2px)}
.metric-label{font-size:.72rem;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;font-weight:700}
.metric-value{font-size:1.55rem;font-weight:800;color:var(--teal);margin:6px 0 2px;letter-spacing:-.02em}
.metric-unit{font-size:.72rem;color:var(--muted)}
.metric-icon{
  position:absolute;top:14px;right:14px;width:34px;height:34px;
  border-radius:10px;background:var(--surface-2);
  display:flex;align-items:center;justify-content:center;color:var(--teal);
}
.metric-icon svg{width:16px;height:16px;fill:currentColor}

/* Score ring */
.score-ring-wrap{
  display:flex;flex-direction:column;align-items:center;
  padding:24px 12px;position:relative;
}
.score-ring{width:220px;height:220px;position:relative}
.score-ring svg{width:100%;height:100%;transform:rotate(-90deg)}
.score-ring-bg{fill:none;stroke:var(--surface-2);stroke-width:16}
.score-ring-fg{
  fill:none;stroke:url(#ringGrad);stroke-width:16;stroke-linecap:round;
  transition:stroke-dasharray 1.2s cubic-bezier(.4,0,.2,1);
}
.score-value{
  position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
  font-size:3.2rem;font-weight:800;letter-spacing:-.04em;
  background:linear-gradient(135deg,var(--teal),var(--teal-light));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
  background-clip:text;
}
.score-value small{font-size:1rem;color:var(--muted);-webkit-text-fill-color:var(--muted)}
.score-note{
  margin-top:12px;font-size:.82rem;color:var(--muted);text-align:center;max-width:280px;
}
.score-badge{
  margin-top:12px;padding:5px 14px;border-radius:999px;font-size:.75rem;
  font-weight:700;text-transform:uppercase;letter-spacing:.04em;
}
.score-badge.good{background:#d1fae5;color:#065f46}
.score-badge.ok{background:var(--amber-soft);color:#92400e}
.score-badge.poor{background:var(--danger-soft);color:var(--danger)}

/* Donut chart */
.donut-wrap{display:flex;gap:20px;align-items:center;flex-wrap:wrap}
.donut{width:180px;height:180px;flex-shrink:0}
.donut-legend{flex:1;min-width:160px;display:flex;flex-direction:column;gap:10px}
.legend-item{display:flex;align-items:center;gap:10px;font-size:.85rem}
.legend-dot{width:12px;height:12px;border-radius:4px;flex-shrink:0}
.legend-label{flex:1;color:var(--text)}
.legend-val{font-weight:700;color:var(--teal)}

/* Impact equivalents */
.equivalent{
  background:linear-gradient(135deg,var(--surface-2),var(--surface));
  border:1px solid var(--border);border-radius:var(--r);
  padding:16px;text-align:center;transition:all var(--transition);
}
.equivalent:hover{transform:translateY(-3px);box-shadow:var(--shadow)}
.equivalent-icon{font-size:1.8rem;margin-bottom:6px;display:block}
.equivalent-value{font-size:1.4rem;font-weight:800;color:var(--teal);letter-spacing:-.02em}
.equivalent-label{font-size:.75rem;color:var(--muted);margin-top:2px;line-height:1.35}

/* What-if simulator */
.sim-slider-row{display:flex;flex-direction:column;gap:6px;margin-bottom:16px}
.sim-slider-row .sim-header{display:flex;justify-content:space-between;align-items:baseline}
.sim-slider-row label{font-size:.85rem;font-weight:600}
.sim-slider-row .sim-value{
  font-size:.88rem;font-weight:700;color:var(--teal);
  background:var(--surface-2);padding:2px 10px;border-radius:999px;
}
input[type=range]{
  -webkit-appearance:none;appearance:none;width:100%;height:6px;
  border-radius:3px;background:var(--surface-2);outline:none;cursor:pointer;
}
input[type=range]::-webkit-slider-thumb{
  -webkit-appearance:none;width:22px;height:22px;border-radius:50%;
  background:var(--teal);border:3px solid var(--surface);
  box-shadow:var(--shadow);cursor:pointer;transition:transform var(--transition);
}
input[type=range]::-webkit-slider-thumb:hover{transform:scale(1.15)}
input[type=range]::-moz-range-thumb{
  width:22px;height:22px;border-radius:50%;background:var(--teal);
  border:3px solid var(--surface);cursor:pointer;
}
.sim-result{
  background:linear-gradient(135deg,var(--teal),var(--teal-dark));
  color:#fff;border-radius:var(--r);padding:20px;margin-top:14px;
  display:grid;grid-template-columns:1fr 1fr;gap:16px;
}
.sim-result-item{text-align:center}
.sim-result-item .v{font-size:1.5rem;font-weight:800;letter-spacing:-.02em}
.sim-result-item .l{font-size:.72rem;opacity:.85;margin-top:2px;text-transform:uppercase;letter-spacing:.04em}

/* Recommendations */
.rec{
  background:var(--surface);border:1px solid var(--border);border-radius:var(--r);
  padding:18px;margin-bottom:12px;position:relative;overflow:hidden;
  transition:all var(--transition);border-left:4px solid var(--teal);
}
.rec:hover{transform:translateY(-2px);box-shadow:var(--shadow)}
.rec.priority-high{border-left-color:var(--danger)}
.rec.priority-medium{border-left-color:var(--amber)}
.rec.priority-low{border-left-color:var(--teal-light)}
.rec-header{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:8px}
.rec-title{font-size:.98rem;font-weight:700;color:var(--text);flex:1}
.rec-badge{
  padding:3px 10px;border-radius:999px;font-size:.68rem;font-weight:700;
  text-transform:uppercase;letter-spacing:.04em;flex-shrink:0;
}
.rec-badge.high{background:var(--danger-soft);color:var(--danger)}
.rec-badge.medium{background:var(--amber-soft);color:#92400e}
.rec-badge.low{background:#d1fae5;color:#065f46}
[data-theme="dark"] .rec-badge.low{color:#86efac}
.rec-desc{font-size:.87rem;color:var(--text);margin-bottom:10px}
.rec-why{
  background:var(--surface-2);padding:10px 12px;border-radius:var(--r-sm);
  font-size:.82rem;color:var(--muted);font-style:italic;margin-bottom:10px;
}
.rec-meta{display:flex;gap:16px;flex-wrap:wrap;font-size:.78rem;color:var(--muted)}
.rec-meta strong{color:var(--text);font-weight:600}

/* Achievement */
.achievements{display:flex;gap:10px;flex-wrap:wrap;margin-top:8px}
.achievement{
  display:flex;align-items:center;gap:8px;padding:8px 14px;
  background:linear-gradient(135deg,#fef3c7,#fde68a);color:#78350f;
  border-radius:999px;font-size:.78rem;font-weight:700;
  animation:pop .5s ease;
}
[data-theme="dark"] .achievement{background:linear-gradient(135deg,#3f2a0a,#5c3d0a);color:#fbbf24}
.achievement .em{font-size:1rem}
@keyframes pop{0%{transform:scale(.5);opacity:0}70%{transform:scale(1.05)}100%{transform:scale(1);opacity:1}}

/* Goal */
.goal{
  background:var(--surface);border:1px solid var(--border);border-radius:var(--r-sm);
  padding:14px;margin-bottom:10px;transition:all var(--transition);
}
.goal:hover{box-shadow:var(--shadow-sm)}
.goal.overdue{border-color:var(--danger)}
.goal-header{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:8px;flex-wrap:wrap}
.goal-title{font-weight:700;font-size:.92rem;flex:1;min-width:150px}
.goal-actions{display:flex;gap:6px}
.progress-track{height:8px;background:var(--surface-2);border-radius:999px;overflow:hidden;margin:10px 0 6px}
.progress-fill{
  height:100%;background:linear-gradient(90deg,var(--teal),var(--teal-light));
  border-radius:999px;transition:width .5s ease;
}
.goal-meta{display:flex;justify-content:space-between;font-size:.75rem;color:var(--muted);flex-wrap:wrap;gap:6px}

/* Table */
table.data{width:100%;border-collapse:collapse;font-size:.85rem}
table.data th{
  text-align:left;padding:10px 8px;font-size:.72rem;font-weight:700;
  text-transform:uppercase;letter-spacing:.05em;color:var(--muted);
  border-bottom:2px solid var(--border);
}
table.data td{padding:10px 8px;border-bottom:1px solid var(--border)}
table.data .num{text-align:right;font-variant-numeric:tabular-nums}
table.data tr:last-child td{border-bottom:none}

/* Empty */
.empty{text-align:center;padding:48px 20px;color:var(--muted)}
.empty svg{width:56px;height:56px;fill:var(--border);margin-bottom:12px}
.empty p{font-size:.9rem;margin-bottom:16px}

/* Toast */
#toast{
  position:fixed;bottom:24px;left:50%;
  transform:translateX(-50%) translateY(120px);
  background:var(--text);color:var(--surface);
  padding:12px 22px;border-radius:var(--r-sm);
  font-size:.88rem;font-weight:600;z-index:100;
  box-shadow:var(--shadow-lg);opacity:0;
  transition:all .3s cubic-bezier(.4,0,.2,1);pointer-events:none;
  max-width:90vw;
}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* Utility */
.row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.mt-2{margin-top:12px}.mt-3{margin-top:20px}.mb-2{margin-bottom:12px}
.text-muted{color:var(--muted)}
.tabular{font-variant-numeric:tabular-nums}

/* Responsive */
@media (max-width:640px){
  main{padding:16px 12px 40px}
  .hero{padding:36px 20px 32px;border-radius:20px}
  .hero h1{font-size:1.7rem}
  .hero p{font-size:.92rem}
  .hero .btn{padding:11px 18px;font-size:.85rem}
  nav{top:69px}
  .metric-value{font-size:1.3rem}
  .score-value{font-size:2.6rem}
  .sim-result{grid-template-columns:1fr}
  .donut-wrap{flex-direction:column;align-items:flex-start}
}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}
}
</style>
</head>
<body>

<header>
  <div class="brand">
    <div class="brand-mark">
      <svg viewBox="0 0 24 24"><path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75C7 8 17 8 17 8z"/></svg>
    </div>
    <div>
      <div class="brand-name">EcoGenesis AI</div>
      <div class="brand-tag">Sustainability Intelligence</div>
    </div>
  </div>
  <div class="header-actions">
    <button class="icon-btn" id="btnDark" aria-label="Toggle dark mode" title="Dark mode">
      <svg viewBox="0 0 24 24"><path d="M12 3a9 9 0 109 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 01-4.4 2.26 5.403 5.403 0 01-3.14-9.8c-.44-.06-.9-.1-1.36-.1z"/></svg>
    </button>
    <button class="icon-btn" id="btnShare" aria-label="Share result" title="Share">
      <svg viewBox="0 0 24 24"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92z"/></svg>
    </button>
    <button class="icon-btn" id="btnReset" aria-label="Reset all data" title="Reset">
      <svg viewBox="0 0 24 24"><path d="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/></svg>
    </button>
  </div>
</header>

<nav id="nav">
  <button class="tab-btn active" data-tab="overview">Overview</button>
  <button class="tab-btn" data-tab="assess">Assess</button>
  <button class="tab-btn" data-tab="results">Results</button>
  <button class="tab-btn" data-tab="goals">Action Plan</button>
  <button class="tab-btn" data-tab="method">Methodology</button>
</nav>

<main>

<!-- ============ OVERVIEW ============ -->
<section id="overview" class="tab-panel active">
  <div class="hero">
    <div class="hero-eyebrow"><span class="dot"></span> Sustain-a-thon 2.0 · Offline · Zero tracking</div>
    <h1>Turn awareness into <em>measurable</em> impact.</h1>
    <p>Assess your household footprint in 60 seconds, get input-driven recommendations, and track goals — all privately, right in your browser.</p>
    <div class="hero-actions">
      <button class="btn btn-primary" onclick="switchTab('assess')">Start Assessment →</button>
      <button class="btn btn-ghost" onclick="loadDemo()">Try with demo data</button>
    </div>
  </div>

  <div class="trust-strip">
    <div class="trust-item">
      <div class="trust-icon"><svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg></div>
      <div><h4>100% offline</h4><p>No network. No accounts. No telemetry.</p></div>
    </div>
    <div class="trust-item">
      <div class="trust-icon"><svg viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg></div>
      <div><h4>Transparent math</h4><p>Every formula and factor documented.</p></div>
    </div>
    <div class="trust-item">
      <div class="trust-icon"><svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg></div>
      <div><h4>Actionable output</h4><p>Recommendations tied to your actual numbers.</p></div>
    </div>
  </div>

  <div class="card">
    <div class="card-title">Why it matters</div>
    <div class="grid grid-3">
      <div>
        <div style="font-size:1.8rem;font-weight:800;color:var(--teal);letter-spacing:-.02em">~70%</div>
        <p class="text-muted" style="font-size:.82rem;margin-top:4px">of global GHG emissions come from household consumption.</p>
      </div>
      <div>
        <div style="font-size:1.8rem;font-weight:800;color:var(--teal);letter-spacing:-.02em">5-15%</div>
        <p class="text-muted" style="font-size:.82rem;margin-top:4px">typical reduction unlocked by regular consumption tracking.</p>
      </div>
      <div>
        <div style="font-size:1.8rem;font-weight:800;color:var(--teal);letter-spacing:-.02em">60s</div>
        <p class="text-muted" style="font-size:.82rem;margin-top:4px">to complete your first assessment and see your score.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ ASSESS ============ -->
<section id="assess" class="tab-panel">
  <h2 style="font-size:1.4rem;font-weight:800;letter-spacing:-.02em;margin-bottom:6px">Environmental Assessment</h2>
  <p class="text-muted" style="font-size:.9rem;margin-bottom:20px">Enter monthly consumption. Leave fields blank if unknown — the app adapts.</p>

  <div class="alert alert-warn">
    <svg viewBox="0 0 24 24"><path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/></svg>
    <div><strong>Estimates only.</strong> Emission factors below are demo values — not verified scientific constants.</div>
  </div>

  <div class="card">
    <div class="grid grid-2">
      <div class="form-field">
        <label for="inEnergy"><span class="field-icon"><svg viewBox="0 0 24 24"><path d="M7 2v11h3v9l7-12h-4l4-8z"/></svg></span>Electricity</label>
        <span class="hint">kWh per month (check your bill)</span>
        <input type="number" id="inEnergy" min="0" step="0.01" placeholder="450" inputmode="decimal">
      </div>
      <div class="form-field">
        <label for="inWater"><span class="field-icon"><svg viewBox="0 0 24 24"><path d="M12 2c-4 4-8 8-8 12a8 8 0 0016 0c0-4-4-8-8-12z"/></svg></span>Water</label>
        <span class="hint">liters per month (1 m³ = 1000 L)</span>
        <input type="number" id="inWater" min="0" step="0.01" placeholder="12000" inputmode="decimal">
      </div>
      <div class="form-field">
        <label for="inWaste"><span class="field-icon"><svg viewBox="0 0 24 24"><path d="M3 6h18v2H3V6zm2 4h14v12H5V10zm3 2v8h2v-8H8zm4 0v8h2v-8h-2z"/></svg></span>Total waste</label>
        <span class="hint">kg per month (bin volume × pickups)</span>
        <input type="number" id="inWaste" min="0" step="0.01" placeholder="60" inputmode="decimal">
      </div>
      <div class="form-field">
        <label for="inDiverted"><span class="field-icon"><svg viewBox="0 0 24 24"><path d="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46A7.93 7.93 0 0020 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74A7.93 7.93 0 004 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z"/></svg></span>Waste diverted</label>
        <span class="hint">kg recycled or composted</span>
        <input type="number" id="inDiverted" min="0" step="0.01" placeholder="15" inputmode="decimal">
      </div>
      <div class="form-field">
        <label for="inTransport"><span class="field-icon"><svg viewBox="0 0 24 24"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"/></svg></span>Transport</label>
        <span class="hint">km per month (personal vehicle)</span>
        <input type="number" id="inTransport" min="0" step="0.01" placeholder="800" inputmode="decimal">
      </div>
      <div class="form-field">
        <label for="inHousehold"><span class="field-icon"><svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg></span>Household size *</label>
        <span class="hint">Number of residents</span>
        <input type="number" id="inHousehold" min="1" max="20" step="1" value="1" inputmode="numeric">
      </div>
    </div>

    <div id="errors" style="display:none;color:var(--danger);font-size:.85rem;font-weight:600;margin-top:14px;padding:12px;background:var(--danger-soft);border-radius:8px"></div>

    <div class="row mt-3">
      <button class="btn btn-primary" onclick="calculate()">
        <svg viewBox="0 0 24 24" style="width:16px;height:16px;fill:currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
        Calculate Assessment
      </button>
      <button class="btn btn-secondary" onclick="loadDemo()">Load Demo</button>
      <button class="btn btn-ghost" onclick="clearForm()">Clear</button>
    </div>
  </div>
</section>

<!-- ============ RESULTS ============ -->
<section id="results" class="tab-panel">
  <div id="resultsContent">
    <div class="empty">
      <svg viewBox="0 0 24 24"><path d="M3 13h2v8H3v-8zm4 0h2v8H7v-8zm4-6h2v14h-2V7zm4 4h2v10h-2V11zm4-8h2v18h-2V3z"/></svg>
      <p>No assessment yet.</p>
      <button class="btn btn-primary" onclick="switchTab('assess')">Start Assessment →</button>
    </div>
  </div>
</section>

<!-- ============ GOALS ============ -->
<section id="goals" class="tab-panel">
  <h2 style="font-size:1.4rem;font-weight:800;letter-spacing:-.02em;margin-bottom:6px">Action Plan</h2>
  <p class="text-muted" style="font-size:.9rem;margin-bottom:20px">Set measurable goals, track progress, stay accountable.</p>

  <div class="card">
    <div class="card-title">Create a new goal</div>
    <div class="grid grid-2">
      <div class="form-field">
        <label for="goalTitle">Goal title *</label>
        <input type="text" id="goalTitle" maxlength="120" placeholder="Reduce electricity by 15%">
      </div>
      <div class="form-field">
        <label for="goalTarget">Target value</label>
        <input type="number" id="goalTarget" min="0" step="0.01" placeholder="380">
      </div>
      <div class="form-field">
        <label for="goalUnit">Unit</label>
        <input type="text" id="goalUnit" maxlength="20" value="kWh">
      </div>
      <div class="form-field">
        <label for="goalDeadline">Deadline</label>
        <input type="date" id="goalDeadline">
      </div>
    </div>
    <div class="row mt-3">
      <button class="btn btn-primary" onclick="addGoal()">+ Add Goal</button>
      <button class="btn btn-secondary" onclick="exportCSV()">Export CSV</button>
      <button class="btn btn-secondary" onclick="exportJSON()">Export JSON</button>
    </div>
  </div>

  <div id="goalsList"></div>
</section>

<!-- ============ METHODOLOGY ============ -->
<section id="method" class="tab-panel">
  <h2 style="font-size:1.4rem;font-weight:800;letter-spacing:-.02em;margin-bottom:6px">Methodology & Transparency</h2>
  <p class="text-muted" style="font-size:.9rem;margin-bottom:20px">Every formula, every factor, every limitation — documented.</p>

  <div class="alert alert-warn">
    <svg viewBox="0 0 24 24"><path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/></svg>
    <div><strong>Scientific integrity.</strong> Emission factors are demo values, not universal constants. Real values vary up to 17× by region.</div>
  </div>

  <div class="card">
    <div class="card-title">Emission Formula</div>
    <pre style="background:var(--surface-2);padding:16px;border-radius:10px;font-size:.83rem;overflow-x:auto;font-family:'SF Mono',Menlo,monospace;color:var(--teal)">estimated_emissions = activity_value × emission_factor
total = Σ(activity × factor) across all categories</pre>
  </div>

  <div class="card">
    <div class="card-title">Factors Used (Demo Values)</div>
    <table class="data">
      <thead><tr><th>Category</th><th class="num">Factor</th><th>Unit</th><th>Confidence</th></tr></thead>
      <tbody>
        <tr><td>Electricity</td><td class="num">0.45</td><td>kg CO₂e/kWh</td><td><span class="rec-badge medium">Low</span></td></tr>
        <tr><td>Water</td><td class="num">0.0003</td><td>kg CO₂e/L</td><td><span class="rec-badge medium">Low</span></td></tr>
        <tr><td>Waste (landfill)</td><td class="num">0.5</td><td>kg CO₂e/kg</td><td><span class="rec-badge medium">Low</span></td></tr>
        <tr><td>Transport</td><td class="num">0.192</td><td>kg CO₂e/km</td><td><span class="rec-badge medium">Low</span></td></tr>
      </tbody>
    </table>
  </div>

  <div class="card">
    <div class="card-title">Sustainability Score</div>
    <pre style="background:var(--surface-2);padding:16px;border-radius:10px;font-size:.83rem;overflow-x:auto;font-family:'SF Mono',Menlo,monospace;color:var(--teal)">energy_score = clamp(100 - max(0, energy_pp - 150) × 0.15, 0, 100)
water_score  = clamp(100 - max(0, water_pp - 3000) × 0.008, 0, 100)
waste_score  = clamp(diversion × 100, 0, 100)
TOTAL = energy×0.35 + water×0.30 + waste×0.35 / available_weight</pre>
    <p class="text-muted" style="font-size:.83rem;margin-top:14px">
      Benchmarks (150 kWh/person/month, 3000 L/person/month) are illustrative, not official thresholds.
      Score is a custom indicator, not a certified rating.
    </p>
  </div>

  <div class="card">
    <div class="card-title">Limitations</div>
    <ul style="padding-left:20px;font-size:.9rem;line-height:1.9;color:var(--text)">
      <li>Factors are global averages — real regional values vary 10×+</li>
      <li>Water emissions only capture treatment + pumping energy</li>
      <li>Waste factor assumes 100% landfill for non-diverted portion</li>
      <li>Estimates ≠ verified measurements</li>
      <li>Data stored in browser localStorage — clearing browser erases it</li>
      <li>Zero network calls, zero tracking, zero accounts</li>
    </ul>
  </div>
</section>

</main>

<div id="toast" role="status" aria-live="polite"></div>

<script>
(function(){
"use strict";

// ============================================================================
// STATE & CONSTANTS
// ============================================================================
var FACTORS = {
  electricity: { rate: 0.45, label: "Electricity", color: "#0f766e" },
  water:       { rate: 0.0003, label: "Water",       color: "#0891b2" },
  waste:       { rate: 0.5, label: "Waste",          color: "#f59e0b" },
  transport:   { rate: 0.192, label: "Transport",    color: "#8b5cf6" }
};
var STORAGE_KEY = "ecogenesis_v2";
var ACHIEVEMENTS_KEY = "ecogenesis_achievements_v2";

var state = {
  inputs: null,
  emissions: null,
  score: null,
  recommendations: [],
  goals: [],
  isDemo: false,
  history: []  // snapshots of past assessments
};
var achievements = [];

// ============================================================================
// HELPERS
// ============================================================================
function $(id){ return document.getElementById(id); }
function esc(s){
  return String(s)
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#39;");
}
function fmt(n, d){
  if (n === null || n === undefined || !isFinite(n)) return "—";
  d = (typeof d === "number") ? d : 1;
  return Number(n).toLocaleString("en-US", {minimumFractionDigits:d, maximumFractionDigits:d});
}
function fmtInt(n){ return fmt(n, 0); }
function clamp(v, lo, hi){ return Math.max(lo, Math.min(hi, v)); }
function todayISO(){ return new Date().toISOString().slice(0, 10); }

function toast(msg, type){
  var t = $("toast");
  t.textContent = msg;
  if (type === "warn") t.style.background = "#92400e";
  else if (type === "danger") t.style.background = "#991b1b";
  else t.style.background = "";
  t.classList.add("show");
  clearTimeout(toast._t);
  toast._t = setTimeout(function(){ t.classList.remove("show"); }, 3000);
}

// ============================================================================
// PERSISTENCE
// ============================================================================
function save(){
  try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch(e){}
  try { localStorage.setItem(ACHIEVEMENTS_KEY, JSON.stringify(achievements)); } catch(e){}
}
function load(){
  try {
    var raw = localStorage.getItem(STORAGE_KEY);
    if (raw){
      var d = JSON.parse(raw);
      if (d && typeof d === "object"){
        state = {
          inputs: d.inputs || null,
          emissions: d.emissions || null,
          score: d.score || null,
          recommendations: d.recommendations || [],
          goals: d.goals || [],
          isDemo: !!d.isDemo,
          history: d.history || []
        };
      }
    }
  } catch(e){ console.warn("Storage corrupted:", e); }
  try {
    var a = localStorage.getItem(ACHIEVEMENTS_KEY);
    if (a) achievements = JSON.parse(a) || [];
  } catch(e){ achievements = []; }
}

// ============================================================================
// TAB SWITCHING
// ============================================================================
function switchTab(name){
  document.querySelectorAll(".tab-btn").forEach(function(b){
    b.classList.toggle("active", b.dataset.tab === name);
  });
  document.querySelectorAll(".tab-panel").forEach(function(p){
    p.classList.toggle("active", p.id === name);
  });
  window.scrollTo({ top: 0, behavior: "smooth" });
  if (name === "results") renderResults();
  if (name === "goals") renderGoals();
}
document.querySelectorAll(".tab-btn").forEach(function(b){
  b.addEventListener("click", function(){ switchTab(b.dataset.tab); });
});

// ============================================================================
// VALIDATION
// ============================================================================
function validate(inputs){
  var errs = [];
  var fields = [
    ["electricity_kwh", "Electricity"],
    ["water_liters", "Water"],
    ["waste_kg", "Waste"],
    ["waste_diverted_kg", "Diverted waste"],
    ["transport_km", "Transport"]
  ];
  fields.forEach(function(f){
    var v = inputs[f[0]];
    if (v === null) return;
    if (isNaN(v)){ errs.push(f[1] + " must be a number"); return; }
    if (v < 0){ errs.push(f[1] + " cannot be negative"); }
  });
  if (inputs.waste_kg !== null && inputs.waste_diverted_kg !== null &&
      inputs.waste_diverted_kg > inputs.waste_kg){
    errs.push("Diverted waste cannot exceed total waste");
  }
  if (inputs.household_size < 1 || inputs.household_size > 20){
    errs.push("Household size must be between 1 and 20");
  }
  var hasData = fields.some(function(f){ return inputs[f[0]] !== null; });
  if (!hasData && !errs.length){ errs.push("Enter at least one consumption value"); }
  return errs;
}

// ============================================================================
// CALCULATIONS
// ============================================================================
function calcEmissions(inputs){
  var by = {}, total = 0;
  if (inputs.electricity_kwh !== null && inputs.electricity_kwh >= 0){
    by.electricity = inputs.electricity_kwh * FACTORS.electricity.rate;
    total += by.electricity;
  }
  if (inputs.water_liters !== null && inputs.water_liters >= 0){
    by.water = inputs.water_liters * FACTORS.water.rate;
    total += by.water;
  }
  if (inputs.waste_kg !== null && inputs.waste_kg >= 0){
    var d = inputs.waste_diverted_kg || 0;
    var lf = Math.max(0, inputs.waste_kg - d);
    by.waste = lf * FACTORS.waste.rate;
    total += by.waste;
  }
  if (inputs.transport_km !== null && inputs.transport_km >= 0){
    by.transport = inputs.transport_km * FACTORS.transport.rate;
    total += by.transport;
  }
  return { total: total, by_source: by };
}

function calcScore(inputs){
  var parts = [], hs = inputs.household_size || 1;
  if (inputs.electricity_kwh !== null && inputs.electricity_kwh >= 0){
    var pp = inputs.electricity_kwh / hs;
    parts.push({ w: 0.35, v: clamp(100 - Math.max(0, pp - 150) * 0.15, 0, 100) });
  }
  if (inputs.water_liters !== null && inputs.water_liters >= 0){
    var pp2 = inputs.water_liters / hs;
    parts.push({ w: 0.30, v: clamp(100 - Math.max(0, pp2 - 3000) * 0.008, 0, 100) });
  }
  if (inputs.waste_kg !== null && inputs.waste_kg > 0){
    var dv = (inputs.waste_diverted_kg || 0) / inputs.waste_kg;
    parts.push({ w: 0.35, v: clamp(dv * 100, 0, 100) });
  }
  if (!parts.length) return { score: null, note: "Insufficient data for a score" };
  var tw = 0, acc = 0;
  parts.forEach(function(p){ tw += p.w; acc += p.w * p.v; });
  return {
    score: Math.round(acc / tw),
    coverage: tw,
    note: tw < 1 ? "Partial data — weights redistributed" : null
  };
}

function calculateEquivalents(totalKg){
  if (!isFinite(totalKg) || totalKg <= 0) return { trees: 0, km: 0, flights: 0, annualKg: 0 };
  var annual = totalKg * 12;
  return {
    annualKg: annual,
    trees: Math.round(annual / 21),       // 1 tree ≈ 21 kg CO2/year
    km: Math.round(totalKg / 0.192),       // equivalent km driven
    flights: Math.round(totalKg / 255)     // short-haul flight equivalent
  };
}

function generateRecommendations(inputs, scoreResult){
  var recs = [];
  var hs = inputs.household_size || 1;
  var epp = (inputs.electricity_kwh || 0) / hs;
  var wpp = (inputs.water_liters || 0) / hs;
  var waste = inputs.waste_kg || 0;
  var diverted = inputs.waste_diverted_kg || 0;
  var diversion = waste > 0 ? diverted / waste : null;

  if (epp > 200) recs.push({
    priority: "high", category: "energy",
    title: "Switch to LED lighting",
    desc: "LED bulbs use 75–80% less energy than incandescent and last up to 25× longer.",
    why: "Your electricity (~" + Math.round(epp) + " kWh/person/month) exceeds the 150 kWh benchmark.",
    difficulty: "Easy", cost: "Low", benefit: "5–15% reduction in lighting electricity"
  });
  if (epp > 300) recs.push({
    priority: "high", category: "energy",
    title: "Upgrade to efficient appliances",
    desc: "Choose A+++ rated refrigerators, washers, and AC units at next replacement.",
    why: "Very high per-person energy use often indicates old or inefficient large appliances.",
    difficulty: "Hard", cost: "High", benefit: "20–50% reduction in appliance energy"
  });
  if (wpp > 4000) recs.push({
    priority: "high", category: "water",
    title: "Inspect and repair leaks",
    desc: "A single dripping faucet can waste 20,000+ liters per year. Check toilets, taps, and outdoor lines.",
    why: "Your water use (~" + Math.round(wpp) + " L/person/month) exceeds the 3000 L benchmark.",
    difficulty: "Easy", cost: "Low", benefit: "5–20% reduction in water use"
  });
  if (diversion !== null && diversion < 0.30) recs.push({
    priority: "high", category: "waste",
    title: "Improve waste separation",
    desc: "Set up clearly labeled bins for paper, plastic, glass, and organics.",
    why: "Only ~" + Math.round(diversion * 100) + "% of your waste is diverted (target: 50%).",
    difficulty: "Easy", cost: "Low", benefit: "20–40 percentage point increase in diversion"
  });
  if (diversion !== null && diversion < 0.50) recs.push({
    priority: "medium", category: "waste",
    title: "Start home composting",
    desc: "Composting organics reduces methane from landfills — organics are 30–40% of household waste.",
    why: "Diversion below the 50% target; organics are the largest divertable fraction.",
    difficulty: "Medium", cost: "Low", benefit: "Diverts 30–40% of waste stream"
  });
  if ((inputs.transport_km || 0) > 500) recs.push({
    priority: "medium", category: "transport",
    title: "Combine trips and use transit",
    desc: "Carpooling, public transit, and trip chaining reduce fuel consumption significantly.",
    why: "Your transport (" + inputs.transport_km + " km/month) suggests reduction opportunity.",
    difficulty: "Medium", cost: "None", benefit: "10–30% reduction in transport emissions"
  });
  if (scoreResult.score !== null && scoreResult.score >= 70) recs.push({
    priority: "low", category: "positive",
    title: "Maintain your good habits",
    desc: "Your score is above average. Keep tracking to lock in gains.",
    why: "Score: " + scoreResult.score + "/100 — above sustainable threshold.",
    difficulty: "Easy", cost: "None", benefit: "Maintains current savings"
  });
  else recs.push({
    priority: "low", category: "habit",
    title: "Track consumption weekly",
    desc: "Regular tracking increases awareness and drives small continuous improvements.",
    why: "Behavioral research links awareness to 5–15% reductions over time.",
    difficulty: "Easy", cost: "None", benefit: "5–15% through awareness alone"
  });
  return recs;
}

// ============================================================================
// ACHIEVEMENTS
// ============================================================================
function checkAchievements(){
  var newOnes = [];
  function unlock(id, emoji, label){
    if (achievements.some(function(a){ return a.id === id; })) return;
    achievements.push({ id: id, emoji: emoji, label: label, at: new Date().toISOString() });
    newOnes.push(label);
  }
  if (state.inputs) unlock("first", "🌱", "First Assessment");
  if (state.inputs){
    var complete = ["electricity_kwh","water_liters","waste_kg","transport_km"]
      .every(function(k){ return state.inputs[k] !== null; });
    if (complete) unlock("complete", "📊", "Data Complete");
  }
  if (state.score && state.score.score !== null && state.score.score >= 70){
    unlock("warrior", "🏆", "Eco Warrior (70+)");
  }
  if (state.goals.length >= 3) unlock("planner", "🎯", "Goal Setter (3+)");
  if (state.goals.some(function(g){ return g.status === "completed"; })){
    unlock("committed", "✅", "Goal Completed");
  }
  if (state.history.length >= 3) unlock("tracker", "📈", "Progress Tracker (3+)");
  if (newOnes.length) toast("Achievement unlocked: " + newOnes.join(", "));
  save();
}

// ============================================================================
// MAIN ACTIONS
// ============================================================================
function calculate(){
  document.querySelectorAll(".form-field input").forEach(function(el){ el.classList.remove("invalid"); });
  var inputs = {
    electricity_kwh: readNum("inEnergy"),
    water_liters: readNum("inWater"),
    waste_kg: readNum("inWaste"),
    waste_diverted_kg: readNum("inDiverted"),
    transport_km: readNum("inTransport"),
    household_size: parseInt($("inHousehold").value, 10) || 1
  };
  var errs = validate(inputs);
  var el = $("errors");
  if (errs.length){
    el.innerHTML = errs.map(function(e){ return "• " + esc(e); }).join("<br>");
    el.style.display = "block";
    return;
  }
  el.style.display = "none";

  state.inputs = inputs;
  state.emissions = calcEmissions(inputs);
  state.score = calcScore(inputs);
  state.recommendations = generateRecommendations(inputs, state.score);
  state.isDemo = false;

  // History snapshot
  state.history.push({
    at: new Date().toISOString(),
    total: state.emissions.total,
    score: state.score.score
  });
  if (state.history.length > 20) state.history.shift();

  save();
  checkAchievements();
  renderResults();
  switchTab("results");
  toast("Assessment complete ✓");
}

function readNum(id){
  var el = $(id);
  if (!el || el.value === "") return null;
  var v = parseFloat(el.value);
  return isFinite(v) ? v : NaN;
}

function clearForm(){
  ["inEnergy","inWater","inWaste","inDiverted","inTransport"].forEach(function(id){
    $(id).value = "";
  });
  $("inHousehold").value = 1;
  $("errors").style.display = "none";
  document.querySelectorAll(".form-field input").forEach(function(el){ el.classList.remove("invalid"); });
}

function loadDemo(){
  $("inEnergy").value = 450;
  $("inWater").value = 12000;
  $("inWaste").value = 60;
  $("inDiverted").value = 15;
  $("inTransport").value = 800;
  $("inHousehold").value = 3;
  calculate();
  state.isDemo = true;
  save();
  renderResults();
  toast("Demo data loaded — illustrative, not real measurements");
}

function resetAll(){
  if (!confirm("Reset all data? This clears your assessment, goals, and history.")) return;
  state = { inputs: null, emissions: null, score: null, recommendations: [], goals: [], isDemo: false, history: [] };
  achievements = [];
  try {
    localStorage.removeItem(STORAGE_KEY);
    localStorage.removeItem(ACHIEVEMENTS_KEY);
  } catch(e){}
  clearForm();
  renderResults();
  renderGoals();
  toast("All data reset");
}

// ============================================================================
// RENDER: RESULTS
// ============================================================================
function renderResults(){
  var c = $("resultsContent");
  if (!state.inputs || !state.emissions){
    c.innerHTML = '<div class="empty">' +
      '<svg viewBox="0 0 24 24"><path d="M3 13h2v8H3v-8zm4 0h2v8H7v-8zm4-6h2v14h-2V7zm4 4h2v10h-2V11zm4-8h2v18h-2V3z"/></svg>' +
      '<p>No assessment yet.</p>' +
      '<button class="btn btn-primary" onclick="switchTab(\'assess\')">Start Assessment →</button>' +
      '</div>';
    return;
  }

  var inp = state.inputs, em = state.emissions, sc = state.score;
  var eq = calculateEquivalents(em.total);
  var html = "";

  if (state.isDemo){
    html += '<div class="alert alert-info"><svg viewBox="0 0 24 24"><path d="M11 7h2v2h-2V7zm0 4h2v6h-2v-6zm1-9C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/></svg><div><strong>Demo data.</strong> These are illustrative sample values — not real measurements.</div></div>';
  }

  // Score + achievements
  html += '<div class="grid grid-2" style="margin-bottom:16px">';
  html += '<div class="card" style="margin:0">';
  if (sc.score !== null){
    var color = sc.score >= 70 ? "good" : sc.score >= 40 ? "ok" : "poor";
    var label = sc.score >= 70 ? "Sustainable" : sc.score >= 40 ? "Improving" : "Needs work";
    html += '<div class="card-title">Sustainability Score</div>';
    html += '<div class="score-ring-wrap">';
    html += '<div class="score-ring">';
    html += '<svg viewBox="0 0 220 220">';
    html += '<defs><linearGradient id="ringGrad" x1="0%" y1="0%" x2="100%" y2="100%">';
    html += '<stop offset="0%" stop-color="#14b8a6"/>';
    html += '<stop offset="100%" stop-color="#f59e0b"/>';
    html += '</linearGradient></defs>';
    html += '<circle class="score-ring-bg" cx="110" cy="110" r="92"/>';
    var circ = 2 * Math.PI * 92;
    var dash = (sc.score / 100) * circ;
    html += '<circle class="score-ring-fg" cx="110" cy="110" r="92" stroke-dasharray="' + dash + ' ' + (circ - dash) + '"/>';
    html += '</svg>';
    html += '<div class="score-value">' + sc.score + '<small>/100</small></div>';
    html += '</div>';
    html += '<div class="score-badge ' + color + '">' + label + '</div>';
    if (sc.note) html += '<div class="score-note">' + esc(sc.note) + '</div>';
    html += '</div>';
  } else {
    html += '<div class="card-title">Sustainability Score</div>';
    html += '<div class="empty" style="padding:36px 12px">Not enough data to compute</div>';
  }
  html += '</div>';

  // Achievements card
  html += '<div class="card" style="margin:0">';
  html += '<div class="card-title">Achievements</div>';
  if (achievements.length){
    html += '<div class="achievements">';
    achievements.forEach(function(a){
      html += '<div class="achievement"><span class="em">' + a.emoji + '</span>' + esc(a.label) + '</div>';
    });
    html += '</div>';
  } else {
    html += '<p class="text-muted" style="font-size:.85rem">Complete assessments to unlock badges.</p>';
  }
  html += '</div></div>';

  // Metrics strip
  html += '<div class="grid grid-4" style="margin-bottom:16px">';
  html += metricCard("Electricity", fmt(inp.electricity_kwh), "kWh/month", "bolt");
  html += metricCard("Water", fmt(inp.water_liters), "L/month", "drop");
  html += metricCard("Waste", fmt(inp.waste_kg), "kg/month", "trash");
  html += metricCard("Emissions", fmt(em.total, 1), "kg CO₂e/month", "leaf");
  html += '</div>';

  // Impact equivalents
  html += '<div class="card">';
  html += '<div class="card-title">Your Annual Impact Equivalent</div>';
  html += '<div class="grid grid-3">';
  html += equivalent("🌳", fmtInt(eq.trees), "trees needed to absorb<br>your yearly CO₂e");
  html += equivalent("🚗", fmtInt(eq.km), "km driven by an average<br>gasoline car");
  html += equivalent("✈️", fmtInt(eq.flights), "short-haul flights<br>worth of CO₂e");
  html += '</div>';
  html += '<p class="text-muted" style="font-size:.75rem;margin-top:14px;text-align:center;font-style:italic">Approximate equivalences for context — not verified conversions.</p>';
  html += '</div>';

  // Emissions donut
  html += '<div class="card">';
  html += '<div class="card-title">Emissions Breakdown</div>';
  html += '<div class="donut-wrap">';
  html += renderDonut(em.by_source, em.total);
  html += '<div class="donut-legend">';
  var order = ["electricity", "water", "waste", "transport"];
  order.forEach(function(k){
    if (em.by_source[k] === undefined) return;
    var val = em.by_source[k];
    var pct = em.total > 0 ? (val / em.total * 100) : 0;
    html += '<div class="legend-item">';
    html += '<div class="legend-dot" style="background:' + FACTORS[k].color + '"></div>';
    html += '<div class="legend-label">' + FACTORS[k].label + '</div>';
    html += '<div class="legend-val">' + fmt(val, 1) + ' kg <span class="text-muted" style="font-weight:400">(' + fmt(pct, 0) + '%)</span></div>';
    html += '</div>';
  });
  html += '</div></div></div>';

  // What-if simulator
  html += '<div class="card">';
  html += '<div class="card-title">What-If Simulator</div>';
  html += '<p class="text-muted" style="font-size:.85rem;margin-bottom:16px">Drag sliders to see potential monthly savings.</p>';
  html += '<div class="sim-slider-row"><div class="sim-header"><label for="simEnergy">Reduce electricity by</label><span class="sim-value" id="simEnergyVal">0%</span></div><input type="range" id="simEnergy" min="0" max="50" value="0" step="5"></div>';
  html += '<div class="sim-slider-row"><div class="sim-header"><label for="simWater">Reduce water by</label><span class="sim-value" id="simWaterVal">0%</span></div><input type="range" id="simWater" min="0" max="50" value="0" step="5"></div>';
  html += '<div class="sim-slider-row"><div class="sim-header"><label for="simWaste">Increase waste diversion by</label><span class="sim-value" id="simWasteVal">0%</span></div><input type="range" id="simWaste" min="0" max="50" value="0" step="5"></div>';
  html += '<div class="sim-result">';
  html += '<div class="sim-result-item"><div class="v" id="simNewTotal">—</div><div class="l">New monthly total</div></div>';
  html += '<div class="sim-result-item"><div class="v" id="simSaved">—</div><div class="l">Monthly savings</div></div>';
  html += '</div>';
  html += '</div>';

  // Recommendations
  html += '<h2 style="font-size:1.2rem;font-weight:800;margin:24px 0 12px">Recommendations</h2>';
  state.recommendations.forEach(function(r){
    html += renderRecommendation(r);
  });

  c.innerHTML = html;

  // Wire sliders
  ["simEnergy","simWater","simWaste"].forEach(function(id){
    var el = $(id);
    if (!el) return;
    el.addEventListener("input", updateSimulator);
  });
  updateSimulator();
}

function metricCard(label, value, unit, icon){
  var icons = {
    bolt: '<path d="M7 2v11h3v9l7-12h-4l4-8z"/>',
    drop: '<path d="M12 2c-4 4-8 8-8 12a8 8 0 0016 0c0-4-4-8-8-12z"/>',
    trash: '<path d="M3 6h18v2H3V6zm2 4h14v12H5V10z"/>',
    leaf: '<path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75C7 8 17 8 17 8z"/>'
  };
  return '<div class="metric">' +
    '<div class="metric-icon"><svg viewBox="0 0 24 24">' + (icons[icon] || "") + '</svg></div>' +
    '<div class="metric-label">' + label + '</div>' +
    '<div class="metric-value">' + value + '</div>' +
    '<div class="metric-unit">' + unit + '</div>' +
    '</div>';
}

function equivalent(emoji, value, label){
  return '<div class="equivalent">' +
    '<div class="equivalent-icon">' + emoji + '</div>' +
    '<div class="equivalent-value">' + value + '</div>' +
    '<div class="equivalent-label">' + label + '</div>' +
    '</div>';
}

function renderDonut(bySource, total){
  if (total === 0) return '<div class="donut" style="display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:.8rem">No emissions</div>';
  var r = 70, cx = 90, cy = 90, circ = 2 * Math.PI * r;
  var svg = '<svg class="donut" viewBox="0 0 180 180">';
  var offset = 0;
  ["electricity", "water", "waste", "transport"].forEach(function(k){
    if (bySource[k] === undefined) return;
    var len = (bySource[k] / total) * circ;
    svg += '<circle cx="' + cx + '" cy="' + cy + '" r="' + r + '" fill="none" stroke="' + FACTORS[k].color + '" stroke-width="26" stroke-dasharray="' + len + ' ' + (circ - len) + '" stroke-dashoffset="' + (-offset) + '" transform="rotate(-90 ' + cx + ' ' + cy + ')"/>';
    offset += len;
  });
  svg += '</svg>';
  return svg;
}

function renderRecommendation(r){
  return '<div class="rec priority-' + r.priority + '">' +
    '<div class="rec-header">' +
    '<div class="rec-title">' + esc(r.title) + '</div>' +
    '<span class="rec-badge ' + r.priority + '">' + r.priority + '</span>' +
    '</div>' +
    '<div class="rec-desc">' + esc(r.desc) + '</div>' +
    '<div class="rec-why">Why: ' + esc(r.why) + '</div>' +
    '<div class="rec-meta">' +
    '<span><strong>Difficulty:</strong> ' + esc(r.difficulty) + '</span>' +
    '<span><strong>Cost:</strong> ' + esc(r.cost) + '</span>' +
    '<span><strong>Est. benefit:</strong> ' + esc(r.benefit) + '</span>' +
    '</div></div>';
}

function updateSimulator(){
  if (!state.inputs || !state.emissions) return;
  var inp = state.inputs;
  var ePct = parseInt($("simEnergy").value, 10) / 100;
  var wPct = parseInt($("simWater").value, 10) / 100;
  var dPct = parseInt($("simWaste").value, 10) / 100;

  $("simEnergyVal").textContent = Math.round(ePct * 100) + "%";
  $("simWaterVal").textContent = Math.round(wPct * 100) + "%";
  $("simWasteVal").textContent = Math.round(dPct * 100) + "%";

  var simInputs = {
    electricity_kwh: inp.electricity_kwh !== null ? inp.electricity_kwh * (1 - ePct) : null,
    water_liters: inp.water_liters !== null ? inp.water_liters * (1 - wPct) : null,
    waste_kg: inp.waste_kg,
    waste_diverted_kg: inp.waste_diverted_kg !== null
      ? Math.min(inp.waste_kg || 0, (inp.waste_diverted_kg || 0) * (1 + dPct) + (inp.waste_kg || 0) * dPct * 0.3)
      : null,
    transport_km: inp.transport_km,
    household_size: inp.household_size
  };
  var simEm = calcEmissions(simInputs);
  var saved = state.emissions.total - simEm.total;
  $("simNewTotal").textContent = fmt(simEm.total, 1) + " kg";
  $("simSaved").textContent = (saved >= 0 ? "−" : "+") + fmt(Math.abs(saved), 1) + " kg";
}

// ============================================================================
// RENDER: GOALS
// ============================================================================
function renderGoals(){
  var c = $("goalsList");
  if (!state.goals.length){
    c.innerHTML = '<div class="empty">' +
      '<svg viewBox="0 0 24 24"><path d="M12 2l2.4 7.4H22l-6 4.5 2.3 7.1-6.3-4.5-6.3 4.5 2.3-7.1-6-4.5h7.6z"/></svg>' +
      '<p>No goals yet. Create your first sustainability goal above.</p>' +
      '</div>';
    return;
  }
  var today = todayISO();
  var html = "";
  state.goals.forEach(function(g){
    var overdue = g.deadline && g.deadline < today && g.status !== "completed";
    var progress = g.progress || 0;
    html += '<div class="goal' + (overdue ? ' overdue' : '') + '">';
    html += '<div class="goal-header">';
    html += '<div class="goal-title">' + esc(g.title) + '</div>';
    html += '<div class="goal-actions">';
    html += '<button class="btn btn-secondary btn-sm" onclick="advanceGoal(\'' + g.id + '\')">' + (g.status === "completed" ? "↺ Reset" : "▶ Advance") + '</button>';
    html += '<button class="btn btn-danger btn-sm" onclick="deleteGoal(\'' + g.id + '\')">✕</button>';
    html += '</div></div>';
    html += '<div class="progress-track"><div class="progress-fill" style="width:' + progress + '%"></div></div>';
    html += '<div class="goal-meta"><span>' + progress + '% · ' + g.status + '</span><span>' + (g.deadline ? "📅 " + g.deadline + (overdue ? " (overdue)" : "") : "No deadline") + '</span></div>';
    html += '</div>';
  });
  c.innerHTML = html;
}

function addGoal(){
  var title = $("goalTitle").value.trim();
  if (!title){ toast("Goal title is required", "warn"); return; }
  if (title.length > 120){ toast("Title too long (max 120)", "warn"); return; }
  var goal = {
    id: "g_" + Date.now() + "_" + Math.floor(Math.random() * 10000),
    title: title,
    target: parseFloat($("goalTarget").value) || null,
    unit: $("goalUnit").value.trim() || "",
    deadline: $("goalDeadline").value || null,
    status: "pending",
    progress: 0,
    createdAt: new Date().toISOString()
  };
  state.goals.push(goal);
  save();
  $("goalTitle").value = "";
  $("goalTarget").value = "";
  renderGoals();
  checkAchievements();
  toast("Goal created ✓");
}

function advanceGoal(id){
  for (var i = 0; i < state.goals.length; i++){
    if (state.goals[i].id === id){
      var g = state.goals[i];
      if (g.status === "completed"){ g.progress = 0; g.status = "pending"; }
      else {
        g.progress = Math.min(100, (g.progress || 0) + 25);
        g.status = g.progress >= 100 ? "completed" : "in-progress";
      }
      save();
      renderGoals();
      checkAchievements();
      return;
    }
  }
}

function deleteGoal(id){
  if (!confirm("Delete this goal?")) return;
  state.goals = state.goals.filter(function(g){ return g.id !== id; });
  save();
  renderGoals();
  toast("Goal deleted");
}

// ============================================================================
// EXPORT
// ============================================================================
function exportCSV(){
  if (!state.inputs){ toast("Run an assessment first", "warn"); return; }
  var inp = state.inputs, em = state.emissions, sc = state.score;
  var rows = [
    ["EcoGenesis AI — Assessment Export"],
    ["Generated", new Date().toISOString()],
    ["Data source", state.isDemo ? "SAMPLE DEMO" : "User-provided"],
    [],
    ["Input", "Value", "Unit"],
    ["Electricity", inp.electricity_kwh ?? "", "kWh/month"],
    ["Water", inp.water_liters ?? "", "L/month"],
    ["Waste", inp.waste_kg ?? "", "kg/month"],
    ["Diverted waste", inp.waste_diverted_kg ?? "", "kg/month"],
    ["Transport", inp.transport_km ?? "", "km/month"],
    ["Household size", inp.household_size || 1, "people"],
    [],
    ["Emission source", "kg CO2e/month"]
  ];
  Object.keys(em.by_source).forEach(function(k){
    rows.push([k, em.by_source[k].toFixed(3)]);
  });
  rows.push(["TOTAL", em.total.toFixed(3)]);
  rows.push([]);
  rows.push(["Sustainability score", sc && sc.score !== null ? sc.score + "/100" : "N/A"]);
  rows.push([]);
  rows.push(["NOTE", "Emission factors are DEMO VALUES — not verified measurements"]);
  var csv = rows.map(function(r){
    return r.map(function(cell){
      var s = String(cell === null || cell === undefined ? "" : cell);
      return '"' + s.replace(/"/g, '""') + '"';
    }).join(",");
  }).join("\n");
  downloadFile(csv, "ecogenesis-" + todayISO() + ".csv", "text/csv");
  toast("CSV exported ✓");
}

function exportJSON(){
  if (!state.inputs){ toast("Run an assessment first", "warn"); return; }
  var payload = {
    app: "EcoGenesis AI",
    version: "2.0",
    exported_at: new Date().toISOString(),
    data_source: state.isDemo ? "sample_demo" : "user",
    inputs: state.inputs,
    emissions: state.emissions,
    score: state.score,
    goals: state.goals,
    achievements: achievements,
    history: state.history,
    disclaimer: "Emission factors are DEMO VALUES. Not verified measurements."
  };
  downloadFile(JSON.stringify(payload, null, 2), "ecogenesis-" + todayISO() + ".json", "application/json");
  toast("JSON exported ✓");
}

function downloadFile(content, filename, mime){
  var safe = filename.replace(/[^a-z0-9_.\-]/gi, "_");
  var blob = new Blob([content], { type: mime + ";charset=utf-8" });
  var url = URL.createObjectURL(blob);
  var a = document.createElement("a");
  a.href = url;
  a.download = safe;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  setTimeout(function(){ URL.revokeObjectURL(url); }, 100);
}

// ============================================================================
// SHARE
// ============================================================================
function shareResult(){
  if (!state.score || state.score.score === null){
    toast("Complete an assessment first", "warn");
    return;
  }
  var text = "🌱 EcoGenesis AI\n\n" +
    "My sustainability score: " + state.score.score + "/100\n" +
    "My monthly emissions: " + fmt(state.emissions.total, 1) + " kg CO2e\n\n" +
    "Try it: open index.html in any browser — private, offline, no accounts.";
  if (navigator.clipboard && navigator.clipboard.writeText){
    navigator.clipboard.writeText(text).then(function(){
      toast("Copied to clipboard ✓");
    }).catch(function(){
      fallbackCopy(text);
    });
  } else {
    fallbackCopy(text);
  }
}
function fallbackCopy(text){
  var ta = document.createElement("textarea");
  ta.value = text;
  ta.style.position = "fixed";
  ta.style.opacity = "0";
  document.body.appendChild(ta);
  ta.select();
  try { document.execCommand("copy"); toast("Copied ✓"); }
  catch(e){ toast("Copy failed — long-press to select", "warn"); }
  document.body.removeChild(ta);
}

// ============================================================================
// DARK MODE
// ============================================================================
function toggleDark(){
  var cur = document.documentElement.getAttribute("data-theme");
  var next = cur === "dark" ? "light" : "dark";
  document.documentElement.setAttribute("data-theme", next);
  try { localStorage.setItem("ecogenesis_theme", next); } catch(e){}
}
function loadTheme(){
  try {
    var t = localStorage.getItem("ecogenesis_theme");
    if (t === "dark") document.documentElement.setAttribute("data-theme", "dark");
  } catch(e){}
}

// ============================================================================
// WIRE UP
// ============================================================================
$("btnDark").addEventListener("click", toggleDark);
$("btnShare").addEventListener("click", shareResult);
$("btnReset").addEventListener("click", resetAll);

// ============================================================================
// INIT
// ============================================================================
loadTheme();
load();
if (state.inputs){
  var s = state.inputs;
  if (s.electricity_kwh != null) $("inEnergy").value = s.electricity_kwh;
  if (s.water_liters != null) $("inWater").value = s.water_liters;
  if (s.waste_kg != null) $("inWaste").value = s.waste_kg;
  if (s.waste_diverted_kg != null) $("inDiverted").value = s.waste_diverted_kg;
  if (s.transport_km != null) $("inTransport").value = s.transport_km;
  if (s.household_size) $("inHousehold").value = s.household_size;
}
renderResults();
renderGoals();

// Expose for console
window.EcoGenesis = {
  state: state,
  calculate: calculate,
  calcEmissions: calcEmissions,
  calcScore: calcScore,
  reset: resetAll
};

})();
</script>
</body>
</html>
